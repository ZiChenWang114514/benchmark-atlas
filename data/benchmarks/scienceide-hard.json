  "design_goals": {
    "capabilities": {
      "value": "在真实科学软件中修复和实现算法，并满足领域数值与物理契约；多文件修改及约定忠实重建。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.19134",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "代码单元测试和通用程序修复不能充分测科学数值等价、守恒不变量与复杂领域约定。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.19134",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "从科学代码库及官方测试构建执行环境，以可运行科学检查合成修复/实现任务；Hard子集来自五个仓库家族。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.19134",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "科学计算与模型训练团队；环境来源覆盖流体、等离子体、海洋大气等领域。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.19134",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "先提出候选，再通过执行建立有效性；每个准入任务有known-valid witness、空交付基线和有缺陷起点。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.19134",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "每个公开任务均经执行验证：官方修复在评分容器得到 1.0，未修复构建留有奖励空间，agent 镜像不含答案材料。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/aitofound/ScienceIDE/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "固定85个相同任务标识供全体模型；训练/验证任务标识不交叉；源代码公开不等于无训练暴露。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.19134",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "Hard85来自18个环境、5个仓库家族：52个repair、33个implementation任务。当前预览公开30项、保留55项。基础设施64环境、27代码库、2812训练任务是不同统计总体。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2609.19134",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://github.com/aitofound/ScienceIDE",
          "accessed": "2026-11-08"
        }
      ]
    },
    "question_types": {
      "value": "多步工具调用、科学代码修复与实现，交付可运行修改。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.19134",
          "accessed": "2026-11-08"
        }
      ]
    },
    "modalities": {
      "value": "科学源代码、命令行、数值输出与文本说明。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.19134",
          "accessed": "2026-11-08"
        }
      ]
    },
    "languages": {
      "value": "多科学代码库语言与英语交互；逐环境语言见来源附录。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.19134",
          "accessed": "2026-11-08"
        }
      ]
    },
    "difficulty": {
      "value": "以未修复得分、编辑位置数量、验证开销和实测通过率描述难度，而不是手工赋予单一难度标签。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/aitofound/ScienceIDE/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "Hard85：30 项公开、55 项保留；环境集：15 个公开、49 个保留。两种统计单位不可混淆。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/aitofound/ScienceIDE/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "严格科学任务成功率；运行时间、输出token及历史估算成本辅助分析。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.19134",
          "accessed": "2026-11-08"
        }
      ]
    },
    "scoring": {
      "value": "reward 为物理案例评分均值；reward_repair=max(0,(reward−floor)/(1−floor))，其中 floor 为未修复构建的得分。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/aitofound/ScienceIDE/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "15个模型—harness组合，固定85题，单任务1小时预算；多次重复及within-task bootstrap，Fable仅单次。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.19134",
          "accessed": "2026-11-08"
        }
      ]
    },
    "official_scripts": {
      "value": "https://github.com/aitofound/ScienceIDE/tree/main/hard85",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/aitofound/ScienceIDE/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "模型与harness/工具预算耦合；Fable单测，Opus与Astra置信区间重叠。时间截断曲线为事后完成分布，不是新预算重跑。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.19134",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
