  "design_goals": {
    "capabilities": {
      "value": "测量模型在段落证据上做加减、计数、比较、排序及抽取答案的能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1903.00161",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "仅靠定位答案跨度的阅读理解不足以检验离散运算与多事实整合。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1903.00161",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "2018年10月Wikipedia dump及在线Wikipedia；优先NFL比赛总结、历史及含至少20个数字的段落，抽取约7000段；MTurk人工提问，在线BiDAF答不出才可提交。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1903.00161",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "MTurk众包写题；作者团队设计对抗式收集和验证流程。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1903.00161",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "开发/测试每题至少追加两份人工答案，标记并过滤0.7%无效问题；总体Cohen κ=0.74（数字0.81、跨度0.62、日期0.65）。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1903.00161",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "按段落切分训练/开发/测试，避免同一段落跨集；论文称验证剔除约0.7%无效题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1903.00161",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "段落级隔离减少数据集内部泄漏，不是针对现代大模型预训练语料的无污染认证。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1903.00161",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "论文原版96567题：train 77409、dev 9536、hidden test 9622。HF元数据则为77400/9535，卡片正文仍列77409/9536；必须注明具体打包版本。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1903.00161",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://huggingface.co/datasets/ucinlp/drop/blob/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "段落阅读短答案；答案可为数字、日期、单跨度或多跨度文本。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1903.00161",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "文本（数学符号按文本表达）；并非原始图像视频识别任务",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1903.00161",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语题面；形式化/数学符号另见模态与仓库格式",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1903.00161",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "难点是证据选择与离散运算耦合；不是依学科年级分级。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1903.00161",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "按段落随机80/10/10划分，避免同一段落跨split；原隐藏测试9622题，HF镜像仅train与validation。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1903.00161",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://huggingface.co/datasets/ucinlp/drop/blob/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "Exact Match（EM）与面向数字/多跨度的F1。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1903.00161",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "归一化EM和数值敏感macro F1；数字不匹配时相关配对不给F1，多跨度对齐后平均，多份gold取最高值。论文称greedy对齐，但当前官方drop_eval.py使用linear_sum_assignment最优匹配，应锁定脚本版本。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1903.00161",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://allennlp.org/drop",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "原论文为监督阅读理解系统；现代LLM few-shot/CoT、答案抽取和上下文截断需单列。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1903.00161",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "https://github.com/allenai/allennlp-reading-comprehension/blob/master/allennlp_rc/eval/drop_eval.py",
      "sources": [
        {
          "url": "https://allennlp.org/drop",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "F1不是EM；公开开发集与隐藏测试集、不同数值归一化实现不能直接比较。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1903.00161",
          "accessed": "2026-11-07"
        },
