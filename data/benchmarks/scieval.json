  "evaluation": {
    "metrics": {
      "value": "静态题及动态物理题用准确率；动态化学分别用精确匹配、数值 MSE 与字符串 BLEU；实验数据人工评分。",
      "sources": [
        {
          "url": "https://arxiv.org/html/2308.13149",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "静态题按标准答案判定；动态化学数值题用 MSE，无数值预测按论文设为 1×10^10；实验开放题由人工评估。不同指标不合成单一总分。",
      "sources": [
        {
          "url": "https://arxiv.org/html/2308.13149",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "dev 集专供 few-shot；make_few_shot.py 用于生成示例。动态题需单独使用 eval_dynamic.py。",
      "sources": [
        {
          "url": "https://github.com/OpenDFM/SciEval",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "静态题 eval.py；动态题 eval_dynamic.py；提交静态预测格式包含 id 与 pred。",
      "sources": [
        {
          "url": "https://github.com/OpenDFM/SciEval",
          "accessed": "2026-11-07"
        }
      ]
    },
