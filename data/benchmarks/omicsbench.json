  "design_goals": {
    "capabilities": {
      "value": "研究规模、长时多轮组学工作流，跨依赖子任务产出可自动检查的生物学分析。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.21074",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "一次请求或局部代码片段不能充分测试长工作流、依赖管理及反馈利用。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.21074",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "已发表生物研究与对应公开数据集，按研究工作流拆成任务DAG。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.21074",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "计算生物学研究生专家策划；writer/reviewer代理辅助后由人工编辑。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.21074",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "受过研究生层次计算生物学训练的人类专家选论文及数据；writer agent起草，reviewer agent审核支持性及泄漏，最多三轮修订；自动格式检查后人类复核编辑或拒绝。",
      "sources": [
        {
          "url": "https://arxiv.org/html/2610.21074v1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "58类确定性生物grader与实体同义词参考库；分步依赖DAG检查。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.21074",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "94私有任务控制答案访问，3公开任务作示例；源论文公开及grader反馈可能使记忆/奖励投机仍存在。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.21074",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
