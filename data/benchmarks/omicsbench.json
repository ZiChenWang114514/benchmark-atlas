        {
          "url": "https://arxiv.org/abs/2610.21074",
          "accessed": "2026-11-08"
        }
      ]
    },
    "modalities": {
      "value": "组学矩阵、表格、代码、分析产物与文字结果。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.21074",
          "accessed": "2026-11-08"
        }
      ]
    },
    "languages": {
      "value": "任务示例和runner文档为英语，分析工具含Python/R与生物实体标识符；不推断多语覆盖率。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2610.21074",
          "accessed": "2026-11-08"
        },
