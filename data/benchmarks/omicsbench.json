  "design_goals": {
    "capabilities": {
      "value": "研究规模、长时多轮组学工作流，跨依赖子任务产出可自动检查的生物学分析。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.21074",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "单次提示难以反映真实组学研究中逐轮委托、前序结果依赖和收到反馈后的恢复能力；本基准把研究工作流拆成DAG依赖的多轮子任务。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2610.21074",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "已发表生物研究与对应公开数据集，按研究工作流拆成任务DAG。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.21074",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "计算生物学研究生专家策划；writer/reviewer代理辅助后由人工编辑。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.21074",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "受过研究生层次计算生物学训练的人类专家选论文及数据；writer agent起草，reviewer agent审核支持性及泄漏，最多三轮修订；自动格式检查后人类复核编辑或拒绝。",
      "sources": [
        {
          "url": "https://arxiv.org/html/2610.21074v1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "58类确定性生物grader与实体同义词参考库；分步依赖DAG检查。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.21074",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "94私有任务控制答案访问，3公开任务作示例；源论文公开及grader反馈可能使记忆/奖励投机仍存在。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.21074",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "97任务、662子任务、58确定性生物评分器；3公开、94私有。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.21074",
          "accessed": "2026-11-08"
        }
      ]
    },
    "question_types": {
      "value": "长时多轮组学数据分析；有向无环依赖子任务。",
