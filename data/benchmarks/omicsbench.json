  "evaluation": {
    "metrics": {
      "value": "任务/子任务生物grader得分；single-pass与gated两协议分开。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.21074",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "58类确定性grader先给答案字段0—1分；子任务取字段均值，任务取子任务均值。single-pass无反馈；gated阈值0.7、最多3次，每轮1800秒；两种模式均记录最佳尝试。",
      "sources": [
        {
          "url": "https://arxiv.org/html/2610.21074v1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "每轮1800秒；Docker无网络、4核、12GB内存、20GB盘；支持时reasoning high。12模型、3harness、14组合。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.21074",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "官方HF仓库omicsbench_runner/包含runner与全部grader；安装与运行说明见omicsbench_runner/README.md。",
