  "design_goals": {
    "capabilities": {
      "value": "在长程开放网页搜索中组织视觉信息，并把图像、物体和后续搜索连接起来。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.04894",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文认为，有些搜索任务只用图像识别初始实体，之后主要靠文本检索，因而看不出智能体如何跨图像连接证据。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.04894",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
