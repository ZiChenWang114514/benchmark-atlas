          "accessed": "2026-11-08"
        }
      ]
    },
    "languages": {
      "value": "完整集支持Python、C、Rust、Go、OCaml、Ada；当前榜2L映射以Go/Ada为主。",
      "sources": [
        {
          "url": "https://epoch.ai/benchmarks/mirrorcode",
          "accessed": "2026-11-08"
        }
      ]
    },
    "difficulty": {
      "value": "Small、Medium、Large分桶；当前榜不含Small。",
      "sources": [
        {
          "url": "https://epoch.ai/benchmarks/mirrorcode",
          "accessed": "2026-11-08"
        }
      ]
    },
    "public_hidden_split": {
      "value": "发布22/25目标程序，共132个语言任务实例；3个目标私有。每程序另含隐藏测试，平均34%。",
      "sources": [
        {
          "url": "https://epoch.ai/benchmarks/mirrorcode",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "100%-solve rate：每次尝试须通过全部端到端测试；跨目标与运行取平均。",
      "sources": [
        {
          "url": "https://epoch.ai/benchmarks/mirrorcode",
          "accessed": "2026-11-08"
        }
      ]
    },
    "scoring": {
      "value": "评分harness在独立容器外比较stdout、stderr及exit status；必须全部端到端用例通过才算100%-solve，99%-solve只是论文另报的部分实现指标。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2606.30182",
          "accessed": "2026-11-08"
        }
      ]
    },
    "prompt_settings": {
      "value": "当前榜ML,+Private,2L：每题3次，每次100亿token及7天；Inspect ReAct scaffold，离线Docker，支持shell/text_editor/evaluate_testcases/submit。",
      "sources": [
        {
          "url": "https://epoch.ai/benchmarks/mirrorcode",
          "accessed": "2026-11-08"
        }
      ]
    },
    "official_scripts": {
