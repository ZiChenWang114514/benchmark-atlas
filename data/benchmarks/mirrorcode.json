  "design_goals": {
    "capabilities": {
      "value": "从程序行为和文档端到端重建完整CLI程序，衡量长时程自主编程。",
      "sources": [
        {
          "url": "https://epoch.ai/benchmarks/mirrorcode",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "短补丁题和有人类引导的一次性演示难以系统比较整程序自主实现。",
      "sources": [
        {
          "url": "https://epoch.ai/benchmarks/mirrorcode",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "25个目标程序：Unix工具、序列化、查询、生物信息、解释器、静态分析、密码学与压缩。",
      "sources": [
        {
          "url": "https://epoch.ai/benchmarks/mirrorcode",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "程序任务贡献者与Epoch AI/METR评测研究团队。",
      "sources": [
        {
          "url": "https://epoch.ai/benchmarks/mirrorcode",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "任务贡献者审核测试；检查全部模型未解测试是否合理可解。",
      "sources": [
        {
          "url": "https://epoch.ai/benchmarks/mirrorcode",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "评分在独立sandbox，无参考二进制；字节级输出比较，并进行显式作弊红队。",
      "sources": [
        {
          "url": "https://epoch.ai/benchmarks/mirrorcode",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "开发时无源代码、无网络；隐藏测试防查表。仍可能预训练见过开源代码，不能排除记忆贡献。",
      "sources": [
        {
          "url": "https://epoch.ai/benchmarks/mirrorcode",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "完整25程序；当前榜取Medium+Large的15程序，每个两种语言，共30任务，每任务3次。",
      "sources": [
        {
          "url": "https://epoch.ai/benchmarks/mirrorcode",
          "accessed": "2026-11-08"
        }
      ]
    },
    "question_types": {
      "value": "CLI黑箱oracle、文档、可见输入输出示例；提交目标语言代码。",
      "sources": [
        {
          "url": "https://epoch.ai/benchmarks/mirrorcode",
          "accessed": "2026-11-08"
        }
      ]
    },
    "modalities": {
