  "design_goals": {
    "capabilities": {
      "value": "印度医学入学/研究生考试多学科知识与推理，附解释便于医学QA训练与诊断。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "既有医疗选择题规模较小且主题有限；需要更大、多学科、带解答的基准。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "AIIMS与NEET PG真实考试风格题库。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "论文作者均署名Saama AI Research；材料来自官方AIIMS/NEET PG历史考试和医疗专业人员编写的模拟考试/在线题库。原始命题人的逐题身份不在本条推断。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2203.14371",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "论文§2.3过滤非四选项、缺答案或候选为空、依赖图像/表格及特定外部信息的题；人工监督Grammarly修正语法拼写，再去重。另随机抽取25%问题做题型/推理类型分析；该分析不是宣称全部题逐题医学双盲复审。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2203.14371",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "论文§2.4用Levenshtein距离检查题目相似度，相似度>0.9的题从dev/test中剔除；按考试来源而非随机逐题划分，旨在减少重复题泄漏。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2203.14371",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "公开题库与公开训练资料容易暴露；去重不等于排除LLM预训练污染。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "清洗后精确总数193,155题（182,822+6,150+4,183），论文§2.3及表1/2一致；摘要/官网宣传仍写more than194k，不能把宣传近似数当精确规模。21医学学科、2.4k topics为官方概述口径。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2203.14371",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://raw.githubusercontent.com/medmcqa/medmcqa/main/README.md",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://huggingface.co/datasets/openlifescienceai/medmcqa/raw/main/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "question_types": {
      "value": "四选项医学选择题，cop给正确选项；choice_type可标single/multi，HF卡说明multi可指选项内含组合子项，并非可随意返回多个字母。原GitHub提交答案索引1–4，HF features class_label为0–3，须转换索引。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/medmcqa/medmcqa/main/README.md",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://huggingface.co/datasets/openlifescienceai/medmcqa/raw/main/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "modalities": {
      "value": "文本题干、四候选项、答案、解释及主题学科信息。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-08"
        }
      ]
    },
    "languages": {
      "value": "英语。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-08"
        }
      ]
    },
    "difficulty": {
      "value": "医学毕业生考试级别，知识与推理混合；无通用难度分档。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-08"
        }
      ]
    },
    "public_hidden_split": {
      "value": "来源存在反向标注：GitHub README表头Train/Valid/Test为182,822/6,150/4,183；论文表2与§3及HF实际features则为Train/Test/Dev=182,822/6,150/4,183。论文§2.4末尾又写约6k dev/4k test，与其表2冲突。实际使用以下载文件split名和行数记录，不静默互换。原GitHub官方测试答案不公开；HF卡的test6150与validation4183必须单列。",
      "sources": [
