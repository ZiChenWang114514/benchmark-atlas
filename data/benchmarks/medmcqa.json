  "design_goals": {
    "capabilities": {
      "value": "印度医学入学/研究生考试多学科知识与推理，附解释便于医学QA训练与诊断。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "既有医疗选择题规模较小且主题有限；需要更大、多学科、带解答的基准。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "AIIMS与NEET PG真实考试风格题库。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "Saama AI Research团队；原考试医学命题人员逐题资质待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-07"
        }
      ],
      "status": "待核实"
    },
    "review_process": {
      "value": "原论文描述题库收集/清洗、解答解释与主题归类；独立逐题人工复审规模待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-07"
        }
      ],
      "status": "待核实"
    },
    "quality_control": {
      "value": "规范题干、四选项、正确答案与解释/学科元数据，覆盖21医学学科。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "公开题库与公开训练资料容易暴露；去重不等于排除LLM预训练污染。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "超过194k题、2.4k主题、21医学学科（官方论文口径）。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "医学单选及题库中的多答案描述；实际评分应遵从所用版本cop/choice_type，不能一概假定多选。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "文本题干、四候选项、答案、解释及主题学科信息。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "医学毕业生考试级别，知识与推理混合；无通用难度分档。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "README按考试来源划分：train 182,822；valid 6,150；test 4,183。train为模拟/在线题，test为AIIMS PG，dev为NEET PG；官方声明测试答案不公开。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/medmcqa/medmcqa/main/README.md",
          "accessed": "2026-11-07"
        }
      ],
      "note": "保留README划分口径，不把valid当作test；需与实际下载版本逐文件核对。"
    }
  },
  "evaluation": {
    "metrics": {
      "value": "Accuracy；注明带context与不带context、dev与test。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "答案选项匹配；解释可供训练/检索，但不能在测试时泄漏参考答案。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "官网分with/without context；2022 Codex5-shot CoT等历史设置，与现代RAG代理不直接混排。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.14371",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "官方train.py用于复现实验；隐藏测试需按README提交CSV，列为id与Prediction (correct option)，答案索引1—4。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/medmcqa/medmcqa/main/README.md",
          "accessed": "2026-11-07"
        }
