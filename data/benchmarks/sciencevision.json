  "data_format": {
    "size": {
      "value": "250道专家级题目，生物学、化学、医学影像、机械CAD与建筑五个领域各50道，共22个子领域；参考答案中143题为单条目、107题为多条目。全部250题均有专家检视记录，合计2,156次查看器操作（不含初始状态）。代码仓库还称2,406个已记录专家步骤中有2,405个带有截图。资源文件共计325个",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.04087",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://www.unipat.ai/blog/ScienceVision",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://github.com/UniPat-AI/ScienceVision",
          "accessed": "2026-11-11"
        }
      ]
    },
    "question_types": {
      "value": "科学三维视觉问答，答案可为类别、计数、坐标、测量、原子标识或有序列表等，并按任务指定单位与坐标系",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.04087",
          "accessed": "2026-11-11"
        },
