  "design_goals": {
    "capabilities": {
      "value": "考查模型能否从原生三维科学对象中获取证据，并运用领域知识完成专家级视觉问答，覆盖结构判读、几何与拓扑关系、遮挡目标识别与测量等",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.04087",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://www.unipat.ai/blog/ScienceVision",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://github.com/UniPat-AI/ScienceVision",
          "accessed": "2026-11-11"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出已有多模态基准多评测文本与二维图像，科学三维评测又因表示与协议不同而难以跨学科比较；缺少在统一、可确定性核对答案的设定下比较不同证据获取方式的跨领域科学三维问答基准",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.04087",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://www.unipat.ai/blog/ScienceVision",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://github.com/UniPat-AI/ScienceVision",
          "accessed": "2026-11-11"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "先检查三维对象是否支持预定问题并可在查看器中检视，再由模板或经整理的草稿生成候选题目（有时借助智能体），随后交由领域专家审阅、修改、检视对象并给出参考答案",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.04087",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://www.unipat.ai/blog/ScienceVision",
