        },
        {
          "url": "https://github.com/UniPat-AI/ScienceVision",
          "accessed": "2026-11-11"
        }
      ]
    },
    "author_background": {
      "value": "由 UniPat AI 与 Elorian AI 的研究者发起；官方博客称五个学科共66名专家参与题目撰写、修改、参考答案标注与审校，记录工作时间为482.98小时",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.04087",
          "accessed": "2026-11-11"
        },
