  "design_goals": {
    "capabilities": {
      "value": "考查需要多步推理与结构化化学理解的化学任务，覆盖反应类型识别、语境中的结构生成、计算与计数、构效关系推理、选择性预测、空间想象与三维思维六类能力",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.11794",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://arxiv.org/pdf/2611.11794",
          "accessed": "2026-11-12"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文认为现有化学基准通常只给出单一分数，掩盖了限制模型化学能力的具体瓶颈，难以指导有针对性的改进",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.11794",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://arxiv.org/pdf/2611.11794",
          "accessed": "2026-11-12"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "基准集为原创、难以通过搜索引擎获得答案的题目，以有机化学为主；设计标准要求题目对化学专业学生也具挑战性，且答案无法直接从 SciFinder、Reaxys 等化学数据库或搜索引擎检索到",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.11794",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://arxiv.org/pdf/2611.11794",
          "accessed": "2026-11-12"
        }
      ]
    },
    "author_background": {
      "value": "论文所称领域专家指顶尖高校的化学专业学生；三位同等贡献作者的工作在蚂蚁集团实习期间完成",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.11794",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://arxiv.org/pdf/2611.11794",
          "accessed": "2026-11-12"
        }
      ]
    },
    "review_process": {
      "value": "基准集与诊断集均由领域专家独立编写并交叉验证，以确保正确性、表述清晰和难度适当",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.11794",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://arxiv.org/pdf/2611.11794",
          "accessed": "2026-11-12"
        }
      ]
    },
    "quality_control": {
      "value": "SMILES 答案经 RDKit 规范化后做精确匹配；简答题由大模型裁判按结构化提示分层评分，先执行特殊规则与关键词匹配，再按满分、部分分、零分三级评分，并设反幻觉约束",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.11794",
          "accessed": "2026-11-12"
        },
