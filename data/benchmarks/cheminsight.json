  "data_format": {
    "size": {
      "value": "基准集203题，分为50个题组，总计262分；其中23个为“精华题组”，题目相互关联且难度递增。诊断集50道单步题，其中30题考查结构识别、20题考查构效关系推理",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.11794",
