  "design_goals": {
    "capabilities": {
      "value": "心理危机支持中的识别、恰当共情、降级干预和人类援助转介，而非只测拒答。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.12758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "不输出有害内容不等于给予有效支持；单轮二元拒答指标漏测隐性危机与识别后不行动。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.12758",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "持证临床人员与危机咨询师编写的模拟对话，不是患者聊天或临床记录。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.12758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "持证临床人员和危机咨询师；无真实患者信息。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.12758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "临床写用户提示及笔记，模型起草rubric/参考回答，经临床人员重写；自动检查与多层人工审核。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.12758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "75任务、2908临床共识判断校准三裁判面板；多轮连贯性门控。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.12758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "50/50分层公开/私有划分，私有半集用于污染检查。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.12758",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "718对话、23子类、6901加权原子标准；299单轮，419多轮（3–5用户轮）。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.12758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "危机对话回复，按任务专有rubric评价最终assistant轮。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.12758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": [
        "文本对话"
      ],
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.12758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "仅英语；援助资源标准以美国为中心。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.12758",
          "accessed": "2026-11-07"
        }
      ]
