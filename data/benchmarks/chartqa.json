  "design_goals": {
    "capabilities": {
      "value": "需要视觉引用、逻辑及算术组合运算的真实图表问答。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.10244",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://github.com/vis-nlp/ChartQA",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "既有图表QA多使用模板问题及固定答案词表，难覆盖自然复杂问题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.10244",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://github.com/vis-nlp/ChartQA",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "从Statista、Pew、Our World in Data、OECD采集真实图表；人工问答ChartQA-H与从人工图表摘要自动生成的ChartQA-M并存。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2203.10244",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://github.com/vis-nlp/ChartQA",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "人工标注者提出自然问题；自动部分由摘要驱动生成，不把全部称为专家原创。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2203.10244",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "人工问答由另一标注员复核；不一致答案再人工裁定。论文报告原始exact-match一致率61.04%，另抽500例考虑拼写/词形变化后一致率78.55%。机器生成test剔除无效问题。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2203.10244",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "官方从SVG自动产生框标注；损坏、缺失或带噪的SVG会引入噪声。Pew图表没有SVG，需人工标注并用启发式加速；机器生成测试问答另经手工清理。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/vis-nlp/ChartQA/main/README.md",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://aclanthology.org/2022.findings-acl.177.pdf",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "待核实",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2203.10244",
          "accessed": "2026-11-07"
        },
