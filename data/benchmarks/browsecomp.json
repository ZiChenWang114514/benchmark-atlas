  "design_goals": {
    "capabilities": {
      "value": "持续、富有创造性地在互联网上检索难找、相互纠缠的信息。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2504.12516",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "以短且易验证的答案测浏览 agent 的核心坚持与检索能力；论文自述回避了真实用户分布、长答案与歧义消解等问题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2504.12516",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "人类训练员从可查证的事实反向构造带多重约束的问题，答案须简短、明确、稳定并有证据；不是模型合成题或真实用户查询的随机样本。",
      "sources": [
        {
          "url": "https://cdn.openai.com/pdf/5e10f4ab-d6f7-442e-9508-59515c65e35d/browsecomp.pdf",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "负责创建高质量评测数据的人类训练员；解题基线来自同一训练员群体但不得作答自己出的题。论文不把他们称为竞赛级搜索专家。",
      "sources": [
        {
          "url": "https://cdn.openai.com/pdf/5e10f4ab-d6f7-442e-9508-59515c65e35d/browsecomp.pdf",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "核验GPT-4o（带/不带浏览）、o1和早期Deep Research不能解题；进行5次简单Google搜索检查答案不在首屏；部分题由另一训练员限10分钟尝试，若该作者题目被解比例超过40%则要求修订。",
      "sources": [
        {
          "url": "https://cdn.openai.com/pdf/5e10f4ab-d6f7-442e-9508-59515c65e35d/browsecomp.pdf",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "要求短且可验证的稳定参考答案、作者熟悉题域并补约束；另一训练员若发现不同但有效答案会反馈修订。论文明确承认无法穷尽验证所有可能答案，不能称绝对唯一答案集。",
      "sources": [
        {
          "url": "https://cdn.openai.com/pdf/5e10f4ab-d6f7-442e-9508-59515c65e35d/browsecomp.pdf",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "原论文Table 1说明加入canary以便训练语料过滤，并请求不在网上明文或图片再发布题目；官方公开CSV对题干和答案采用canary派生的可逆编码，不是保密或访问控制保证。",
      "sources": [
        {
          "url": "https://cdn.openai.com/pdf/5e10f4ab-d6f7-442e-9508-59515c65e35d/browsecomp.pdf",
          "accessed": "2026-11-08"
