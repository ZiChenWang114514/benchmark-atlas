  "design_goals": {
    "capabilities": {
      "value": "用可验证的斑马逻辑网格谜题评估约束传播、全局一致性和随搜索空间增大而变化的推理能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2502.01100",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "传统知识问答难以区分记忆与逻辑搜索；该集合用可控规模的CSP分析推理计算的扩展极限。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2502.01100",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "程序先采样完整网格解，再生成线索并用求解器检查唯一解；删除冗余线索后得到自然语言题目。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2502.01100",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "逻辑与自然语言推理研究者设计模板和生成程序，不是每题人工出题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2502.01100",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "通过约束求解验证可解性及唯一解；论文分析求解器冲突数与模型难度的对应关系。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2502.01100",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "N和M均取2至6，共25种尺寸，每种40题；同时控制搜索空间与逻辑约束结构。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2502.01100",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "合成与唯一解验证降低某些数据问题，但公开集合和模板不能证明后续模型未见过测试题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2502.01100",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "数据卡grid_mode测试集1000个谜题；mc_mode测试集3259道选择题。两者是不同配置，不相加为独立谜题数。",
      "sources": [
        {
          "url": "https://huggingface.co/datasets/WildEval/ZebraLogic/raw/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "根据自然语言线索填写完整实体—属性对应网格，输出结构化JSON。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2502.01100",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "文本（数学符号按文本表达）；并非原始图像视频识别任务",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2502.01100",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语题面；形式化/数学符号另见模态与仓库格式",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2502.01100",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "按网格尺寸、搜索空间与Z3冲突等划分；同尺寸不代表同等求解难度。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2502.01100",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "公开评测集合；没有在本轮材料中确认一个独立隐藏官方测试集。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2502.01100",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "整题完整网格正确率为主要指标，单元格正确率为辅助指标。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2502.01100",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "完整网格必须所有对应关系均正确；部分格正确不能等价成整题通过。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2502.01100",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "论文采用含格式示例的CoT/JSON设置；ZeroEval通用README称zero-shot，须使用具体任务配置而非混淆框架总称。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2502.01100",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "ZeroEval：以-d zebra-grid运行；src/evaluation/zebra_grid_eval.py评分，支持本地及API推理。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/WildEval/ZeroEval/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "一轮解答、best-of-3和不同推理预算不能混排；完整题准确率与cell accuracy必须分列。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2502.01100",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/html/2609.27284v1",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
