  "design_goals": {
    "capabilities": {
      "value": "从历史时空场预测后续物理演化；跨多物理系统的代理模型/神经算子学习及长时滚动稳定性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00568",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "常见算子数据只覆盖较少物理行为；此库强调不同维数、边界条件、尺度与非线性机制的多样性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00568",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "领域科学家与数值软件开发者提供真实数值模拟；不是LLM合成问答。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00568",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "计算物理、流体、天体物理、数值分析与机器学习研究者合作。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00568",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "论文逐数据集说明控制方程、生成程序、数值方法与物理机制；独立外审数量待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00568",
          "accessed": "2026-11-07"
        }
      ],
      "status": "待核实"
    },
    "quality_control": {
      "value": "统一HDF5组织、网格/时间元数据及标量、矢量、张量字段；保留各物理系统语义。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00568",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "按完整模拟轨迹划分，避免同一轨迹片段随机跨集合；针对预训练语料污染的独立审计待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00568",
          "accessed": "2026-11-07"
        }
      ],
      "status": "待核实"
    }
  },
  "data_format": {
    "size": {
      "value": "16个数据集，合计15TB（官方口径）；各集约6.9GB至5.1TB。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00568",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://polymathic-ai.org/the_well/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "数值时序回归；单步预测和自回归多步rollout。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00568",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "规则网格数值场、时间序列与物理元数据；HDF5/float32接口。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00568",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "主体为数值张量与Python接口；不是自然语言选择题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00568",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "不同系统误差差异明显；没有统一题目难度等级。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00568",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "每个数据集按轨迹约80%训练、10%验证、10%测试；公开可下载。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00568",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "VRMSE（越低越好，预测目标场均值约为1）；另提供NMSE/NRMSE、最大误差、分频谱误差等。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00568",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "逐物理场计算后平均；单步和不同时间窗rollout分开报告。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00568",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "非LLM提示评测。原论文基线以4个历史时间步预测下一帧，每模型单H100限时12小时训练。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00568",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "https://github.com/PolymathicAI/the_well",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00568",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "不能将不同方程、分辨率、rollout时域或训练算力的误差直接合成总冠军。原论文自称示例基线而非穷尽最优调参。",
      "sources": [
        {
