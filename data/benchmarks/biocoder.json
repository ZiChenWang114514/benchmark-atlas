    "difficulty": {
      "value": "真实项目依赖和专业生物信息任务；无统一难度分档。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2308.16458",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "README列出java_hidden 1,243、python_hidden 1,026；另各有50条public与50条similar；rosalind 253条。名称hidden不等于当前访问受限：README明确完整公共数据已在仓库发布。",
