  "design_goals": {
    "capabilities": {
      "value": "带依赖、类、全局变量等真实上下文的生物信息学函数代码生成。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2308.16458",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "一般短函数题不充分测试生物知识、复杂数据操作及真实项目上下文。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2308.16458",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "GitHub生物项目中的Python函数、Java方法及Rosalind编程题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2308.16458",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "Yale/Google DeepMind生物信息与代码生成研究团队；非声称所有题均独立专家原创。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2308.16458",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "语法解析抽取真实函数，静态分析、人工测试和fuzzing结合构建验证。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2308.16458",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "Docker可执行测试环境与自动化模糊测试，保留依赖/类/全局环境。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2308.16458",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "附录M把函数名与参数改为FUNCTION/VAR0等做混淆消融，降低直接代码记忆作用；不是训练语料严格隔离。该消融Python Pass@1从25.960降至22.771、Java从34.700降至30.700；这是特定提示/实验，不替换官网Summary Only榜。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2308.16458",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "1,026 Python函数、1,243 Java方法，另253个Rosalind例子；不要混同为同一语言总题数。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2308.16458",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "根据签名/上下文/描述生成函数或方法体；多个提示布局。",
