          "url": "https://raw.githubusercontent.com/gersteinlab/BioCoder/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "Pass@1/5/10/20，分Python、Java、Rosalind。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2308.16458",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "代码运行与fuzz-testing判断Passed；Rosalind示例每题20次生成，按组合概率估计Pass@1/5/10/20并跨题均值。不可把Pass@20当成一次生成准确率。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/gersteinlab/BioCoder/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "官网Summary Only榜：temperature0.7、top-p0.95、最大生成256token；GPT4上下文8192。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2308.16458",
          "accessed": "2026-11-07"
