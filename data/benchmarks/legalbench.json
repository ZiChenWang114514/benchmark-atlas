  "design_goals": {
    "capabilities": {
      "value": "问题识别、规则回忆、规则适用、规则结论、法律文本解释、修辞理解六类推理；有明确答案的任务不能代表所有法律实践或法律意见质量。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2308.11462",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "为法律界与 LLM 开发者提供共同词汇，衡量实际有用或律师感兴趣的推理技能。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2308.11462",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "36种原始语料：已发表数据集、法律学者此前未发布的人工编码数据，以及专为LegalBench编写的任务；例如将CUAD长文档跨度抽取改成条款二分类。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2308.11462",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "40 位贡献者，以法律专业人士为主",
      "sources": [
        {
          "url": "https://github.com/HazyResearch/legalbench",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "2022年8月公开征集后，由法律背景贡献者提交；作者对任务进行法律正确性与任务有效性审查（§4.1）。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2308.11462",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "每任务提供构建说明、法律意义、基础提示和示例；规则适用任务另有answer guide，按正确性与是否包含必要推断人工评阅。附录承认OCR字符错误风险。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2308.11462",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "仅部分新构任务采取时间约束：citation_prediction采2023-01-01之后判例，并以当时训练截止假设解释；不是全套162任务或后续模型的无污染证明。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2308.11462",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "162任务，来自36种语料；论文§4.2列35多选、7开放生成、112二分类、8多类/多标签任务。任务不是样本，不能将162当题量。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2308.11462",
          "accessed": "2026-11-08"
        }
      ]
    },
    "question_types": {
      "value": "输入-输出对（分类、抽取、生成等）",
      "sources": [
        {
          "url": "https://github.com/HazyResearch/legalbench",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
