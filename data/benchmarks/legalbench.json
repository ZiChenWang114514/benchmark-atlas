          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": [
        "英语"
      ],
      "sources": [
        {
          "url": "https://github.com/HazyResearch/legalbench",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "任务类型和法律领域多样，论文以具体任务表现分析难度；没有据此补造统一等级或难度比例。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2308.11462",
          "accessed": "2026-11-08"
        }
      ]
    },
    "public_hidden_split": {
      "value": "各任务公开train/test；原论文train仅随机抽2–8条作为few-shot演示，而非大规模训练集。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2308.11462",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://huggingface.co/datasets/nguha/legalbench",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "原论文：分类balanced accuracy、归一化抽取匹配、多目标F1及规则适用人工正确性/分析；Vals榜另报Accuracy。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2308.11462",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://www.vals.ai/benchmarks/legal_bench",
          "accessed": "2026-11-08"
        }
      ]
    },
    "scoring": {
      "value": "分类先精确匹配再计算balanced accuracy；抽取做时态/大小写/标点归一化；多标签F1；法律训练人员参照answer guide评规则适用。不能用单一Accuracy概括原版。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2308.11462",
          "accessed": "2026-11-08"
        }
      ]
    },
    "prompt_settings": {
      "value": "原论文temperature=0.0；分类/抽取遇换行停止，rule_qa及多数application最多150 tokens，diversity_jurisdiction_6为300；Claude另加example标签与答案空间指令。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2308.11462",
          "accessed": "2026-11-08"
        }
      ]
    },
    "official_scripts": {
      "value": "evaluation.py、tasks.py 与 HELM 提示设置文件",
      "sources": [
        {
          "url": "https://github.com/HazyResearch/legalbench",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "Vals 自定任务子集与提示，不同于论文原始评测；前列分差极小（<0.3个百分点）。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/legal_bench",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
