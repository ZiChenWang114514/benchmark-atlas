  "design_goals": {
    "capabilities": {
      "value": "在低资源自定义格式中描述三维液体表面，处理接触角、重力、体积约束、边界积分。",
      "sources": [
        {
          "url": "https://yhenon.github.io/surface-evolver-llm-eval/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "检验可执行计算物理建模，不只测文本物理知识；允许读文档和迭代修复。",
      "sources": [
        {
          "url": "https://yhenon.github.io/surface-evolver-llm-eval/",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
