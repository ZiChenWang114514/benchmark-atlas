  "design_goals": {
    "capabilities": {
      "value": "衡量医生与模型真实工作对话中的临床咨询、写作与文档、医学研究能力及安全性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.27470",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "医学选择题或合成病历不能覆盖常见临床聊天工作；Professional补充而非替代面向患者和医生的HealthBench。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.27470",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "医生测试ChatGPT for Clinicians所得对话；候选15,079例中按质量、代表性及难度选择525例。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.27470",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "190名医生参与，实践经验跨50国、26个医学专科。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.27470",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "至少3名医生分三阶段撰写、审查、最终裁决；困难任务由独立医生确认错误与现实性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.27470",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "困难样本相对候选池富集约3.5倍，约三分之一为红队；为全部任务收集不限时、可联网的专科匹配医生基线。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.27470",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "论文请求不要在线逐题发布数据；使用canary，并保留小型私有held-out集监测训练污染。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.27470",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "525例：care consult 236、writing and documentation 142、medical research 147。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.27470",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "单轮或多轮对话，生成最后用户消息的下一条自由文本答复。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.27470",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": [
        "文本对话"
      ],
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.27470",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "每例有primary language标签；完整语言计数待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.27470",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "typical为医生Likert 3–7，difficult为1–2；困难选择针对当时OpenAI模型，非自然临床分布。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.27470",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "公开525任务的对话、rubric、use_case、type、difficulty、specialty与医生参考答复；另保留小型私有集，数量待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.27470",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "长度调整后的rubric得分；不是临床正确率。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.27470",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "每项非零权重在-10至10，满足计全部点数，否则0；除以正权重总和；每超过2000字符500字扣1.47个百分点；论文均值裁剪至[0,1]。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.27470",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "论文主要比较每题8样本、最高可用推理档；AA为4次重复，用GPT-5.4 low裁判。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.27470",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "官方论文使用内部实现且明确不发布官方外部实现；HealthBench的simple-evals作为参考，不能称完全同一实现。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.27470",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "产品harness、裸模型、是否联网与长度调整/裁剪须分开；困难抽样不能解读为现实临床错误率。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.27470",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
