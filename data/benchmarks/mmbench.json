  "design_goals": {
    "capabilities": {
      "value": "细粒度图文感知与推理，按分层能力体系给出诊断。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2307.06281",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://mmbench.opencompass.org.cn/",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "VQAv2、图像描述等任务不充分反映细粒度能力，纯字符串匹配难兼容自由回答，人工主观打分难扩展。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2307.06281",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://mmbench.opencompass.org.cn/",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "从公开数据集及互联网搜集图文题，组织为三层能力体系，20项细粒度能力；每题单一正确选项。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2307.06281",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://mmbench.opencompass.org.cn/",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "研究团队负责能力体系、数据筛选和质量控制；标注员具体招募背景待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2307.06281",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "论文附录B：先用GPT-4、Gemini-Pro、Qwen-Max做text-only CircularEval，能脱离图片答对的题送人工核验；再用五个VLM筛出全答错题，人工检查歧义、重复选项与错误标签。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2307.06281",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "原论文按三层20能力组织题目，附录B分别处理text-only捷径题和可能的错题；中文翻译再由人工核验。这不是对所有源图像授权或训练污染的保证。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2307.06281",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "待核实",
