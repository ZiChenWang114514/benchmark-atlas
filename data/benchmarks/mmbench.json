    },
    "public_hidden_split": {
      "value": "下载表EN/CN各有dev 1,164及test 1,784题；VLMEvalKit格式仅保留一份图片，Legacy为N选项CircularEval保留N份，正文内容相同；不能据图片副本数推题量。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/open-compass/MMBench/main/README.md",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "CircularEval准确率：N个选项循环移位N次，全部答对才算该题成功；与单次准确率分开。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2307.06281",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://raw.githubusercontent.com/open-compass/MMBench/main/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "scoring": {
      "value": "先用规则提取选项，失败后用ChatGPT匹配答案，最多尝试3次；CircularEval循环移位全部选项，N次全部正确才判该原题成功。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/open-compass/MMBench/main/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
