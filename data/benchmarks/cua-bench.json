  "design_goals": {
    "capabilities": {
      "value": "agent仅观察屏幕、使用键盘鼠标，在实时商业游戏中维持长期规划、视觉判断与操作。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/cua_bench",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "多数agent基准提供文本状态、API或DOM，这里只提供像素与键鼠，动作延迟本身影响结果。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/cua_bench",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
