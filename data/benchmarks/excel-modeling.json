  "design_goals": {
    "capabilities": {
      "value": "构建可在真实Excel中打开并重新计算的投行/私募财务模型，检验数值、公式与可用性。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/emb-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "简单问答或表格单元操作不能覆盖多标签、多场景切换与长链财务计算的一致性。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/emb-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "财务专家先制作Gold模型，再剥离数值和公式形成Template；所有任务、参考模型和rubric由专家创作并同行审阅。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/emb-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "财务领域专家；致谢Andrew Schettino及任务作者/同行评审者。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/emb-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "专家创作并同行评阅业务任务、Gold模型与rubric。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/emb-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "每题由金融专家先做Gold参考模型，再剥离数值和公式得到Template；题目、Gold与rubric同行评阅。提交后真实Excel引擎重算，部分任务跨Base/Bull/Bear等场景切换检查。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/emb-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "51道私有held-out Test专用于本页排行榜，以减少过拟合；另有1题公开与51题可许可Validation。私有不等同已证明训练集完全无污染。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/emb-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "103个专家任务：公开1、私有验证51、隐藏测试51；当前榜仅用51个Test，任务有Template与Scratch两种模式。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/emb-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
