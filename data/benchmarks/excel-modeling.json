  "evaluation": {
    "metrics": {
      "value": "七任务类别等权的accuracy，含Template与Scratch评分。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/emb-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "先由真实Microsoft Excel引擎重算；Template按计分单元值匹配，Scratch按数值/公式/呈现rubric部分给分；先类别内平均，七类别等权。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/emb-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "共享harness，bash读写、execute用Excel重算验证，submit交付；每次最多3.5小时。",
      "sources": [
