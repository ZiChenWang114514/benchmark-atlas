  "design_goals": {
    "capabilities": {
      "value": "基于真实表格与文档，像业务/数据分析师那样完成端到端定量分析，包括解读来源、判断例外与方法选择。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/aa-analyst-agent",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "分析师工作不仅是算术正确，还要选对来源、解释例外并稳定重复得出答案；用5次全对而非偶然成功衡量可托付程度。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/articles/aa-analyst-agent",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "真实表格与文档，包括医疗支出、贸易与商品统计、水文天气、财政拨款、能源成本、财务模型与项目排期；80题跨14业务及科学领域。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/methodology/intelligence-benchmarking#aa-analyst-agent",
          "accessed": "2026-11-07"
        }
      ]
    },
