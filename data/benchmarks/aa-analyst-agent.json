  "evaluation": {
    "metrics": {
      "value": "主指标 pass^5（5次全对比例），并报告 pass@1、pass@5",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/aa-analyst-agent",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "逐次二元判分：每个答案均交Gemini 3 Flash (Reasoning)裁判；确定性数值等价预检查可将符合单位与精度的答案覆盖为通过，不能覆盖为失败。pass^5为80题中五次均正确的比例；pass@1为所有尝试平均正确率；pass@5为至少一次正确的题目比例。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/methodology/intelligence-benchmarking#aa-analyst-agent",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "Stirrup；每题5次独立运行，每次最多100轮；隔离Linux/Python3.12，提供题目源文件、代码执行、URL抓取、图像查看（视觉模型）和最终答案提交；只提交数值或标签，不附解释。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/methodology/intelligence-benchmarking#aa-analyst-agent",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "https://github.com/ArtificialAnalysis/Stirrup",
      "sources": [
