  "design_goals": {
    "capabilities": {
      "value": "科学证据处理、分析、设计优化、科学推理、验证运作、转化、科学沟通七工作流下的专业判断；考察不完整证据、科学约束和可操作输出，不等同真实实验室生产力。",
      "sources": [
