  "construction": {
    "question_sources": {
      "value": "先调查在职科学家工作流形成七类taxonomy，再由173名专家编写问题、附件和逐题rubric；750任务覆盖七生物领域。",
      "sources": [
        {
          "url": "https://cdn.openai.com/pdf/b4299379-0a97-4ffa-8b9b-c3fbb299caa9/lifescibench_preprint.pdf",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://www.biorxiv.org/content/10.64898/2026.08.13.744657v1",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://openai.com/index/introducing-life-sci-bench/",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "173名出题者，须相关学科PhD及至少两年生物技术/制药行业在职经验；领域包括生化、分子生物、神经、免疫、药理、药化与计算生物。",
      "sources": [
        {
          "url": "https://cdn.openai.com/pdf/b4299379-0a97-4ffa-8b9b-c3fbb299caa9/lifescibench_preprint.pdf",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://www.biorxiv.org/content/10.64898/2026.08.13.744657v1",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://openai.com/index/introducing-life-sci-bench/",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "任务可不限轮次修订；接收任务平均六轮自主自动审查、至少两轮专家审查；检查题目与rubric一致、科学挑战、事实依据、语言格式，要求至少90%领域专家一致。",
      "sources": [
        {
          "url": "https://cdn.openai.com/pdf/b4299379-0a97-4ffa-8b9b-c3fbb299caa9/lifescibench_preprint.pdf",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://www.biorxiv.org/content/10.64898/2026.08.13.744657v1",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://openai.com/index/introducing-life-sci-bench/",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "另由453名未参与出题专家独立验证，97%博士或同等学位、平均12年经验；真实相关性98.3%、推理技能98.1%、科学依据96.5%、总体有用性96.6%总体认可。独立专家不等于独立机构复测模型。",
      "sources": [
        {
          "url": "https://cdn.openai.com/pdf/b4299379-0a97-4ffa-8b9b-c3fbb299caa9/lifescibench_preprint.pdf",
          "accessed": "2026-11-08"
