  "design_goals": {
    "capabilities": {
      "value": "在离线单轮设定下，评测多模态模型作为自动驾驶化学实验室具身大脑的可操作性、知识、实验过程理解与时序推理能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.06911",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://github.com/HydroSophy/BEAKER",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://huggingface.co/datasets/HydroSophyTech/BEAKER",
          "accessed": "2026-11-10"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文认为既有实验室基准多关注安全、异常或一般科学理解，较少系统评测面向执行的具身能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.06911",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://github.com/HydroSophy/BEAKER",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://huggingface.co/datasets/HydroSophyTech/BEAKER",
          "accessed": "2026-11-10"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "从公开化学实验室图像与视频中筛选，由化学与具身智能专家手工出题与标注，不使用人工智能生成题目或标注。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.06911",
          "accessed": "2026-11-10"
        },
