          "accessed": "2026-11-10"
        }
      ]
    },
    "author_background": {
      "value": "10名化学专家与12名具身专家组成标注团队，并由资深具身专家做质量控制。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.06911",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://github.com/HydroSophy/BEAKER",
