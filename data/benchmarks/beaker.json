        },
        {
          "url": "https://huggingface.co/datasets/HydroSophyTech/BEAKER",
          "accessed": "2026-11-10"
        }
      ]
    },
    "review_process": {
      "value": "跨组盲审，按科学正确性、具身相关性、难度与答案唯一性评审；问题项经裁定后保留1000题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.06911",
          "accessed": "2026-11-10"
        },
