          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "三模型难度筛选、人工审查与返工；只有通过审核的条目才获得奖励。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.15204",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
