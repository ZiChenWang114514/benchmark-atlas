  "design_goals": {
    "capabilities": {
      "value": "检验真实长上下文中的深层理解与推理，超越简单大海捞针。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.15204",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "仅检索固定针或较易短问答不足以测量长文档、多文档、代码仓库和结构数据理解。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.15204",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
