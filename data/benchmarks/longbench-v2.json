  "data_format": {
    "size": {
      "value": "503 道四选一题，6 大任务类、20 子任务；上下文 8k–2M words（词，非 token）。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.15204",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "基于长上下文的四选一选择题",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.15204",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "文本",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.15204",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.15204",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "192 道 easy、311 道 hard；人类专家在 15 分钟限时下准确率 53.7%。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.15204",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "公开测试题及答案，不能把不同长度段看作同难度随机分组。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.15204",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "总体准确率，以及 easy/hard 和 short/medium/long 分组准确率。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.15204",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "从模型生成中提取最终选项，与金标准比较。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.15204",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "原论文 0-shot / 0-shot CoT；temperature 0.1，直接回答上限 128 token、CoT 1024 token；过长输入中间截断。官网后续模型另有预算说明。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.15204",
          "accessed": "2026-11-07"
        }
      ]
    },
