  "evaluation": {
    "metrics": {
      "value": "全题等权fraction correct；MCQ以Hamming loss=0判完全正确；数值题默认误差阈值为目标值的1%；另外记录拒答与置信度，不给部分分。",
      "sources": [
        {
          "url": "https://github.com/lamalab-org/chembench/blob/main/eval-card.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "scoring": {
      "value": "按模型类型提示并用正则抽取；指令模型抽取ANSWER段，失败可用被测LLM辅助提取；数值按1%阈值、MCQ全对计分，拒答检测及重试预算应另记。",
      "sources": [
        {
          "url": "https://github.com/lamalab-org/chembench/blob/main/eval-card.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "prompt_settings": {
      "value": "completion与instruction-tuned使用不同模板，并处理LaTeX、化学符号、单位与分子特殊标记；评测卡不统一限制温度、解码、计算量，提交须附模型和数据版本。",
      "sources": [
        {
          "url": "https://github.com/lamalab-org/chembench/blob/main/eval-card.md",
          "accessed": "2026-11-08"
        }
      ]
