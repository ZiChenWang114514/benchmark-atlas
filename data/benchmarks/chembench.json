  "design_goals": {
    "capabilities": {
      "value": "衡量化学知识、推理、信心校准与安全相关能力，并与化学专家比较。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.01475",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/pdf/2404.01475",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://chembench.lamalab.org/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "通用模型的化学专长缺乏系统性评价；需要区分知识、专门推理、人类偏好及安全判断。",
      "sources": [
        {
          "url": "https://chembench.lamalab.org/",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "考试、习题、IChO、教材、网页、讲义及半程序化生成题；v2 Table 1明确半自动生成1,749题，不能把全部2,788题说成逐题人工原创。所有题入库前改写、标注、审核。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2404.01475",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "由化学与AI专家构建；PR审题者背景包括化学、材料科学、化工和物理，并自行解题和检索验证答案。",
      "sources": [
        {
          "url": "https://github.com/lamalab-org/chembench/blob/main/eval-card.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "逐题以GitHub PR进入，经专家手动解题与检索检查原创性、歧义、事实错误、主题相关及重复后合并；公开保留审核历史。",
      "sources": [
        {
          "url": "https://github.com/lamalab-org/chembench/blob/main/eval-card.md",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/pdf/2404.01475",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "专家逐题审核；CI自动检查schema、LaTeX和格式；问答哈希uuid用于去重；榜单要求全语料评测以避免选择性报告。",
      "sources": [
        {
          "url": "https://github.com/lamalab-org/chembench/blob/main/eval-card.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "沿用BigBench canary并要求开发者过滤训练语料；评测卡明确“未用该语料训练”是期待而非已测试事实。公开题目存在污染风险，不能将canary或人工检索当作绝对无泄漏。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2404.01475",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://github.com/lamalab-org/chembench/blob/main/eval-card.md",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
