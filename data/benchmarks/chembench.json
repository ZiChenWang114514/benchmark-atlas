        }
      ]
    },
    "public_hidden_split": {
      "value": "HF九个config均以名为train的split发布；卡片却明确只供评测，train只是技术名称，不构成训练许可。人类比较另有子集，不等同隐藏测试集。",
      "sources": [
        {
