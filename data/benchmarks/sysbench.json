  "design_goals": {
    "capabilities": {
      "value": "评估模型遵守系统消息约束，以及多轮交互中的持续性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2408.10943",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "常见指令评测主要针对用户消息，无法充分衡量系统指令优先级、多轮依赖和稳定性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2408.10943",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "人工设计系统消息和配套多轮对话，涵盖 6 类系统约束。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2408.10943",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "研究团队人工设计对话、约束和检查清单。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2408.10943",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "为数据配置 ground-truth assistant/checklist，并结合可自动检查与模型裁判的评估。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2408.10943",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "从约束、指令、会话三个粒度统计表现，避免只看单轮是否拒答。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2408.10943",
          "accessed": "2026-11-07"
        }
      ]
    },
