  "design_goals": {
    "capabilities": {
      "value": "评估模型遵守系统消息约束，以及多轮交互中的持续性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2408.10943",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "常见指令评测主要针对用户消息，无法充分衡量系统指令优先级、多轮依赖和稳定性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2408.10943",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "从真实线上日志收集数千条系统消息，经启发式规则与聚类去噪去重；21名经训练标注者选出500条并人工改写。用户对话来自收集与GPT-4o辅助生成，每条保留5轮并按专家指南改写。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2408.10943",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "21名经训练的数据标注者，专家制定标注指南并进行独立多轮核查。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2408.10943",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "每个用户指令标注相关约束的checklist；多名专家独立进行多轮检查；GPT-4o按完整系统消息、历史对话及checklist判断各约束是否满足。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2408.10943",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "论文报告验证器与人工评估一致率超过94%；采用CSR、ISR、SSR三层指标，区分局部满足与五轮整体稳定性。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2408.10943",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "构建阶段以启发式规则及聚类去除重复和噪声；这属于库内去重，独立的预训练语料污染审计仍待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2408.10943",
          "accessed": "2026-11-08"
        }
      ],
      "status": "待核实"
    }
  },
  "data_format": {
    "size": {
      "value": "500个含系统消息的对话，每个包含5轮对话；不是500个独立单轮问题。",
      "sources": [
        {
          "url": "https://github.com/PKU-Baichuan-MLSystemLab/SysBench",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "带系统指令的多轮文本对话",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2408.10943",
          "accessed": "2026-11-08"
        }
      ]
    },
    "modalities": {
      "value": "文本",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2408.10943",
          "accessed": "2026-11-08"
        }
      ]
    },
    "languages": {
      "value": "公开数据包含中文系统消息与中文多轮对话，并含翻译等跨语言要求；论文附录说明展示例为从中文翻译成英语，不能因论文模型分组称English/Chinese就把数据视为完整中英平行版。",
      "sources": [
        {
          "url": "https://github.com/PKU-Baichuan-MLSystemLab/SysBench/blob/main/datas/system_benchmark_eval_datas.json",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/pdf/2408.10943",
          "accessed": "2026-11-08"
        }
      ]
    },
    "difficulty": {
      "value": "约束违反、指令误判、多轮不稳定三个问题，包含依赖或平行对话设置。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2408.10943",
          "accessed": "2026-11-08"
        }
      ]
    },
    "public_hidden_split": {
      "value": "公开文件 datas/system_benchmark_eval_datas.json；包含system_prompt、messages与逐轮prompt_infos（alignment和criteria）。",
      "sources": [
        {
          "url": "https://github.com/PKU-Baichuan-MLSystemLab/SysBench",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "Constraint Satisfaction Rate (CSR)、Instruction Satisfaction Rate (ISR)、Session Stability Rate (SSR)。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2408.10943",
          "accessed": "2026-11-08"
        }
      ]
    },
    "scoring": {
      "value": "GPT-4o按人工checklist逐项判定：CSR统计约束满足比例，ISR要求同一回复所有相关约束满足，SSR衡量多轮稳定；官方README的指标命令写eval_output，但当前根目录无该文件，复现入口与文档一致性仍需留意。",
      "sources": [
        {
          "url": "https://github.com/PKU-Baichuan-MLSystemLab/SysBench",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/pdf/2408.10943",
          "accessed": "2026-11-08"
        }
      ]
    },
    "prompt_settings": {
      "value": "系统消息与用户轮次必须保持原角色和顺序，记录被测模型的 system-role 支持和模板。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2408.10943",
          "accessed": "2026-11-08"
        }
      ]
    },
    "official_scripts": {
      "value": "https://github.com/PKU-Baichuan-MLSystemLab/SysBench",
      "sources": [
        {
          "url": "https://github.com/PKU-Baichuan-MLSystemLab/SysBench",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "CSR、ISR、SSR 粒度不同；不能将厂商报告中未指定指标的 SysBench 分数默认为三者之一。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2408.10943",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
