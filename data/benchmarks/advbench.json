  "data_format": {
    "size": {
      "value": "原论文描述500条有害字符串、500条有害行为；采集日官方 harmful_behaviors.csv 实测520条数据行（不含表头）。这是不同版本/制品，不能默默统一为500或520。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2307.15043",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/llm-attacks/llm-attacks/main/data/advbench/harmful_behaviors.csv",
          "accessed": "2026-11-07"
        }
      ],
      "note": "CSV使用Python csv.DictReader计数，仅计算数据行，不含表头；本次未修改原文件。"
    },
    "question_types": {
      "value": "有害行为请求和目标字符串；此介绍不转载具体攻击后缀或危害步骤",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2307.15043",
          "accessed": "2026-11-07"
        }
      ]
    },
