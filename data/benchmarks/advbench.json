    "prompt_settings": {
      "value": "原论文白盒Table1：20个可优化token、500步、GCG batch512/top-k256；单样本实验前100条，通用攻击以25行为训练再用另100行为测试，分别报告train/test。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2307.15043",
          "accessed": "2026-11-07"
