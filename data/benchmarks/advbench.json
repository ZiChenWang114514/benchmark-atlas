  "design_goals": {
    "capabilities": {
      "value": "评价对齐语言模型在有害行为及指定字符串上的对抗鲁棒性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2307.15043",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "仅人工探索越狱难以系统比较可优化攻击及跨模型转移性，需要统一行为与目标字符串。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2307.15043",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "作者人工种子示例配合Wizard-Vicuna-30B-Uncensored生成；论文区分有害字符串与有害行为。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2307.15043",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "研究团队提供人工种子并筛选生成结果；不是安全专家逐条原创全部条目。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2307.15043",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "作者筛选生成请求，统一行为格式；完整逐条审核记录待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2307.15043",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "原论文与公开CSV规模存在差异，本条保留二者并固定来源；后续研究指出单看非拒答可能高估攻击效果。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2307.15043",
          "accessed": "2026-11-07"
        }
      ]
    },
