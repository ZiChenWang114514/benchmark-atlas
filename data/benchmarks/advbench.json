    },
    "gap_in_prior_benchmarks": {
      "value": "仅人工探索越狱难以系统比较可优化攻击及跨模型转移性，需要统一行为与目标字符串。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2307.15043",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
