  "evaluation": {
    "metrics": {
      "value": "Replication Score：叶节点二元判定后按层级权重聚合，再对论文平均。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2504.01848",
          "accessed": "2026-11-08"
        }
      ]
    },
    "scoring": {
      "value": "三阶段：agent在容器编写代码；独立带GPU容器复现执行；第三容器按论文rubric评分。Code-Dev跳过复现，只评代码开发要求，不可与完整PaperBench分数直比。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/openai/frontier-evals/main/project/paperbench/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
