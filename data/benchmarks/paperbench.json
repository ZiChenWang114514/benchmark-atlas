  "design_goals": {
    "capabilities": {
      "value": "从论文理解贡献、从零开发代码、执行实验并复现现代AI研究。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2504.01848",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "代码题通过不等于能复现科研结论；PaperBench要求从论文编写、执行实验并按作者协作rubric核验实际复现成果，而Code-Dev仅评价代码开发部分。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2504.01848",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "20篇ICML2024 spotlight/oral论文，覆盖12个主题；另设2篇NeurIPS workshop开发论文和内部holdout。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2504.01848",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "OpenAI研究团队与原论文作者共同分解复现目标。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2504.01848",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "层级rubric与原作者协作，多轮内部审查、澄清addendum，最终作者签核。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2504.01848",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "8,316个可独立评分叶节点；新VM执行reproduce.sh后裁判评分；另用JudgeEval测裁判。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2504.01848",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "禁止访问原作者仓库与其他复现；论文报告646次尝试中10次违规被取消，不能排除预训练中记忆代码。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2504.01848",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
