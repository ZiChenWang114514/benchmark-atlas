        },
        {
          "url": "https://arxiv.org/pdf/2610.19780",
          "accessed": "2026-11-10"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，已有科学基准较少系统评测模型能否把实验观察转化为与情境一致的实验室判断。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.19780",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://github.com/johnnylee00/LabOPBench",
