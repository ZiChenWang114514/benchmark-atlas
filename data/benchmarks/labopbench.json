  "design_goals": {
    "capabilities": {
      "value": "评测多模态模型能否依据实验室证据与实验情境，对实验状态、可能原因、风险与下一步操作作出有证据支撑的开放式判断。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.19780",
          "accessed": "2026-11-10"
        },
