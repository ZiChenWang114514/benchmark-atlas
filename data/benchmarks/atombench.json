  "design_goals": {
    "capabilities": {
      "value": "给定晶体相关信息后的重构保真度，量化晶格/原子坐标及匹配覆盖。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "生成器获得条件信息不等，单看匹配成功样本RMSD会掩盖失败；强调全样本ccRMSD。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "JARVIS Supercon-3D与Alexandria DS-A/B超导体结构数据。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "凝聚态物理、材料生成模型与计算材料研究者。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "固定目标结构、训练/测试与模型条件组；用统一结构匹配器计算重构指标。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "CSV保留目标与预测CIF/POSCAR，统一结构匹配与连续纠正误差。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "同源结构训练/测试与生成器预训练可能重叠；需要逐结构审计，不能默认所有模型同等未见。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "H2比较JARVIS103个测试目标、Alexandria825个测试目标；官网旧Alexandria榜显示dataset size8253，是旧口径，不混为测试825。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/html/2609.19487v1",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://atomgptlab.github.io/jarvis_leaderboard/AI/AtomGen/alex_supercon_Tc_a/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "条件晶体重构；不是无条件从零发现新晶体。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "CIF/POSCAR晶体结构、晶格/坐标、超导临界温度等条件。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "结构与数值格式，Python工具。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "依给定条件信息和目标结构而变，无固定自然语言难度分档。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "JARVIS/Alexandria训练测试协议；原文与旧官网的样本口径须分开。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/html/2609.19487v1",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "match rate、匹配样本RMSD、全测试集ccRMSD、晶格MAE与KLD；官网旧子榜可能用RMSE。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "结构匹配器处理对称性/容差；ccRMSD对每个测试结构定义，避免只报成功者。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "不是统一LLM提示；AtomGPT、CDVAE、FlowMM、MatterGen需按条件可见信息分组。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "https://github.com/atomgptlab/atombench",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "H2 ALIGNN-CSP使用32候选+力场筛选/弛豫/对称处理，与单次生成器不等预算。旧榜RMSE不能直接代替新版ccRMSD。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        },
