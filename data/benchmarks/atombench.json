  "design_goals": {
    "capabilities": {
      "value": "给定晶体相关信息后的重构保真度，量化晶格/原子坐标及匹配覆盖。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "生成器获得条件信息不等，单看匹配成功样本RMSD会掩盖失败；强调全样本ccRMSD。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "JARVIS Supercon-3D与Alexandria DS-A/B超导体结构数据。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "凝聚态物理、材料生成模型与计算材料研究者。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "固定目标结构、训练/测试与模型条件组；用统一结构匹配器计算重构指标。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "CSV保留目标与预测CIF/POSCAR，统一结构匹配与连续纠正误差。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "作者用 CIF 文本哈希检查分区不重叠和唯一性；这是作者报告，不等价于全面结构近重复审计。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "JARVIS Supercon-3D 1,058结构/Tc对；Alexandria DS-A/B 8,253对；示范研究四模型、两数据集及可选Tc条件，共12个训练实例。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "条件晶体重构；不是无条件从零发现新晶体。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "原子晶体结构；CSV含id、target、prediction，后两列为POSCAR字符串（论文也描述CIF）。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/atomgptlab/atombench/main/README.md",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "结构与数值格式，Python工具。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "依给定条件信息和目标结构而变，无固定自然语言难度分档。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "每个数据集固定同一10%测试集；需验证集的模型80/10/10，不需验证集的模型90/10；固定种子123；不做交叉验证。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "晶格参数KLD与MAE、匹配率、匹配结构平均RMSD，以及覆盖所有测试结构的ccRMSD（AMD k=100）；不能把匹配子集RMSD当全测试集误差。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "结构匹配器处理对称性/容差；ccRMSD对每个测试结构定义，避免只报成功者。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "不是统一LLM提示；AtomGPT、CDVAE、FlowMM、MatterGen需按条件可见信息分组。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "https://github.com/atomgptlab/atombench",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "这是晶体重建而非 de novo 生成评测；CDVAE可见全结构潜表示，其他模型只见组成或组成+Tc，跨条件分数不能归因为架构优劣。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.16165",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
