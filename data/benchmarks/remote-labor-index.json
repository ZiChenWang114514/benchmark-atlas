  "design_goals": {
    "capabilities": {
      "value": "端到端完成有真实经济价值、客户可接受的远程自由职业项目。",
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/rli",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "从孤立技能和研究题转向真实交易产生的专业交付物，直接与人类标准比较。",
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/rli",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "从Upwork 358名经验证自由职业者收集550初始项目，筛选至240，覆盖23个领域。",
