  "design_goals": {
    "capabilities": {
      "value": "从数据选择、预处理至基因—性状关联的自动化表达分析。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2406.15341",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "一般代码题缺少完整生物数据筛选及质量控制，与真实研究链条脱节。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2406.15341",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "GEO、TCGA/UCSC Xena表达数据，OpenTargets/NCBI Gene等辅助资料。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2406.15341",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "九名受训生物信息学标注者，约20周构建工作。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2406.15341",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "每个性状两人独立分析，再由资深审核者复查；共享指南迭代。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2406.15341",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "统一筛选、选择、预处理及关联参考流程；区分可用与成功预处理数据。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2406.15341",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "依赖公开数据与公共文献；人工参考与任务划分不等于排除基础模型训练暴露。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2406.15341",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "1,384个GTA问题：132个无条件、1,252个有条件；911个输入数据集，152,415个样本，237,907行分析代码。README分别给输入数据41.5 GB及完整下载82.0 GB，二者口径不同。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/Liu-Hy/GenoTEX/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "数据筛选、选择、预处理和基因—性状关联。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2406.15341",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "基因表达矩阵、表型/临床元数据、代码与结果表。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2406.15341",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语任务/数据元信息和生物标识符；数值组学为主。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2406.15341",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
