  "design_goals": {
    "capabilities": {
      "value": "检验模型是否真正读取数学图解，而非依赖题干中的视觉信息转述。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2403.14624",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://mathverse-cuhk.github.io/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "现有视觉数学题常在文字中泄露图中信息，模型不看图也能答对。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2403.14624",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://mathverse-cuhk.github.io/",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
