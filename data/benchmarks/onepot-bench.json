  "design_goals": {
    "capabilities": {
      "value": "分别测无工具化学信息学素养与数值推理（ChemAbacus）、合成请求拒答与安全行为（SynthRefusal）、以及基于私有湿实验数据的反应结果与催化剂偏好（SynthBench）。",
      "sources": [
        {
          "url": "https://www.onepot.ai/blog/onepot-bench-0",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://arxiv.org/abs/2608.02595",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://arxiv.org/pdf/2608.02595",
          "accessed": "2026-11-10"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "既有化学评测多用公开数据，可能进入训练语料，且偏重知识而非实验判断；缺少面向湿实验执行决策的非公开数据评测。",
      "sources": [
        {
          "url": "https://www.onepot.ai/blog/onepot-bench-0",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://arxiv.org/abs/2608.02595",
