  "design_goals": {
    "capabilities": {
      "value": "英语工作语音中精确恢复电话、标识符、路径、URL、命令与单位等结构值。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.28916",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "WER相近的转写可能在关键值上不同，流畅文本未必可供软件正确执行。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.28916",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "先选实体类型、数量与难度，再用合成值构建工作场景和脚本；人类录音。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.28916",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "85位付费、同意数据发布的录音贡献者；研究团队审核实体。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.28916",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "LLM辅助脚本生成，经人工自然性、唯一性、实体一致性与可恢复性审核；录音质量差则重录。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.28916",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "1482实体审计；原12系统中分层200判决人工审计完全一致，但不保证裁判零错误。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.28916",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "public test-only，不提供训练集；公开标签意味着可被适配，需披露任何benchmark特化。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.28916",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "300 WAV录音，5.587小时、85说话者、1482实体、26类型、8工作流领域。",
      "sources": [
        {
          "url": "https://huggingface.co/datasets/besimple-ai/voice-code-bench",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "音频转写；template/acoustic/canonical三层文本与实体标注。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.28916",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": [
        "音频",
        "文本"
      ],
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.28916",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.28916",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "light、standard、dense、stress；人为配额不代表生产分布。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.28916",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "300录音单一公开test split，无训练语料或隐藏榜单。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.28916",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "TSR=全部目标实体都正确的录音比例；CTEM=正确实体比例；WER/WAcc作辅助。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.28916",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "版本化LLM verifier判断canonical值是否可唯一恢复；无害格式变化允许，错符号、数字或单位不允许；TSR不给部分分。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.28916",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "raw-audio-only，不给领域、实体提示、词表、语法约束或转写后修正。流式仅评分final transcript。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.28916",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "HF中scripts及评分/reproduce_release.sh；Vals移植到Valkyrie。",
      "sources": [
        {
          "url": "https://huggingface.co/datasets/besimple-ai/voice-code-bench",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "Vals榜与作者HF当前23系统结果不同，模型/端点/流式设置不同不得直接混排；WER还需区分v1普通与v2 format-invariant。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.28916",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
