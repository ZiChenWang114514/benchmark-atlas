  "design_goals": {
    "capabilities": {
      "value": "面向普通用户与医护人员的开放式医疗对话质量、安全、上下文意识与沟通能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "医学选择题和短答案难反映真实医疗交互，也常缺乏与医生判断的一致性验证。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "以合成情境为主，辅以医生红队与HealthSearchQA改写；262名医生参与，执业经历覆盖60国与26专科。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "262名医生，覆盖26专科与60国执业经历；论文列49种医生可贡献语言，不将此自动当成数据集精确语言分布。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "医生经付费入门任务筛选；持续自动与人工审查，低质量贡献者注释移除。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "共识标准需至少两位且多数医生认可；并通过meta-evaluation比较模型和医生评分一致性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "发布canary及避免传播题例的请求，并保留少量同分布私有hold-out；其规模待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "5,000对话；48,562个唯一rubric标准；Hard为1,000题；Consensus为3,671题且只保留共识标准。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "根据完整单轮或多轮历史回复最后一条用户消息。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": [
        "文本"
      ],
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "多语言医疗对话；精确各语言题量待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "Hard为1,000个困难样本：先对o3、Grok 3、Gemini 2.5 Pro、Claude 3.7 Sonnet与Llama 4 Maverick逐题计分，剔除所有模型均未取得正分的题，再按五模型平均分选最低1,000题；不是自然医疗分布的随机抽样。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "公开主集与少量同分布私有hold-out；hold-out精确题量待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "整体rubric归一化分、分theme/axis分数、worst-at-k；Hard与Consensus独立报告。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "每条rubric权重为-10至10且不为0；满足计该条全部分，否则0；每题除以正权重总和，再对所有题平均，最后将总体分数裁剪至[0,1]。单题可为负，不应逐题先裁剪。默认GPT-4.1裁判。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "生成最终用户消息的回复；原论文OpenAI模型temperature=1，其他厂商设置见附录H。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "OpenAI simple-evals中的HealthBench评测、meta-evaluation、Hard/Consensus与绘图工具。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "原始分数与AA长度调整分数不同；Hard、Consensus和525题Professional不是同一个指标；不能把Professional榜搬到本条。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
