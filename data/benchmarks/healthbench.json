  "design_goals": {
    "capabilities": {
      "value": "面向普通用户与医护人员的开放式医疗对话质量、安全、上下文意识与沟通能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "医学选择题和短答案难反映真实医疗交互，也常缺乏与医生判断的一致性验证。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "以合成情境为主，辅以医生红队与HealthSearchQA改写；262名医生参与，执业经历覆盖60国与26专科。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "262名医生，覆盖26专科与60国执业经历；论文列49种医生可贡献语言，不将此自动当成数据集精确语言分布。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "医生经付费入门任务筛选；持续自动与人工审查，低质量贡献者注释移除。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "共识标准需至少两位且多数医生认可；并通过meta-evaluation比较模型和医生评分一致性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "发布canary及避免传播题例的请求，并保留少量同分布私有hold-out；其规模待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "5,000对话；48,562个唯一rubric标准；Hard为1,000题；Consensus为3,671题且只保留共识标准。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "根据完整单轮或多轮历史回复最后一条用户消息。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": [
        "文本"
      ],
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "多语言医疗对话；精确各语言题量待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08775",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "待核实",
