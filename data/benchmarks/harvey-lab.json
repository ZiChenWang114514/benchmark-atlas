  "design_goals": {
    "capabilities": {
      "value": "像律所分派工作那样：给出指令与客户案卷材料，要求 agent 产出可审阅的法律工作成果（文档、表格、演示）。",
      "sources": [
        {
          "url": "https://www.harvey.ai/blog/introducing-harveys-legal-agent-benchmark",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://www.vals.ai/benchmarks/hlab",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "LegalBench、CUAD、LEXam、BigLaw Bench 等只评短程推理，缺少长程法律 agent 基准。",
      "sources": [
        {
          "url": "https://www.harvey.ai/blog/introducing-harveys-legal-agent-benchmark",
          "accessed": "2026-11-07"
        }
      ]
    }
