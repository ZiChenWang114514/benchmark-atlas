  "evaluation": {
    "metrics": {
      "value": "AA：Hallucination-Gated All-Pass Rate（全部标准满足且无实质性幻觉）；Vals：Task Pass Rate 及 Criteria Pass Rate",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/harvey-lab-aa",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://www.vals.ai/benchmarks/hlab",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "开源标准双裁判claude-sonnet-4-6与gpt-5.5：逐裁判计算任务all-pass，再取平均；一题可为0、0.5或1，严格双裁判都通过另列。AA v1.1使用三裁判并有实质性幻觉门控；Vals为两裁判任务pass率均值。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/harveyai/harvey-labs/HEAD/docs/eval-strategies.md",
          "accessed": "2026-11-07"
