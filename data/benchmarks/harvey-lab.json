  "design_goals": {
    "capabilities": {
      "value": "像律所分派工作那样：给出指令与客户案卷材料，要求 agent 产出可审阅的法律工作成果（文档、表格、演示）。",
      "sources": [
        {
          "url": "https://www.harvey.ai/blog/introducing-harveys-legal-agent-benchmark",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://www.vals.ai/benchmarks/hlab",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "LegalBench、CUAD、LEXam、BigLaw Bench 等只评短程推理，缺少长程法律 agent 基准。",
      "sources": [
        {
          "url": "https://www.harvey.ai/blog/introducing-harveys-legal-agent-benchmark",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "从各执业领域律师经办的真实客户事项出发，拆分为可分派给associate的具体任务；给定指令、案卷及交付物要求。来源并未逐项证明公开材料的脱敏或授权细节，相关流程待核实。",
      "sources": [
        {
          "url": "https://www.harvey.ai/blog/introducing-harveys-legal-agent-benchmark",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "执业律师参与任务来源，rubric由领域专家撰写；首发称75,000+标准，不能把该历史数当作实测条数。",
      "sources": [
        {
          "url": "https://www.harvey.ai/blog/introducing-harveys-legal-agent-benchmark",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "将合伙人/客户会审核的事实、结论、引用、风险等级和交付格式拆成二元标准，并将每条标准绑定具体输出文件；公开集允许法律专业人员审查任务并审核rubric。",
      "sources": [
        {
          "url": "https://www.harvey.ai/blog/introducing-harveys-legal-agent-benchmark",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/harveyai/harvey-labs/HEAD/docs/eval-strategies.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "Vals v1.1披露移除17条不可完成标准、替换1份错配源文件，hold-out仍120任务；官方2026-11-05变更让裁判看到DOCX修订和评论，带修订输出与旧评分不可直接比较。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/hlab",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/harveyai/harvey-labs/HEAD/CHANGELOG.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "待核实",
      "sources": [
        {
          "url": "https://www.harvey.ai/blog/introducing-harveys-legal-agent-benchmark",
          "accessed": "2026-11-07"
        }
      ],
