  "design_goals": {
    "capabilities": {
      "value": "原创、长程真实软件工程任务的完成能力。",
      "sources": [
        {
          "url": "https://deepswe.datacurve.ai/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "避免已有提交或PR改编，并扩大仓库和语言多样性，区分趋于饱和的代码Agent。",
      "sources": [
        {
          "url": "https://deepswe.datacurve.ai/",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "113道原创任务，来自91个活跃、至少500 GitHub stars且使用宽松开源许可的仓库；部分题目受未解决issue启发，但参考实现不复制已有PR/commit。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2607.07946",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://deepswe.datacurve.ai/blog/deepswe",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "软件工程师逐题构造任务、容器、测试和参考实现，并互相评审；论文作者署名机构Datacurve。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2607.07946",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "LLM辅助检查与独立人工复核并行；审核prompt-verifier对应性、可接受替代实现、真实需求与环境洁净度；多种agent试跑辅助检查通过/失败是否合理。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2607.07946",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "每个verifier构建时重复运行3次筛除flaky测试；每次评分加入原仓库测试子集与新增回归检查；参考补丁仅用于审稿，不参与运行评分。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2607.07946",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "原创实现不回流上游PR/commit，容器仅含base commit的浅克隆；这是初次测量时的防污染设计。公开题目、测试与轨迹后，未来模型仍可能摄入这些材料，不能永久声称无污染。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2607.07946",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
