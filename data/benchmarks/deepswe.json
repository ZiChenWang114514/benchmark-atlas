  "evaluation": {
    "metrics": {
      "value": "Pass@1；附成本、输出token和Agent步数。",
      "sources": [
        {
          "url": "https://deepswe.datacurve.ai/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "手工功能测试及回归测试二值评分；pass@1为每题通过比例宏平均；pass@4为最多四次中至少一次通过的题占比。超时/上下文耗尽计失败，provider/verifier/网络错误排除分母且不补采。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2607.07946",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "mini-swe-agent共享单bash工具与system prompt；论文固定commit adfe2023，单rollout限9000秒，不设step或cost cap；约每题每配置4次rollout。v1.1运行需Pier>0.3.0的独立verifier环境。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2607.07946",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://github.com/datacurve-ai/deep-swe/blob/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "https://github.com/datacurve-ai/deep-swe",
      "sources": [
        {
          "url": "https://github.com/datacurve-ai/deep-swe/blob/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "统一harness不等于各厂商生产产品体验；reasoning effort各家不同。95%误差条主要反映重复运行波动，不包含全部任务抽样不确定性；LLM审计分歧率不是verifier真实错误率。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2607.07946",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
