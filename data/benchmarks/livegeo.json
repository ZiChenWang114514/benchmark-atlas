        },
        {
          "url": "https://github.com/LiveGeoWorld/GeoWorld",
          "accessed": "2026-11-14"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "共1237道可验证任务实例，分7类：静态1088道（原子任务478道，其中地点定位132、地点发现171、出行规划175；组合任务610道，其中多主体176、长时程150、安全感知121、区域感知163），以及149道配对动态实例（出行规划23、多主体32、长时程25、安全感知34、区域感知35）。GeoWorld 评测实例覆盖6座城市、88个区域、1376个兴趣点、107372条缓存路径，并向智能体提供8个公开应用命名空间与31个工具。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.17267",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://arxiv.org/pdf/2611.17267.pdf",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://livegeoworld.github.io/",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://github.com/LiveGeoWorld/GeoWorld",
          "accessed": "2026-11-14"
        }
      ]
    },
    "question_types": {
      "value": "智能体通过 GeoWorld 统一接口查询环境、推进虚拟时间并提交任务特定格式的决策。输出约定因任务而异，例如地点定位须先显式选定候选地点，出行规划须报告可行性、路径标识与交通方式，长时程任务须给出按日行程。动态任务在有界虚拟时间窗口内按预定义事件序列展开，智能体自行决定何时查询、推进时间并重新审视先前决策。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.17267",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://arxiv.org/pdf/2611.17267.pdf",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://livegeoworld.github.io/",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://github.com/LiveGeoWorld/GeoWorld",
          "accessed": "2026-11-14"
        }
      ]
    },
