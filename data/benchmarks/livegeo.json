  "design_goals": {
    "capabilities": {
      "value": "考查通用大语言模型智能体在真实城市地理结构上的可靠决策：主动获取与任务相关的信息，核验先前决策所依据的证据是否仍然成立，并在世界状态变化时修订计划。任务覆盖地点定位、地点发现、出行规划，以及多主体、长时程、安全与区域语境等组合决策，并在静态与动态设置下成对评测。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.17267",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://arxiv.org/pdf/2611.17267.pdf",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://livegeoworld.github.io/",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://github.com/LiveGeoWorld/GeoWorld",
          "accessed": "2026-11-14"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文认为，现有评测大多在固定地理快照上推理与规划；即便引入环境动态，也往往针对特定城市过程或向智能体显式展示的预定扰动，难以检验智能体能否在外部世界按自身时间过程演化时，维持以仍然有效的证据为依据的决策。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.17267",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://arxiv.org/pdf/2611.17267.pdf",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://livegeoworld.github.io/",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://github.com/LiveGeoWorld/GeoWorld",
          "accessed": "2026-11-14"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "任务构建于 GeoWorld 平台中的真实城市地理实例。评测实例覆盖上海、东京、新加坡、伦敦、纽约与开普敦六个城市，共88个区域、1376个兴趣点与107372条缓存路径。静态任务先选定可行参考解与由地理事实导出的约束，再由大语言模型改写成自然语言请求；动态任务在保持初始世界状态、约束、参考解与用户请求不变的前提下，注入经核验的时间事件以改变参考解，从而形成配对。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.17267",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://arxiv.org/pdf/2611.17267.pdf",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://livegeoworld.github.io/",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://github.com/LiveGeoWorld/GeoWorld",
          "accessed": "2026-11-14"
        }
      ]
    },
    "author_background": {
      "value": "作者单位为新加坡国立大学、浙江大学、北京邮电大学与牛津大学。论文未提供作者的进一步个人背景说明。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.17267",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://arxiv.org/pdf/2611.17267.pdf",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://livegeoworld.github.io/",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://github.com/LiveGeoWorld/GeoWorld",
          "accessed": "2026-11-14"
        }
      ]
    },
    "review_process": {
      "value": "自然语言请求与动态事件在纳入基准前由人工标注者审阅。附录写明，全部候选实例在纳入前由三名审阅者独立检查实体与世界状态、任务约束、参考解、支持证据以及动态任务的事件时间线一致性，须一致通过方可纳入。表5给出通过审阅的候选比例：静态总体92.5%，动态总体89.2%。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.17267",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://arxiv.org/pdf/2611.17267.pdf",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://livegeoworld.github.io/",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://github.com/LiveGeoWorld/GeoWorld",
          "accessed": "2026-11-14"
        }
      ]
    },
    "quality_control": {
      "value": "静态任务用程序化检查与约束求解器核验参考解满足全部约束、约束扎根于世界状态，且求解所需信息可通过智能体工具获得。动态任务核验事件序列的时间一致性、参考解在相应世界状态下的有效性，以及任务相关变化可通过工具被观察到。构建流程还包括自动化检查（事实与可行性、泄漏与重复）以及人工审阅地图、请求与工具说明清晰度。评测依据预定义输出约定与任务特定约束检查，并保留与世界状态对齐的交互轨迹。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.17267",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://arxiv.org/pdf/2611.17267.pdf",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://livegeoworld.github.io/",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://github.com/LiveGeoWorld/GeoWorld",
          "accessed": "2026-11-14"
        }
      ]
    },
    "decontamination": {
      "value": "构建流程的质控步骤包括泄漏与重复检查；参考解对智能体隐藏。论文未描述针对预训练语料的专门去污染流程。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.17267",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://arxiv.org/pdf/2611.17267.pdf",
