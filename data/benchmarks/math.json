  "design_goals": {
    "capabilities": {
      "value": "评估竞赛数学多步求解、符号操作及最终答案正确性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2103.03874",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "简单算术或短步骤集合不足以反映代数、几何和数论等更广的数学能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2103.03874",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "来自AMC、AIME等竞赛及AoPS整理的数学题，保留完整解答与最终答案。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2103.03874",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "研究者整理已有人类数学竞赛题及解答；并非12500题全由作者原创。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2103.03874",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "整理题目、解答、难度和学科信息，统一为可处理的文本格式。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2103.03874",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "用LaTeX表示数学式，最终答案以boxed标注；几何题部分通过Asymptote代码提供图形信息。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2103.03874",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "题源长期公开；原论文讨论预训练与能力差距，但不能保证后续模型无题目记忆。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2103.03874",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "共12500道竞赛数学题：训练7500、测试5000；MATH-500不可当成完整测试集。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2103.03874",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "数学开放式求解，评分重点为可规范化的最终答案而非逐步证明。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2103.03874",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "自然语言与LaTeX；几何图形由Asymptote代码表示，不是原生栅格图像评测。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2103.03874",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语题面；形式化/数学符号另见模态与仓库格式",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2103.03874",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "5级难度，7学科；不同级别和科目准确率应分别考察。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2103.03874",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "完整训练7500与测试5000均公开；MATH-500仅选取测试中的500题，不能用其分数代表完整集。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2103.03874",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
