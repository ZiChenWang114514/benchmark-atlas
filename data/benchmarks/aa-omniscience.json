  "evaluation": {
    "metrics": {
      "value": "Net Score（-100至100）、accuracy、hallucination rate；三者不同。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/omniscience",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "AA-Omniscience Index = 100×(正确−错误)/总题数，范围−100至100；部分正确及弃答得0。裁判模型为GPT-5.6 Luna (medium)，四类判断为正确、错误、部分正确、未作答。",
      "sources": [
        {
          "url": "https://huggingface.co/datasets/ArtificialAnalysis/AA-Omniscience-Public-v1.1/raw/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
