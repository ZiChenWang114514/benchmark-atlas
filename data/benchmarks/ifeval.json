  "design_goals": {
    "capabilities": {
      "value": "通过可程序验证的约束客观评估指令遵循。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2311.07911",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "人工评测昂贵，模型裁判可能受偏差影响；需要可重复、确定性检查的指令。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2311.07911",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "合成基础提示并添加 1–3 个可验证约束，再移除不合理组合及重写提示。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2311.07911",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "研究团队设计约束与提示；不依赖领域知识考试出题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2311.07911",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "人工检查全部提示，修正不自然或冲突约束。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2311.07911",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "同时报告严格和宽松判定；宽松版本处理格式等变换，但可能增加假阳性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2311.07911",
          "accessed": "2026-11-07"
        }
      ]
    },
