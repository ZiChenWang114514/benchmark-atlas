  "evaluation": {
    "metrics": {
      "value": "prompt-level strict/loose accuracy 与 instruction-level strict/loose accuracy。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2311.07911",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "官方主程序分别调用 strict 与 loose 校验，输出两套JSONL；prompt级准确率为全部指令均通过的回答比例，不应与单条指令通过率混淆。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/google-research/google-research/master/instruction_following_eval/evaluation_main.py",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "按原提示生成回答后调用官方检查器；不要把评分用文本清洗当作模型真正满足原格式。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2311.07911",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "google-research/instruction_following_eval/evaluation_main.py；输入原始指令JSONL及含prompt、response的模型响应JSONL。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/google-research/google-research/master/instruction_following_eval/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "prompt-level 与 instruction-level、strict 与 loose 是四种不同指标，分数必须指明；宽松清洗也有假阳性风险。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2311.07911",
          "accessed": "2026-11-07"
        }
