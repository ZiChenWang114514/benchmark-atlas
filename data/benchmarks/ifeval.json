    "scoring": {
      "value": "确定性检查；严格指标要求满足原始约束，宽松指标对移除 Markdown/首末行等 8 种变换尝试检查。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2311.07911",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "按原提示生成回答后调用官方检查器；不要把评分用文本清洗当作模型真正满足原格式。",
