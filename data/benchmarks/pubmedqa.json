  "design_goals": {
    "capabilities": {
      "value": "根据医学论文摘要回答研究问题，特别考查对定量证据的理解。",
      "sources": [
        {
          "url": "https://aclanthology.org/D19-1259/",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://aclanthology.org/D19-1259.pdf",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "既有生物医学QA常偏事实抽取且专家标注规模小；PubMedQA要求根据原研究摘要尤其定量结果推断yes/no/maybe，并提供独立long_answer供辅助监督。",
      "sources": [
        {
          "url": "https://aclanthology.org/D19-1259.pdf",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://huggingface.co/datasets/qiaojin/PubMedQA/raw/main/README.md",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://raw.githubusercontent.com/pubmedqa/pubmedqa/master/README.md",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/abs/1909.06146",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "PQA-L/U取真实PubMed疑问式文章标题和去结论摘要；PQA-A由陈述式标题按词性和否定状态自动转成问题与yes/no标签，不是人工逐题撰写的211.3k题。",
      "sources": [
        {
          "url": "https://aclanthology.org/D19-1259.pdf",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://huggingface.co/datasets/qiaojin/PubMedQA/raw/main/README.md",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://raw.githubusercontent.com/pubmedqa/pubmedqa/master/README.md",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/abs/1909.06146",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "PQA-L由两位具资格的M.D. candidates标注；原文未把他们称作已执业专科医生。",
      "sources": [
        {
          "url": "https://aclanthology.org/D19-1259.pdf",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://huggingface.co/datasets/qiaojin/PubMedQA/raw/main/README.md",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://raw.githubusercontent.com/pubmedqa/pubmedqa/master/README.md",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/abs/1909.06146",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "标注者1看问题、上下文和结论（reasoning-free）；标注者2只看问题和去结论上下文（reasoning-required）。分歧时讨论；无法达成一致则删除该题。",
      "sources": [
        {
          "url": "https://aclanthology.org/D19-1259.pdf",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://huggingface.co/datasets/qiaojin/PubMedQA/raw/main/README.md",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://raw.githubusercontent.com/pubmedqa/pubmedqa/master/README.md",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/abs/1909.06146",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "人工筛除不能以yes/no/maybe作答的题；双人讨论消歧。PQA-U用规则排除wh问句及多实体选项，识别可回答性与标注者1一致超过93%，不把该比例当测试标签准确率。",
      "sources": [
        {
          "url": "https://aclanthology.org/D19-1259.pdf",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://huggingface.co/datasets/qiaojin/PubMedQA/raw/main/README.md",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://raw.githubusercontent.com/pubmedqa/pubmedqa/master/README.md",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/abs/1909.06146",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "待核实",
