  "design_goals": {
    "capabilities": {
      "value": "围绕原始专业PDF完成有证据依据的真实工作问答，同时检验视觉解析、领域语义、跨页引用与无证据时的拒答。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2607.11192",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "OCR、单表格问答和学科视觉题分别达标，不代表能正确解释实际合同、福利文件、建筑图纸或临床文档。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2607.11192",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "十个专业领域的从业者提交实际工作问题及原PDF；仅保留至少两个前沿模型产生实质错误的候选，排除仅靠常识能答或语义含混的题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2607.11192",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "任务由十类专业领域的在职从业者按日常工作提出；论文作者为Surge AI的Suhaas Garre、Emily Ritchie、Sushant Mehta、Edwin Chen，不把论文作者与全部出题专家混为一谈。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2607.11192",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "专家编写参考答案、原子rubric和能力标签；参考答案须通过自己的rubric，故意错误答案须被对应标准拦截；论文的错误分析另行人工核对原文。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2607.11192",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "专家编写参考答案、原子rubric和能力标签；参考答案须通过自己的rubric，故意错误答案须被对应标准拦截；论文的错误分析另行人工核对原文。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2607.11192",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "论文采用多模型失败筛选与必须依据原PDF的题目要求；这控制题目难度/依证性，不证明训练去污染。原PDF来自现实工作且题目已发布，预训练暴露状况待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2607.11192",
          "accessed": "2026-11-07"
        }
      ],
      "status": "待核实"
    }
  },
