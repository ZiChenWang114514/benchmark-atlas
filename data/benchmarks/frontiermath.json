          "url": "https://arxiv.org/abs/2411.04872",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "中学竞赛集逐渐高分，难以区分高级数学推理和真实研究级问题解决能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2411.04872",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
