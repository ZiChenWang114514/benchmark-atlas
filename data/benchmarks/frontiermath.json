  "design_goals": {
    "capabilities": {
      "value": "评估需要专家较长时间求解的高阶数学问题，保留可自动验证的最终答案。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2411.04872",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "中学竞赛集逐渐高分，难以区分高级数学推理和真实研究级问题解决能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2411.04872",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "数学专家编写此前未发表的原创题，覆盖数论、分析、代数几何、范畴论等；答案可由程序验证。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2411.04872",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "相关数学领域专家设计题目和验证器；典型题需相关研究者数小时至数天。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2411.04872",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "独立专家盲审题目与解答、检查可猜测性，并验证程序评分。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2411.04872",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "控制答案空间与guessproof设计；2026-06-12官方修订说明更正大量题目并删题，必须跟踪版本。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2411.04872",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "原创未发表题、私有评测和加密协作减少泄漏；OpenAI曾有独家访问子集，需同时披露利益冲突。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2411.04872",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "v2共338题：Tiers1–3为295、Tier4为43；公开12题（10+2），其余私有。",
      "sources": [
        {
          "url": "https://epoch.ai/benchmarks/frontiermath",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "难数学问题，提交无参Python answer()函数返回整数或SymPy对象等；不是仅输出自然语言证明。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2411.04872",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "文本（数学符号按文本表达）；并非原始图像视频识别任务",
