  "design_goals": {
    "capabilities": {
      "value": "检验语言模型完成医学物理计算，并核查同事计算中错误的能力，覆盖放射治疗、诊断影像、核医学与辐射防护",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.05340",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://github.com/onusrat/medphysbench",
          "accessed": "2026-11-10"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出该领域既有评测多为选择题考试或开放式评分，缺少对带单位的物理量计算结果以及同行核查能力的判分",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.05340",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://github.com/onusrat/medphysbench",
          "accessed": "2026-11-10"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "十个带随机种子的生成器依据 TG-51、TG-71、TG-43U1、NCRP 151 等协议生成题目，参考答案由实现协议的代码计算",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.05340",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://github.com/onusrat/medphysbench",
          "accessed": "2026-11-10"
        }
      ]
    },
    "author_background": {
      "value": "医学物理研究者",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.05340",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://github.com/onusrat/medphysbench",
          "accessed": "2026-11-10"
        }
      ]
    },
    "review_process": {
      "value": "冻结前用独立的第二实现交叉核对全部求解器，并在开发集上试运行四个模型逐一复核失败；作者说明外部医学物理师盲审尚在计划中",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.05340",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://github.com/onusrat/medphysbench",
          "accessed": "2026-11-10"
        }
      ]
    },
    "quality_control": {
      "value": "两套实现在60,000道题上相对差异不超过1.3×10⁻¹⁵；以经验敏感度分析推导容差带；测试后与已发表算例比对，并对照 NCRP 151 原文复核屏蔽题",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.05340",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://github.com/onusrat/medphysbench",
          "accessed": "2026-11-10"
        }
      ]
    },
    "decontamination": {
      "value": "测试集由未公开密钥经 HMAC-SHA256 派生种子生成，每题带 canary 字符串，并公开测试题参数哈希承诺",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.05340",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://github.com/onusrat/medphysbench",
          "accessed": "2026-11-10"
        }
      ]
    }
  },
