    "languages": {
      "value": "Go、Python、TypeScript、C、C++、JavaScript",
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/swe-atlas?tab=overall",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "论文Refactoring参考修改35–2,073行，要求多文件协调和行为保持；QnA强调运行时证据，Test Writing必须能在真实实现通过、被替换为stub后失败。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2605.08366",
          "accessed": "2026-11-08"
        }
      ]
    },
    "public_hidden_split": {
      "value": "三类完整284任务、reference solution、grader、rubric、judge prompt及digest-pinned公共镜像公开；agent只能见instruction与运行仓库，评分材料由验证阶段使用。",
      "sources": [
        {
          "url": "https://github.com/scaleapi/SWE-Atlas/blob/main/README.md",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "v1.1总体index及三类子榜；每trial reward为0/1，跨3次尝试求均值为pass@1。论文Pass 3是三次全部成功，Pass@3是至少一次成功，不可混淆。",
      "sources": [
        {
          "url": "https://github.com/scaleapi/SWE-Atlas/blob/main/README.md",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/abs/2605.08366",
          "accessed": "2026-11-08"
        }
      ]
    },
    "scoring": {
      "value": "QnA：全部必需rubric通过；TW：manifest+mutation+必需rubric同时通过；RF：行为保持/回归测试+必需rubric通过。v1.1以GPT-6.1 Sol high作judge，3票多数；拒答/空答/无法评分为0，基础设施错误须重跑而非计0。",
      "sources": [
        {
          "url": "https://github.com/scaleapi/SWE-Atlas/blob/main/README.md",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/abs/2605.08366",
          "accessed": "2026-11-08"
        }
      ]
    },
    "prompt_settings": {
      "value": "v1.1配置中Claude Code 2.1.293与Codex 0.142.1，effort max，每任务3次；禁WebSearch/WebFetch、网络allowlist只允许模型端点；judge gpt-6.1-sol high，多数票3次。",
      "sources": [
        {
          "url": "https://github.com/scaleapi/SWE-Atlas/blob/main/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "official_scripts": {
      "value": "Harbor run.sh入口，configs/保存oracle、nop和Anthropic/OpenAI榜单运行配置；data/qa、data/tw、data/rf分别有测试与评分器。",
      "sources": [
        {
          "url": "https://github.com/scaleapi/SWE-Atlas/blob/main/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
