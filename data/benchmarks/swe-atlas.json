  "construction": {
    "question_sources": {
      "value": "专业软件工程工作；当前方法页称来自15个生产仓库、6种语言。",
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/swe-atlas?tab=overall",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "有多年实际软件工程经验的专业工程师编题，另有独立QC团队及三位可信专家审计；附录说明合同报酬符合或超过当地工资要求，不使用无偿志愿劳动。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2605.08366",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "参考解须通过全部检查；独立QC复核；再由三位专家独立核对指令、验证与rubric，至少两位认为无效、过度规定实现或含糊的rubric被剔除。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2605.08366",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "v1.1重新运行所有模型，更新裁判、评分条件并限制网络访问。",
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/swe-atlas?tab=overall",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "Test Writing/Refactoring对passing agent补丁与gold补丁作Jaccard与sequence similarity记忆筛查，未见明显逐字复现；这不证明无污染。容器删除并重新初始化git历史，v1.1进一步限制网络。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2605.08366",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://labs.scale.com/leaderboard/swe-atlas?tab=overall",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "284任务：Codebase QnA 124、Test Writing 90、Refactoring 70；论文v1称18仓库，当前v1.1官网称15仓库，同为284题但来源仓库口径存在差异，未强行统一。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2605.08366",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://labs.scale.com/leaderboard/swe-atlas?tab=overall",
          "accessed": "2026-11-08"
        }
      ]
    },
    "question_types": {
      "value": "每任务单轮目标提示，agent可在仓库Docker中构建、运行与测试。",
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/swe-atlas?tab=overall",
          "accessed": "2026-11-07"
        }
      ]
    },
