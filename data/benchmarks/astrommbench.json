  "design_goals": {
    "capabilities": {
      "value": "读懂天文研究图表、仪器图、观测图像并回答专业物理问题。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "通用VQA不能覆盖天文图像约定与领域推理；与文本AstroLLM、跨模态表示学习互补。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "2024-01至07的3,592篇astro-ph论文，19,299图文对。LLaMA3.3-70B改写上下文，InternVL2.5-78B拟题。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "15名国家天文台审核者：8博士生、5硕士生、2教授；按研究专长分题。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "五模型文本盲答筛去易靠语言先验解的题；余9,677中随机选1,800人工审查，保留592。每题一名主审，非独立双盲。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "检查科学正确、图题一致、上下文充分、唯一答案与干扰项；有问题直接丢弃；无一致性系数测量。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "保留来源arXiv ID；没有训练集审计、近重复搜索或记忆探测。2024公开论文可能被后来模型训练，正式版明确不可称contamination-free。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "592四选一题：GA97、CO108、EP97、HE101、IM83、SR106；25个MLLM（22开放、3闭源）。旧621题摘要不能与正式版混用。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "图像+问题+四选项，单个正确答案。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "天文科研图、图表与文本；不是原始FITS时序分析。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "六子领域；宇宙学均分最低，高能领域模型间方差最大，不应一律称最难。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "HF公开固定592题；当前不是隐藏测试竞赛。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "整体及六子领域accuracy，整体分母固定592；Wilson95%区间辅助解释。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "A–D精确匹配；自由文本用DeepSeek-V3固定二元判分，失败/无效均记错不丢弃。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "VLMEvalKit0.2，图像后接问题四选项；不同模型adapter独立缩放/切片，闭源走官方API。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
