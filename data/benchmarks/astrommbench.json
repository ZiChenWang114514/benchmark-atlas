  "design_goals": {
    "capabilities": {
      "value": "读懂天文研究图表、仪器图、观测图像并回答专业物理问题。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "通用VQA不能覆盖天文图像约定与领域推理；与文本AstroLLM、跨模态表示学习互补。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "2024-01-01 至2024-07-31 的3592篇 arXiv astro-ph 论文，提取19,299个图文对；LLaMA3.3-70B-Instruct 整理文本，InternVL2.5-78B 生成四选一候选。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "15名国家天文台评审：8名天文学博士生、5名硕士生、2名教授；按研究方向分配问题。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "五个纯文本 LLM 各答5次，单模型至少3次答对判为会答；至少两个模型会答则丢弃。余9677题抽1800题专家审核，保留592题。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "专家检查科学正确性、图题对应、上下文充分性、答案唯一性与干扰项；每题一名主审且可见答案和图注，无独立双评及一致性统计。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "记录来源 arXiv ID，但未进行训练语料审计、近重复搜索或记忆探测；不能排除2024年后模型见过来源论文。不得描述为无污染。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "592四选一题：GA97、CO108、EP97、HE101、IM83、SR106；25个MLLM（22开放、3闭源）。旧621题摘要不能与正式版混用。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "图像+问题+四选项，单个正确答案。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "天文科研图、图表与文本；不是原始FITS时序分析。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "六子领域；宇宙学均分最低，高能领域模型间方差最大，不应一律称最难。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "论文结果统一使用592题；公开数据地址已给出。论文没有在本次已读段落定义独立训练/验证划分，划分细节待核实。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "四选一准确率；总体分母固定592，子领域按各自题数计算。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "A—D 单字母先精确匹配；其他自由回答交 DeepSeek-V3 固定二元裁判。解析失败、非法输出或 API 失败计错，不从分母删除。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "VLMEvalKit 0.2；输入为图像、题干和四个带标签选项；具体文本及裁判提示见 Supplementary File S1。图像处理沿各模型 adapter，非统一固定分辨率。",
      "sources": [
        {
          "url": "https://www.mdpi.com/2218-1997/12/10/296",
          "accessed": "2026-11-07"
        }
      ]
    },
