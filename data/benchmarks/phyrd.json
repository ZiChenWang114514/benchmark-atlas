  "design_goals": {
    "capabilities": {
      "value": "复现已发表理论结果的推导，并在修改后的理论条件下继续推导。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.32575",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文认为竞赛题和科学编程评测不足以检查理论物理推导的假设、完整性，以及计算证据是否支持一般结论。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.32575",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
