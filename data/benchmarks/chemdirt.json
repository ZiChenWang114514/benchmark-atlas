  "design_goals": {
    "capabilities": {
      "value": "对同一化学任务的指令改写与分子表示变化保持可靠；跨八类任务诊断鲁棒性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.21504",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "单一提示/表示的成绩容易高估稳定能力，任务平均值掩盖表示及提示敏感性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.21504",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "QM9、ZINC、ChEMBL、PubChem分子及MoleculeNet/ChemLLMBench等已有任务；RDKit构建可计算真值。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.21504",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "Eric Inae、Tim Gunn、Chris Bond、Meng Jiang，Notre Dame。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.21504",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "GPT-5Pro生成十种提示模板并人工核查，实际评测取前四种；清洗继承数据。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.21504",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "官方提供 bundled data/image 校验脚本；运行结果保存原始预测、任务指标、配置、输入哈希和检查点。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/einae-nd/ChemDIRT/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "有继承公开任务与分子库，不能将提示改写视为已去预训练污染；独立模型训练语料审计待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.21504",
          "accessed": "2026-11-07"
        }
      ],
      "status": "待核实"
    }
  },
  "data_format": {
    "size": {
      "value": {
        "readme_questions": 4484,
        "readme_molecular_images": 300,
        "hf_card_train_records": 4482,
