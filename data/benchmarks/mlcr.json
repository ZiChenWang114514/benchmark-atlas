  "design_goals": {
    "capabilities": {
      "value": "跨长篇、碎片化医疗记录重建时间线、因果、治疗模式及保险理赔相关性。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/mlcr-aa",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "不仅定位单条事实，还需专家级临床综合与多部分推理。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/mlcr-aa",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "合成医疗记录，模型上下文可按固定seed确定性插入无关filler；病例、提示、模型、模态、filler比例和thinking levels组成实验矩阵。",
      "sources": [
        {
          "url": "https://github.com/Wisedocs-AI/medical-long-context-reasoning/blob/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "问题模仿医疗及保险理赔专业人员审阅记录的工作；参考答案由人类验证、以真实案例构成为灵感生成合成病例。具体逐题出题人资历待核实。",
      "sources": [
        {
          "url": "https://www.wisedocs.ai/blogs/medical-long-context-reasoning",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "专家标注ground truth，三裁判对照原记录与参考答案。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/mlcr-aa",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "空答案直接失败；多数裁判确认完整且无记录矛盾才通过。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/mlcr-aa",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "官方明确将Tier4–6难题留作私有评测，以降低污染；病例和Tier1–3公开。私有保留是控制措施，不等于已验证所有受测模型从未接触相关材料。",
      "sources": [
        {
          "url": "https://www.wisedocs.ai/blogs/medical-long-context-reasoning",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://www.wisedocs.ai/blogs/mlcr-v1-1-calibrating-llm-judges-for-long-context-medical-reasoning",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "10个合成病例，每例50–150份医疗摘要、25k–64k tokens；首发博客称250个问题，并公开100+个Tier1–3问题。公开仓库另有131份空表OCR及131份合成填表OCR；AA私有60题×3重复独立计数，不累加到题量。",
      "sources": [
        {
          "url": "https://www.wisedocs.ai/blogs/medical-long-context-reasoning",
          "accessed": "2026-11-08"
        },
        {
