  "design_goals": {
    "capabilities": {
      "value": "解释生命科学专业流程中的凝胶、流式图、质粒图、系统发育树与分子结构等真实视觉证据。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.21357",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "强调日常科研视觉产物而非教材考试图或只描述自然图片，检验视觉定位及领域解释。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.21357",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "未发表实验数据、科学软件生成产物、CC-BY开放论文图；专家依自身工作编写问题与参考答案。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.21357",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "31名专业贡献者，87%具博士级训练，74%有超过6年生命科学行业经验。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.21357",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "第二位、经常第三位领域专家盲答；独立答案一致或复审达共识方保留。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.21357",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "检查图像现实性、可答性、任务多样性；GPT-5-mini裁判与4685个人工标注答复的一致率为99.9%（作者自报）。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.21357",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "构建时检查任务未在线出现；数据卡要求不入训练语料；未来额外任务私有开发，不当作本版题量。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.21357",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "161任务；HF test分片parquet。",
