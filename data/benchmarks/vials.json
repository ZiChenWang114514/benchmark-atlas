  "evaluation": {
    "metrics": {
      "value": "官方直接视觉评测为三次独立rollout平均accuracy；AA Agent实现headline为pass^3。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.21357",
          "accessed": "2026-11-08"
        }
      ]
    },
    "scoring": {
      "value": "官方抽取最终ANSWER:后答案，用GPT-5-mini判科学语义等价；标签歧义时带图复核。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.21357",
          "accessed": "2026-11-08"
        }
      ]
    },
    "prompt_settings": {
      "value": "论文直接VLM设temperature 1.0、32768完成token、每题3次；AA用Stirrup代码/看图工具、无网络，GPT-6 Luna medium裁判。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.21357",
          "accessed": "2026-11-08"
        }
      ]
    },
    "official_scripts": {
      "value": "Handshake-AI-Research/VIALS；数据卡明确代码MIT。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.21357",
          "accessed": "2026-11-08"
        }
      ]
    },
    "comparability_warning": {
      "value": "直接视觉、官方工具辅助与AA工具辅助须分开；AA pass^3不等于官网平均accuracy，不能凭较高分说同协议性能提升。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.21357",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
