  "data_format": {
    "size": {
      "value": "论文摘要与官方平台均写明16个物种、57个性状、40,821个样本。附录A.1列出的16个物种为牛、鸡、鹰嘴豆、棉花、马、人、火炬松、玉米、谷子、小鼠、猪、油菜、水稻、大豆、小麦与酵母。论文摘要称合计493,821个单核苷酸多态性，该数字与附录A.1各数据集保留位点数相加一致；官方平台页面写明的单核苷酸多态性为49,771,695，两处不一致",
      "sources": [
        {
          "url": "https://www.biorxiv.org/content/10.64898/2026.10.31.762999v1",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://www.sdu-idea.cn/GPBench/",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://github.com/xwzhang2118/GPBench",
          "accessed": "2026-11-11"
        }
      ]
    },
    "question_types": {
      "value": "基因组预测任务：多数为连续表型回归，人类乳腺癌与年龄相关性黄斑变性等为离散疾病分类",
      "sources": [
        {
          "url": "https://www.biorxiv.org/content/10.64898/2026.10.31.762999v1",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://www.sdu-idea.cn/GPBench/",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://github.com/xwzhang2118/GPBench",
          "accessed": "2026-11-11"
        }
      ]
    },
    "modalities": {
      "value": "全基因组单核苷酸多态性基因型与表型记录",
      "sources": [
        {
          "url": "https://www.biorxiv.org/content/10.64898/2026.10.31.762999v1",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://www.sdu-idea.cn/GPBench/",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://github.com/xwzhang2118/GPBench",
          "accessed": "2026-11-11"
        }
      ]
    },
    "languages": {
      "value": "不适用（数据为基因型与表型，而非自然语言题目）；配套智能分析工具支持中文与英文查询",
      "sources": [
        {
          "url": "https://www.biorxiv.org/content/10.64898/2026.10.31.762999v1",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://www.sdu-idea.cn/GPBench/",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://github.com/xwzhang2118/GPBench",
          "accessed": "2026-11-11"
        }
      ]
    },
    "difficulty": {
      "value": "不同物种与性状上的预测表现差异明显。论文称统计遗传学方法在大多数物种上表现稳定且具有竞争力，基于特征工程的树模型在多个评测维度上取得靠前成绩，而基于序列表示的深度学习模型稳健性与泛化波动较大",
      "sources": [
        {
          "url": "https://www.biorxiv.org/content/10.64898/2026.10.31.762999v1",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://www.sdu-idea.cn/GPBench/",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://github.com/xwzhang2118/GPBench",
          "accessed": "2026-11-11"
        }
      ]
    },
    "public_hidden_split": {
      "value": "所有数据集采用十折交叉验证；划分前以固定随机种子42打乱，各比较方法共用同一划分。对需调参的方法采用嵌套交叉验证：内层由 Optuna 按皮尔逊相关系数或F1选择超参数，外层十折用于无偏估计",
      "sources": [
        {
          "url": "https://www.biorxiv.org/content/10.64898/2026.10.31.762999v1",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://www.sdu-idea.cn/GPBench/",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://github.com/xwzhang2118/GPBench",
          "accessed": "2026-11-11"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "回归任务使用皮尔逊相关系数、平均绝对误差、决定系数、均方根误差与一致性指数；分类任务使用准确率、宏平均精确率、宏平均召回率与宏平均F1分数。另从有效性、敏感性、稳健性与可扩展性四个维度评测，并记录运行时间与CPU/GPU峰值内存",
      "sources": [
        {
          "url": "https://www.biorxiv.org/content/10.64898/2026.10.31.762999v1",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://www.sdu-idea.cn/GPBench/",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://github.com/xwzhang2118/GPBench",
          "accessed": "2026-11-11"
        }
      ]
    },
    "scoring": {
      "value": "各方法在相同的十折划分上训练与测试，输出每折的真实值与预测值，并报告十折平均指标。敏感性分析还在不同样本量、特征维度与随机种子（42、123、246）下考察表现",
      "sources": [
        {
          "url": "https://www.biorxiv.org/content/10.64898/2026.10.31.762999v1",
          "accessed": "2026-11-11"
        },
