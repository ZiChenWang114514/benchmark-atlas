  "design_goals": {
    "capabilities": {
      "value": "为科学机器学习提供跨多种偏微分方程的时间相关模拟评测。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2210.07182",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/pdf/2210.07182",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "科学机器学习研究常使用不一致方程、求解器和评估指标，难以可复现对照；PDEBench提供多维PDE数据、生成器及数据误差和物理一致性指标。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2210.07182",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "数值模拟生成多组初始条件、边界条件与方程参数的数据，配套数据生成代码和机器学习基线。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2210.07182",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/pdf/2210.07182",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "作者来自科学机器学习、数值模拟团队，论文附录K.3列Takamoto、Praditia、Leiteritz、MacKinlay、Alesiani执行模拟；ANU Techlauncher协助部分模拟。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2210.07182",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "不是人工出题审核：按方程/参数/边界条件用数值求解器生成轨迹，附可复现配置；原论文的90/10训练测试切分用于模型对照。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2210.07182",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "以高分辨率数值求解作为参考，提供生成器、配置、预计算误差和FAIR元数据；附录承认离散化误差。DaRUS V8说明已修正advection及Burgers解，不能忽略数据版本。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2210.07182",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://darus.uni-stuttgart.de/dataset.xhtml?persistentId=doi:10.18419/darus-2986",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "数据由数值模拟及随机初始条件生成，不是从网页抓取问答；按样本训练测试切分。公开数据不等于对所有后续模型完成训练重叠检测，必须记录所用文件与版本。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2210.07182",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "论文表1列11个“PDE×空间维数”配置：多数1D及Darcy每参数配置10,000条；2D diffusion-reaction、2D/不可压NS、shallow-water为1,000条，3D可压NS为100条。参数组合会产生多个文件，不能把表中数字直接当全库去重样本总量；DaRUS V8页面列336个文件。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2210.07182",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://darus.uni-stuttgart.de/dataset.xhtml?persistentId=doi:10.18419/darus-2986",
          "accessed": "2026-11-08"
        }
      ]
    },
    "question_types": {
      "value": "数值时空场的前向预测、长时外推及逆问题（恢复初值/方程参数）；不是自然语言选择题。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2210.07182",
          "accessed": "2026-11-08"
        }
      ]
    },
    "modalities": {
      "value": "HDF5数值张量，约定轴为样本N、时间T、空间X/Y/Z、物理变量V；另含网格坐标与方程参数。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2210.07182",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://darus.uni-stuttgart.de/dataset.xhtml?persistentId=doi:10.18419/darus-2986",
          "accessed": "2026-11-08"
        }
      ]
    },
    "languages": {
      "value": "不适用自然语言题库统计：核心数据是数值场；文档为英语，参考机器学习实现为Python/PyTorch。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2210.07182",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://github.com/pdebench/PDEBench",
          "accessed": "2026-11-08"
        }
      ]
    },
    "difficulty": {
      "value": "通过1–3维、激波/湍流、多初值、不同边界条件和参数区间控制数值难度；不定义高中/本科或LLM答题难度档。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2210.07182",
          "accessed": "2026-11-08"
        }
      ]
    },
    "public_hidden_split": {
      "value": "§4.1原实验90%训练、10%测试；附录K.2更宽泛称余下10%作验证/测试，并说明不强制用户沿用切分。数据公开，复现实验应声明所用split，不能捏造统一隐藏测试。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2210.07182",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "RMSE、归一化 RMSE、最大误差，以及适用方程的守恒、边界与频段诊断；按方程与任务分别报告。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.22504",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "将预测场与数值参考逐方程、参数、任务计算RMSE/nRMSE、max error、cRMSE、bRMSE及低/中/高频fRMSE；误差越低越好，不把不同方程分数平均成LLM准确率。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2210.07182",
          "accessed": "2026-11-08"
        }
      ]
    },
    "prompt_settings": {
      "value": "不是LLM提示评测；FNO按原实现协议训练，U-Net使用自回归/pushforward训练变体，PINN基于DeepXDE且每种条件需重训练。论文实验90/10切分，时空分辨率与方程参数随配置变化。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2210.07182",
          "accessed": "2026-11-08"
        }
      ]
    },
    "official_scripts": {
      "value": "pdebench/models 的 train_models_forward.py、train_models_inverse.py 与 metrics.py；实际路径和配置以仓库文档为准。",
      "sources": [
        {
          "url": "https://github.com/pdebench/PDEBench",
          "accessed": "2026-11-08"
        }
      ]
    },
    "comparability_warning": {
      "value": "必须相同方程、参数、网格/时间分辨率、预测时距、数据发布版本与切分；nRMSE等误差越低越好。PINN逐条件拟合与跨样本FNO/U-Net成本不同，不按一句“总榜第一”跨任务合并。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2210.07182",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://darus.uni-stuttgart.de/dataset.xhtml?persistentId=doi:10.18419/darus-2986",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
