        }
      ]
    },
    "difficulty": {
      "value": "每运行10小时与单张H100的有限算力自动后训练；4个1.7B–4B级基础模型，面向数学、通识推理、写作、医疗和代码目标。限制的是训练预算，不是选择题难度分档。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2603.08640",
          "accessed": "2026-11-08"
