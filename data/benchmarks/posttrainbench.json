  "design_goals": {
    "capabilities": {
      "value": "自主构建数据、训练及实验流程，改善给定小型基础LLM的目标能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2603.08640",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "软件工程能力不能直接代表自主AI研发；基准要求agent在固定硬件/时间内自主选择数据和训练方案，提交真实后训练权重，并审查污染与权重替换。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2603.08640",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "四基础模型与六目标基准组合（v1.2）：AIME2025、Arena Hard Writing、GPQA Main、GSM8K、HealthBench Easy、HumanEval。HF轨迹卡仍列历史BFCL，不能据此回滚现行六基准协议。",
      "sources": [
        {
          "url": "https://github.com/aisa-group/PostTrainBench",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://posttrainbench.com/blog/posttrainbench-1-2/",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://huggingface.co/datasets/aisa-group/PostTrainBench-Trajectories/raw/main/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "机器学习/AI安全研究作者团队；通过终端代理自动策划数据与训练实验，基准设计者并不预设每个代理必须采用的后训练策略。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2603.08640",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://github.com/aisa-group/PostTrainBench",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "独立检查数据污染、API使用、查阅历史PostTrainBench轨迹与模型身份。",
      "sources": [
        {
          "url": "https://posttrainbench.com/blog/posttrainbench-1-2/",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "v1.2隔离HumanEval评分进程，移除trust-remote-code，污染裁判三次多数票。",
      "sources": [
        {
          "url": "https://posttrainbench.com/blog/posttrainbench-1-2/",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "禁止从具体测试项衍生训练数据；提供同款n-gram工具；违规运行用基础模型分数。",
      "sources": [
        {
          "url": "https://posttrainbench.com/blog/posttrainbench-1-2/",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
