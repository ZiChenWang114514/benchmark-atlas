  "design_goals": {
    "capabilities": {
      "value": "评估机器学习对复杂地球系统模型气候响应的模拟能力，支持探索不同排放路径。",
      "sources": [
        {
          "url": "https://doi.org/10.1029/2021MS002954",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://ueaeprints.uea.ac.uk/id/eprint/87693/1/WatsonParris_etal_2022_ClimateBench_AAM.pdf",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "不是天气预报，也不是重建真实观测；任务是在不同排放/强迫路径下低成本模拟NorESM2长期气候响应，需同时维持全球均值与区域空间模式。",
      "sources": [
        {
          "url": "https://ueaeprints.uea.ac.uk/id/eprint/87693/1/WatsonParris_etal_2022_ClimateBench_AAM.pdf",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/duncanwp/ClimateBench/main/README.md",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://doi.org/10.5281/zenodo.7064308",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "NorESM2 模拟输出及对应强迫数据；来自多个 CMIP6 实验，条件允许时纳入多个集合成员。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/duncanwp/ClimateBench/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "跨气候科学、气象、统计和机器学习团队；作者贡献段区分DWP的数据处理、DO/ØS的NorESM2模拟与其余成员基线模拟器开发。",
      "sources": [
        {
          "url": "https://ueaeprints.uea.ac.uk/id/eprint/87693/1/WatsonParris_etal_2022_ClimateBench_AAM.pdf",
