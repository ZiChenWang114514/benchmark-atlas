        },
        {
          "url": "https://doi.org/10.5281/zenodo.7064308",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "作者处理CMIP6模拟并以多类基线验证；论文发表于JAMES。数据版本历史公开记录CO2累积量、气溶胶/温室气体对齐及温度日较差缺失值修复。",
      "sources": [
        {
          "url": "https://ueaeprints.uea.ac.uk/id/eprint/87693/1/WatsonParris_etal_2022_ClimateBench_AAM.pdf",
          "accessed": "2026-11-07"
        },
