  "data_format": {
    "size": {
      "value": "96×144纬经网格；4种输入强迫（CO2、CH4、SO2、BC）及4项输出（tas、日较差、pr、pr90）。论文NN配置用754个10年窗训练样本，不能将其当整个数据集唯一题数。",
      "sources": [
        {
          "url": "https://ueaeprints.uea.ac.uk/id/eprint/87693/1/WatsonParris_etal_2022_ClimateBench_AAM.pdf",
          "accessed": "2026-11-07"
        },
