          "accessed": "2026-11-07"
        },
        {
          "url": "https://doi.org/10.5281/zenodo.7064308",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "基于piControl气候态计算输出变化；采用多集合成员及2080–2100平均减弱内部变率；Zenodo保留0.2、0.3、0.4错误修订。",
      "sources": [
        {
          "url": "https://ueaeprints.uea.ac.uk/id/eprint/87693/1/WatsonParris_etal_2022_ClimateBench_AAM.pdf",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/duncanwp/ClimateBench/main/README.md",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://doi.org/10.5281/zenodo.7064308",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "以SSP245完整情景留出评测，属于情景泛化而非LLM预训练去污染；其他情景训练，不能把时间点随机混分等同官方协议。",
      "sources": [
        {
          "url": "https://ueaeprints.uea.ac.uk/id/eprint/87693/1/WatsonParris_etal_2022_ClimateBench_AAM.pdf",
          "accessed": "2026-11-07"
        },
