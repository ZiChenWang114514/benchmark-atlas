        },
        {
          "url": "https://doi.org/10.5281/zenodo.7064308",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "非LLM提示评测；须固定强迫输入、训练情景、历史窗、目标集合平均及SSP245测试时段。",
