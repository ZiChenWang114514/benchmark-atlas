  "design_goals": {
    "capabilities": {
      "value": "比较大模型处理数理与描述性物理问题的能力，并研究推理时计算与多智能体校验。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2508.00079",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/pdf/2508.00079",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "仅检查最终数值难以评价物理原则、逻辑和解答完整性；该工作同时发布可训练/评测题解集，并对比多种推理时自查和外部反馈策略，以PPS而非二元正确率衡量。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2508.00079",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "问题来自物理教材；对应解答从物理论坛和教育网站收集。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2508.00079",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/pdf/2508.00079",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "作者来自IUT计算机科学与工程系Systems and Software Lab；题源为既有物理教材与专家/教育论坛解答，不把作者团队描述成逐题独立物理专家标注队。PPS权重咨询两名高中物理教师与一名大学入学考试评分员。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2508.00079",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "先抓取人类写的教材题和网络解答，Gemini2.5 Pro只按作者描述负责拼写、语法、LaTeX和步骤结构整理；提取类别、主题。论文抽查部分裁判评分，但未声称逐题双人专家核验。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2508.00079",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "清洗原始内容、统一 LaTeX、用 Gemini 2.5 Pro Think 分解解答步骤，并标注主题、难度及物理原理。此过程不等于逐题独立专家复核。",
      "sources": [
        {
          "url": "https://github.com/areebuzair/PhysicsEval",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "90/10训练测试切分；问题和参考解答来自公开教材/网站，不能排除预训练记忆。论文推理时实验不是测试集训练；不将随机切分当作已完成训练语料去污染。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2508.00079",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "19,609 题；17,647 训练、1,962 测试，共 19 类。",
      "sources": [
        {
          "url": "https://github.com/areebuzair/PhysicsEval",
          "accessed": "2026-11-08"
        }
      ]
    },
    "question_types": {
      "value": "开放式数理计算与描述性物理问答，附分步骤参考解答；19类。不是选择题准确率，主结果采用解答质量PPS。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2508.00079",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://github.com/areebuzair/PhysicsEval",
          "accessed": "2026-11-08"
        }
      ]
    },
    "modalities": {
      "value": "文本与LaTeX公式、分步解答、类别/主题/难度元数据；本发布未按输入图片构建统一视觉赛道。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2508.00079",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://huggingface.co/datasets/IUTVanguard/PhysicsEval/raw/main/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "languages": {
      "value": "英语（HF 数据卡 language: en）。",
      "sources": [
        {
          "url": "https://huggingface.co/datasets/IUTVanguard/PhysicsEval/raw/main/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "difficulty": {
      "value": "逐题标注 1–10 难度；同时提供解题步数，部分题提供替代解法。",
      "sources": [
        {
          "url": "https://github.com/areebuzair/PhysicsEval",
          "accessed": "2026-11-08"
        }
      ]
    },
    "public_hidden_split": {
      "value": "90:10 训练/测试划分，分别 17,647 与 1,962；README 未列独立验证集。",
      "sources": [
        {
          "url": "https://github.com/areebuzair/PhysicsEval",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "Physics Proficiency Score（PPS），论文声明归一化到0–100；另报告六个1–5分项：数学准确、逻辑一致、公式原理、完整性、假设、清晰连贯。不是最终答案二元准确率。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2508.00079",
          "accessed": "2026-11-08"
        }
      ]
    },
    "scoring": {
      "value": "Gemini2.5 Pro看到题目、人工来源参考解答和模型生成解答后按rubric打分。最终PPS权重（表3）：数学0.30、逻辑0.25、公式原理0.20、完整性0.10、假设0.10、清晰0.05；不要与§4.1.2推理时verifier权重混用。式3只写1–5分项加权，正文另称0–100但该式未显式写换算系数，不擅自补公式。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2508.00079",
          "accessed": "2026-11-08"
        }
      ]
    },
    "prompt_settings": {
      "value": "Baseline、Self-Refine、Single-Agent和Multi-Agent四协议分开；Self-Refine要求物理教授自查后重答，Single-Agent由Qwen3-32B提供错误列表；Multi-Agent三裁判Phi4/DeepSeekR1-14B/Qwen3-14B，经Qwen3-32B元裁判整合反馈。提示全文见论文附录A。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2508.00079",
          "accessed": "2026-11-08"
        }
      ]
    },
    "official_scripts": {
      "value": "https://github.com/areebuzair/PhysicsEval",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2508.00079",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/pdf/2508.00079",
          "accessed": "2026-11-08"
        }
      ]
    },
    "comparability_warning": {
      "value": "PPS为模型裁判的部分给分，不是准确率；难度表2按Easy1–4/Medium5–7/Hard8–10，而图3标1–3/4–6/7–10，两处口径冲突须保留。不同推理时协议、裁判版本和难度分组不能跨轨排名。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2508.00079",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
