  "data_format": {
    "size": {
      "value": "首轮报告4079次真实湿实验、46626分钟设备运行，覆盖2个自动化实验站点；干实验与湿实验分榜，任务含四组分与八组分配色、带禁区约束的配色、隐藏漂移、树脂转移、主动pKa推断与光谱匹配等。",
      "sources": [
        {
          "url": "https://github.com/MasterAI-EAM/ai-scientists-last-exam/blob/main/paper/AI_Scientists_Last_Exam.pdf",
