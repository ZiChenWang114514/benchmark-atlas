  "design_goals": {
    "capabilities": {
      "value": "在有限预算与约束下，评测科学智能体能否依据实验反馈做连续决策，覆盖实验优化、安全约束遵守、自适应鲁棒性，以及基于光谱与图像的多模态推理。",
      "sources": [
        {
          "url": "https://github.com/MasterAI-EAM/ai-scientists-last-exam/blob/main/paper/AI_Scientists_Last_Exam.pdf",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://aisle.science/",
          "accessed": "2026-11-10"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，已有科学问答与软件环境中的智能体基准，难以系统测量真实实验中的反复决策、反馈解读、代价与噪声，以及不可逆条件下的及时适应。",
      "sources": [
        {
          "url": "https://github.com/MasterAI-EAM/ai-scientists-last-exam/blob/main/paper/AI_Scientists_Last_Exam.pdf",
          "accessed": "2026-11-10"
        }
      ]
    }
  },
