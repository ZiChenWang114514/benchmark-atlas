  "design_goals": {
    "capabilities": {
      "value": "从文字应用题生成可执行的运算程序，检验最终答案与可解释计算步骤。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "仅看自然语言rationale可能掩盖逻辑错误，需要机器可执行、步骤明确的形式语言。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "在AQuA-RAT上重新标注和修正部分题目，以58种运算和6个领域构造形式程序。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "Figure Eight众包标注者，作者设计运算接口、质量题与专家抽查。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "程序最终值接近正确答案才可提交，之后验证程序与题目/解释是否逻辑一致，至少2/3验证者认可。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "验证通过率94.64%；500题专家样本92%正确（论文口径）；数值碰巧正确仍可能逻辑不对。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://math-qa.github.io/math-QA/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "原AQuA题源和众包数据继承公开性，随机划分不是防止语义近重复或LLM污染的充分手段。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
