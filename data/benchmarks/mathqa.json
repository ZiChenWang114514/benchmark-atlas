  "design_goals": {
    "capabilities": {
      "value": "从文字应用题生成可执行的运算程序，检验最终答案与可解释计算步骤。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "仅看自然语言rationale可能掩盖逻辑错误，需要机器可执行、步骤明确的形式语言。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "在AQuA-RAT上重新标注和修正部分题目，以58种运算和6个领域构造形式程序。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "Figure Eight众包标注者，作者设计运算接口、质量题与专家抽查。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "程序最终值接近正确答案才可提交，之后验证程序与题目/解释是否逻辑一致，至少2/3验证者认可。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "验证通过率94.64%；500题专家样本92%正确（论文口径）；数值碰巧正确仍可能逻辑不对。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://math-qa.github.io/math-QA/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "论文诊断AQuA近重复及rationale不匹配；标注扩展用Levenshtein距离阈值4词进行相似题迁移。随机划分不是模板级隔离，不能据此证明无跨划分相似性或后续LLM污染。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/1905.13319",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "官方 MathQA.zip 实读：train 29,837、dev 4,475、test 2,985（主划分共37,297）；另有 challenge_test 604，不自动计作互斥新题。",
      "sources": [
        {
          "url": "https://math-qa.github.io/math-QA/data/MathQA.zip",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "5选1应用题，同时提供运算程序、rationale、领域标签。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "文本（数学符号按文本表达）；并非原始图像视频识别任务",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语题面；形式化/数学符号另见模态与仓库格式",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "一般应用数学/考试题，涵盖6类领域；不是MATH竞赛集的别名。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "原论文§6.1写80/12/8%顺序为training/dev/test（此前条目错写training/test/dev）。实际公开包train=29,837、dev=4,475、test=2,985，与HF一致；challenge_test=604单独保留。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/1905.13319",
          "accessed": "2026-11-08"
        },
