      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语题面；形式化/数学符号另见模态与仓库格式",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "一般应用数学/考试题，涵盖6类领域；不是MATH竞赛集的别名。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "论文按80%/12%/8%随机划分训练/测试/开发；具体发布包行数与顺序需以文件核验为准。",
      "sources": [
