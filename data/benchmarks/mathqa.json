    "question_types": {
      "value": "5选1应用题，同时提供运算程序、rationale、领域标签。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1905.13319",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
