  "evaluation": {
    "metrics": {
      "value": "Topline：每run最后两次得分取较高，再跨样本汇总；得分为21目标比例；另研究消融学习增益。",
      "sources": [
        {
          "url": "https://epoch.ai/benchmarks/ebr-bench",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "以完成目标计分，不把游戏高分直接视为持续学习增益；学习增益需与仅两次游玩的消融对照。",
      "sources": [
