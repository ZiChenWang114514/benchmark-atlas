  "design_goals": {
    "capabilities": {
      "value": "通过反复游玩陌生复杂桌游Earthborne Rangers，衡量记笔记、长期策略与从经验中学习的能力。",
      "sources": [
        {
          "url": "https://epoch.ai/benchmarks/ebr-bench",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "不只检查首次答题，而是在同一任务连续尝试后是否改善；表现分和学习增益必须区分。",
      "sources": [
        {
          "url": "https://epoch.ai/benchmarks/ebr-bench",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
