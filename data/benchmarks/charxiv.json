  "design_goals": {
    "capabilities": {
      "value": "真实科研图表的基础元素识别与跨复杂视觉元素的综合推理。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2406.18521",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://charxiv.github.io/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "同质化图表和模板问题会高估模型能力；科研原生图表包含更丰富的结构与视觉变化。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2406.18521",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://charxiv.github.io/",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "从arXiv八大学科论文中人工挑选图表，设计描述型与推理型问题；部分推理题为GPT生成或启发后经人工筛选与验证，非全部纯人工初稿。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2406.18521",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://charxiv.github.io/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "推理题标注员为研究生；每图先看GPT-4V生成的10组候选QA，再选取、编辑或自行撰题；不把所有初稿称为纯人工专家原创。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2406.18521",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "所有图表、问题经人类专家挑选、整理、验证；描述题聚焦基本元素，推理题需整合图内信息。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2406.18521",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/princeton-nlp/CharXiv/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "所有图表、问题经人类专家挑选、整理、验证；描述题聚焦基本元素，推理题需整合图内信息。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2406.18521",
          "accessed": "2026-11-07"
        },
