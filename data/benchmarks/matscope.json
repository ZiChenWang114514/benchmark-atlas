  "design_goals": {
    "capabilities": {
      "value": "考查语言模型与智能体在材料研究中区分相近材料状态、依据定量证据推理的能力，分为三部分：M1 无辅助的条件特定推理，M2 借助检索工具把相关文献知识迁移到未解决问题，MatEvoBench-20 在观测逐步披露时进行初始预测与修正",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.12014",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://arxiv.org/pdf/2611.12014",
          "accessed": "2026-11-12"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文认为现有基准已覆盖领域知识、多模态解读与科学工具使用，但对区分相近材料状态、依据定量证据准确推理以及随证据积累保持可靠判断的能力评估不足",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.12014",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://arxiv.org/pdf/2611.12014",
          "accessed": "2026-11-12"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "题目取材于28,872篇去重文献构成的语料库（716,080个文本段），以铝合金和高熵合金为代表体系；选题要求样品可识别、条件明确、目标有定量或关系依据，参考值来自原始测量与有来源支撑的关系",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.12014",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://arxiv.org/pdf/2611.12014",
          "accessed": "2026-11-12"
        }
      ]
    },
    "author_background": {
      "value": "作者来自上海交通大学材料科学与工程学院及南洋理工大学材料与计算学科",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.12014",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://arxiv.org/pdf/2611.12014",
          "accessed": "2026-11-12"
        }
      ]
    },
    "review_process": {
      "value": "每个子问题都配有科学目的、有来源支撑的参考答案和目标特定的评分规则；已核实的抽取与评分错误依据保存的最终答案更正，其余评判疑虑及其对分数的影响单独报告",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.12014",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://arxiv.org/pdf/2611.12014",
          "accessed": "2026-11-12"
        }
      ]
    },
    "quality_control": {
      "value": "数值目标按物理量采用绝对、相对或对数比误差分级；Python 检查数值误差、单位换算与排序；解释性关系由 Gemini 3.1 Flash Lite 评判；任务分数按登记的权重与依赖规则合成；置信区间用按来源分组的2,000次自助重采样估计",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.12014",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://arxiv.org/pdf/2611.12014",
          "accessed": "2026-11-12"
        }
      ]
    },
    "decontamination": {
      "value": "M2 检索时排除构建题目所用的原始文献，并另设权限过滤限制可读正文",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.12014",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://arxiv.org/pdf/2611.12014",
          "accessed": "2026-11-12"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "M1：200项任务、1,124个评分目标，分属96个来源关联组与十类研究功能；M2：20个共同失败案例（64个子问题、66个目标）；MatEvoBench-20：20条研究路径、90个节点",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.12014",
          "accessed": "2026-11-12"
