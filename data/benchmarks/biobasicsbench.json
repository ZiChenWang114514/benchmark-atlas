    },
    "author_background": {
      "value": "出题的是做湿实验的科学家；外部复核者是在湿实验室工作的博士层级科学家。",
      "sources": [
        {
          "url": "https://openai.com/index/measuring-how-ai-agents-handle-wet-lab-science/",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "每题经过未参与出题的Ligo科学家内部复核、湿实验室博士层级科学家外部复核，以及最后一次内部复核。",
      "sources": [
        {
          "url": "https://openai.com/index/measuring-how-ai-agents-handle-wet-lab-science/",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
