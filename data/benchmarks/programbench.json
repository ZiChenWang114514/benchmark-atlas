  "design_goals": {
    "capabilities": {
      "value": "仅给可执行程序与文档，自行设计架构、选择语言并从零实现行为等价程序。",
      "sources": [
        {
          "url": "https://programbench.com",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "不提供函数签名、类骨架或预设目录，区别于局部bug修复及填空式整仓生成。",
      "sources": [
        {
          "url": "https://programbench.com",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "从开源仓库编译原程序，移除源码和测试，只保留二进制与使用文档。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2605.03546",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "待核实",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/programbench",
          "accessed": "2026-11-07"
        }
      ],
      "status": "待核实",
      "note": "已检查所引官方材料，本轮未完成精确核验；不代表官方未公开。"
    },
    "review_process": {
      "value": "agent探索原程序，覆盖率引导fuzz生成行为断言，收集现有行为测试。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2605.03546",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "静态linter筛弱断言；删除不能稳定通过原程序或能通过dummy程序的测试。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2605.03546",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "离线沙箱、原二进制仅可执行，不允许反编译、源码检索或包装原程序；原仓库公开带来潜在记忆风险。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2605.03546",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "200任务；论文版本共248,853测试函数。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2605.03546",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
