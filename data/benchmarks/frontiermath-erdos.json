  "design_goals": {
    "capabilities": {
      "value": "在统一预算下自主证明或推翻开放数学猜想，并提交Lean形式化证明。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.25050",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "避免只报道成功案例、预算不明和人工脚手架不透明；不用数值验证代替完整证明。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.25050",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "Thomas Bloom从erdosproblems.com选取有数学意义与难度的未解问题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.25050",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "Thomas Bloom为数学家及ErdősProblems.com维护者。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.25050",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "50条猜想沿用Formal Conjectures；其余18条由自动形式化流程构造，Bloom逐条复核。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.25050",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "Comparator在独立容器中核对陈述与允许公理，并通过Lean内核重放。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.25050",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "2026年8月均未解；后续已发表证明可能进入训练数据，应按模型知识截止时间过滤。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.25050",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
