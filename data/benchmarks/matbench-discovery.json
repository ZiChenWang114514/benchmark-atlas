  "design_goals": {
    "capabilities": {
      "value": "比较晶体稳定性发现、结构优化、声子/热导率、分子动力学和双原子势能曲线；揭示精度、稳健性与计算成本权衡。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/janosh/matbench-discovery/main/readme.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "评估模型作为稳定无机晶体高通量发现预筛器的实际价值，而非只比较能量回归误差。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2308.14920",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/pdf/2308.14920",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
