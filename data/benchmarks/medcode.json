  "construction": {
    "question_sources": {
      "value": "2755例去标识患者记录，出院总结、进展记录与会诊记录。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/medcode",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "每例两名certified professional coders独立标注。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/medcode",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "可用Codify查验但禁用AI；分歧协作解决。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/medcode",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "保留所需人口与区域信息，ZIP前三位映射辖区；O类分娩编码因混淆不可靠而排除。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/medcode",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "官方发布文明确采用patient-level holdouts；Vals通用方法规定专有基准发布成绩只用始终私有的test set，以降低训练泄漏。去标识化是隐私措施而非单独的污染证明，私有留出也不等于证实所有训练无重叠。",
      "sources": [
        {
          "url": "https://www.vals.ai/blogs/measuring-healthcare-ai-where-it-actually-works",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://www.vals.ai/methodology",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
