  "design_goals": {
    "capabilities": {
      "value": "青少年心理健康对话中紧急安全、临床建议边界及情感依赖/关系边界。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/mental-health",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "风险随多轮对话和青少年拒绝帮助而发展，单轮固定答复无法反映这种变化。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/mental-health",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "12名临床人员构建106个13–17岁虚构情景，以临床经验为依据。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/mental-health",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "临床人员参与出题、同行复核与对话评价。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/mental-health",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "审查现实性、临床合理性与年龄适配；4名临床顾问盲评模拟器候选。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/mental-health",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "8名临床人员独立评20段对话，比较模型与临床人员一致性；模拟青少年为GPT-5.6 Terra。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/mental-health",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "待核实",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/mental-health",
          "accessed": "2026-11-08"
        }
      ],
      "status": "待核实",
      "note": "已检查所引官方材料，未完成精确核验；不代表官方未公开。"
    }
  },
  "data_format": {
    "size": {
      "value": "106个虚构情景；32,555段已评分对话；17模型、18配置、每配置两种系统提示。风险领域35/36/35例；年龄13至17岁依次21/21/21/22/21例。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/mental-health",
          "accessed": "2026-11-08"
        }
      ]
    },
    "question_types": {
      "value": "6、10、15或20次交换；披露问题、接受外援、接受边界时分支。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/mental-health",
          "accessed": "2026-11-08"
        }
      ]
    },
    "modalities": {
