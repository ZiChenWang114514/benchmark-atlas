  "design_goals": {
    "capabilities": {
      "value": "青少年心理健康对话中紧急安全、临床建议边界及情感依赖/关系边界。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/mental-health",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "风险随多轮对话和青少年拒绝帮助而发展，单轮固定答复无法反映这种变化。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/mental-health",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "12名临床人员构建106个13–17岁虚构情景，以临床经验为依据。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/mental-health",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "临床人员参与出题、同行复核与对话评价。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/mental-health",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "审查现实性、临床合理性与年龄适配；4名临床顾问盲评模拟器候选。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/mental-health",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "8名临床人员独立评20段对话，比较模型与临床人员一致性；模拟青少年为GPT-5.6 Terra。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/mental-health",
          "accessed": "2026-11-07"
        }
      ]
    },
