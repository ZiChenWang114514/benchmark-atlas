  "design_goals": {
    "capabilities": {
      "value": "标准化自动红队和稳健拒答评估，比较攻击方法及防御模型。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.04249",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "以往越狱评测在行为集、目标模型、裁判和预算上不统一，容易产生不可复现或夸大的成功率。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.04249",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "研究团队依据多家提供商安全政策人工整理有害行为，覆盖多种功能场景。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.04249",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "研究者进行安全行为分类与筛选。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.04249",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "去除双重意图/含混行为，关注模型输出相对现有信息带来的差异性危害。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.04249",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "开发专用分类器并进行人类验证；copyright场景另有匹配方法。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.04249",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "论文要求test行为及test分类器不用于开发攻击或防御，另设validation分类器；这控制评测开发泄漏，不证明目标LLM预训练没有见过公开数据。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2402.04249",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "510 个行为：400 文本、110 多模态；100 验证、410 测试。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.04249",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "有害行为描述及模型响应评价；本文不转载具体有害请求或攻击串",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.04249",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "文本及图像条件的多模态行为",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.04249",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语为主，具体子集配置需记录",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.04249",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "7 个语义类；功能上含200 standard、100 copyright、100 contextual、110 multimodal行为。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.04249",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "100 validation用于开发，410 test用于报告；不可优化测试分类器后仍声称独立测试。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.04249",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "Attack Success Rate (ASR)，依攻击方法、行为子集、目标模型与预算而定。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.04249",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "文本/上下文行为用微调Llama-2-13B裁判等专用分类方式；版权类采用相应匹配；不可仅靠非拒答算成功。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.04249",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "原论文目标模型 greedy、最多512输出token；攻击预算和分类器设置也必须固定。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.04249",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "官方scripts/run_pipeline.py及evaluation_pipeline文档；步骤依次为测试用例生成、可选合并、目标模型回答、回答分类。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/centerforaisafety/HarmBench/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "没有脱离攻击方法、预算、子集与裁判的“模型安全总分”；ASR越高表示该设置下越易被攻破。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.04249",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
