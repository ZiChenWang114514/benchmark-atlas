  "design_goals": {
    "capabilities": {
      "value": "数据科学、产品管理、公司战略等专业知识工作的分析、格式化呈现和可用交付物。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/aa-briefcase",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "只评短答案忽略真实职业流程中的文件分析、跨材料整合和电子表格/演示/备忘录品质。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/aa-briefcase",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "场景源文件混合真实、增强与合成材料，含Slack导出、邮件、表格、访谈和市场研究；后续周任务可提供全模型相同的标准参考产物。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/methodology/intelligence-benchmarking",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "由行业专家历时数月构建，背景覆盖数据科学、产品管理、企业战略，官方举例包括Google、McKinsey & Company、Boston Consulting Group；不据从业背景推断机构合作。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/articles/aa-briefcase",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "为交付物设计明确rubric，再结合分析质量与呈现质量的成对比较。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/aa-briefcase",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "正式任务独立运行，不继承模型先前提交；后续周可提供全模型相同的base-case文件。按rubric客观条件与分析/呈现成对质量分开评分；公开Lite提供source_graph和traceability证据链。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/methodology/intelligence-benchmarking#aa-briefcase",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://huggingface.co/datasets/ArtificialAnalysis/AA-Briefcase-Lite",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "正式四场景评分材料保留私有；公开第五Lite示例只供体验，不纳入正式榜。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/aa-briefcase",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
