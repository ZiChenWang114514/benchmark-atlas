  "evaluation": {
    "metrics": {
      "value": "复合Elo；另列binary rubric通过率、Analytical Quality与Presentation成对比较。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/aa-briefcase",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "rubric二元通过率转换为合成对局，与分析质量、呈现质量对局合成headline Elo；v1.1在各scope用Crowd-BT拟合评审质量。rubric与pairwise各用三模型panel，每项由均衡抽样的一个judge判定，而非三票多数。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/methodology/intelligence-benchmarking#aa-briefcase",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "每任务独立运行，无此前任务的自生成产物继承；Stirrup/E2B离线sandbox，最多500轮，代码执行、finish、放弃工具，支持视觉的模型可查看图像；正式任务1次运行。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/methodology/intelligence-benchmarking",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "https://github.com/ArtificialAnalysis/Stirrup",
      "sources": [
        {
          "url": "https://huggingface.co/datasets/ArtificialAnalysis/AA-Briefcase-Lite",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://artificialanalysis.ai/methodology/intelligence-benchmarking#aa-briefcase",
          "accessed": "2026-11-07"
        }
      ],
      "note": "Lite公开prompts、grader/rubric、源文件与示例提交；正式私有全套实现不能由此推定已开放。"
    },
    "comparability_warning": {
      "value": "v1.1仅改变Elo拟合，不改变题目；Elo取决于对手池、裁判与拟合，不能按百分正确率解释，也不能与v1 Elo直接作增减。每任务独立运行，不是模型持续工作数周。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/methodology/intelligence-benchmarking#aa-briefcase",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://huggingface.co/datasets/ArtificialAnalysis/AA-Briefcase-Lite",
