  "design_goals": {
    "capabilities": {
      "value": "控制检索条件，区分RAG引起的安全变化、能力变化和拒答变化。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.11758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "RAG评测常把答案正确性、有害输出及拒答混合，或没有控制证据中是否真正包含答案。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.11758",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "使用Wikipedia材料与Claude Sonnet4.5辅助生成，并做自检；构造四种检索条件。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.11758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "研究团队设计安全子类别及基准；人工资质的逐人清单待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.11758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "采用GPT-4.1-mini审计上下文；对balanced样本检查oracle中答案可用性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.11758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "分别报告harmfulness、accuracy和refusal，避免把能力差误判为安全好。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.11758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "待核实",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.11758",
          "accessed": "2026-11-07"
        }
      ],
      "status": "待核实",
      "note": "已检查所列材料，但本批尚未完成该字段的精确核验；不表示官方未公开。"
    }
  },
  "data_format": {
    "size": {
      "value": "完整987条query，balanced子集346条，20个子类别；346×4条件得到每模型1,384条实验记录，不是1,384道独立原题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.11758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "开放问答；四条件：无RAG、oracle答案、同主题无答案、随机良性材料",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.11758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "文本",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.11758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.11758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "安全/不安全知识与不同检索条件的受控比较；不把有害知识准确率直接当安全性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.11758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "公开完整集与balanced子集；四条件共享query，不能当独立随机题集相加。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.11758",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "harmfulness、accuracy、refusal分别报告。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.11758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "有害性由Llama-Guard-3-8B、ShieldGemma-2B、WildGuard三裁判多数决定；准确性由Claude Opus4.7判定；拒答类别独立分析。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.11758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "temperature0、top_p1、关闭sampling、max1024、seed42；每文档截断12,000字符。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.11758",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "https://github.com/The-Safe-AI-Lab/RAG-Safety-Bench",
      "sources": [
        {
          "url": "https://github.com/The-Safe-AI-Lab/RAG-Safety-Bench",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "低unsafe accuracy不一定意味着强安全；应同时看harmfulness和refusal；oracle证据仍有部分答案，不能当100%足额证据。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.11758",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
