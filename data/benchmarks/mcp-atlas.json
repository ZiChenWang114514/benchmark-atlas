  "design_goals": {
    "capabilities": {
      "value": "工具发现、参数构造、跨MCP服务器编排、错误恢复及最终证据综合。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2602.00933",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "避免仅测简单函数调用、模拟API、小工具池或轨迹匹配；以真实多步流程和答案claims评分。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2602.00933",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "人工编写、验证的自然语言任务；不在prompt中直接指定服务器、工具或参数。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2602.00933",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "领域专家编写与审核。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2602.00933",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "参考轨迹实跑、领域审核、提示泄露检查、LLM claims一致性检查和随机人工审计五层质量流程。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2602.00933",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "Docker真实MCP服务、固定有状态数据、版本锁定与每任务重启；参考轨迹只用于诊断不用于轨迹匹配评分。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2602.00933",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "500公开/500私有随机划分；公开私有分数差仅是曝光审计信号，不是污染的直接证据。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2602.00933",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
