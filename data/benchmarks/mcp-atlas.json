  "design_goals": {
    "capabilities": {
      "value": "工具发现、参数构造、跨MCP服务器编排、错误恢复及最终证据综合。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2602.00933",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "避免仅测简单函数调用、模拟API、小工具池或轨迹匹配；以真实多步流程和答案claims评分。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2602.00933",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "人工编写、验证的自然语言任务；不在prompt中直接指定服务器、工具或参数。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2602.00933",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "领域专家编写与审核。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2602.00933",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "参考轨迹实跑、领域审核、提示泄露检查、LLM claims一致性检查和随机人工审计五层质量流程。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2602.00933",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "五层检查：专家实跑参考轨迹、领域审核、提示工具/服务器名泄漏复审、LLM验证claims完整性与轨迹一致性、随机人工审计。环境固定数据与容器版本；最终成功依据claims而非轨迹精确匹配。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2602.00933",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "500公开/500私有随机划分；公开私有分数差仅是曝光审计信号，不是污染的直接证据。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2602.00933",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "论文v3与HF基准定义：1,000任务、36真实MCP服务器、220工具；公开任务500。当前README链接的服务完整清单另称307工具，不以运行环境可用工具总数替换基准实际覆盖220工具。",
