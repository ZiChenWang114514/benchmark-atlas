  "construction": {
    "question_sources": {
      "value": "专家提交已经完成的真实项目，经初审、工程化dry-run与专家委员会最终质量控制。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2606.05405",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "实际从业专家提供已完成项目，不是通用众包工人；论文写250+行业专家，当前主页写300+，应按材料时点区分。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2606.05405",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://agents-last-exam.org/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "初审→工程实现及dry-run→专家委员会最终QC；论文总体池与v1.1公开题数分开记录。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2606.05405",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "论文附录B.2：专家审查参考产物正确性、验收边界及上下文充分性；当前v1.1有57任务须重跑、65可保留，47改指令/43改验证/32改环境/23改数据（类别重叠）。官方release明确其复查不是完整agent验证认证。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2606.05405",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://github.com/rdi-berkeley/agents-last-exam/blob/main/docs/releases/v1.1.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "论文设计保留私有池并滚动替换公开任务；运行时隐藏参考答案仅在agent结束后stage。此设计不排除公开评分代码/外网答案捷径，Epoch独立审查指出实际缺陷。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2606.05405",
