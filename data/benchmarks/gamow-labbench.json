  "design_goals": {
    "capabilities": {
      "value": "评测智能体能否根据真实湿实验室记录，在决策点提交下一步实验或证据支持的结论，并按实验室实际决策的二元量规计分。",
      "sources": [
        {
          "url": "https://gamowlabs.com/labbench-benchmarking-ai-wet-lab-decisions",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://gamowlabs.com/assets/labbench-preprint.pdf",
          "accessed": "2026-11-10"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "页面与预印本强调，模型常能解读既往实验，却难以独立选择、承诺或排序下一步实验。",
      "sources": [
        {
          "url": "https://gamowlabs.com/labbench-benchmarking-ai-wet-lab-decisions",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://gamowlabs.com/assets/labbench-preprint.pdf",
          "accessed": "2026-11-10"
        }
      ]
    }
  },
