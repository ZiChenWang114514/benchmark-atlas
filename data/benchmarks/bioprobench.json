  "construction": {
    "question_sources": {
      "value": "从人类撰写的公开协议构建语料，清洗、结构化、受约束任务构造，并结合自动过滤与专家验证。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.07889",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/pdf/2505.07889",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/html/2505.07889v4",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "测试集由生物学博士专家复核；任务事实、步骤和答案来自原有人类撰写协议，LLM仅受约束地生成干扰项或格式转换。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2505.07889",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "论文说明所有测试实例经过人工专家审查，核对准确性、移除潜在伪影并确认相关性。",
      "sources": [
        {
          "url": "https://arxiv.org/html/2505.07889",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "采用自动化过滤与专家验证结合的质量控制。",
      "sources": [
        {
          "url": "https://arxiv.org/html/2505.07889",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "先对原始协议清洗去重；附录G对PQA做数值扰动敏感性检验，作者明确承认这不能排除ORD/GEN预训练序列记忆。不可将held-out划分等同于预训练无污染。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2505.07889",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "22,413份原始协议，构成523,784个结构化实例；正文§3.2明确其中350,565个来自可公开许可的来源并发布，不能将523,784说成全部可公开下载。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2505.07889",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://github.com/YuyangSunshine/bioprobench",
          "accessed": "2026-11-08"
        }
      ]
    },
    "question_types": {
      "value": "PQA 协议问答、ORD 步骤排序、ERR 错误修正、GEN 协议生成、REA 协议推理。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/YuyangSunshine/bioprobench/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "文本实验协议与结构化JSON；论文明确当前未覆盖真实实验的图像、视频等多模态上下文。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2505.07889",
          "accessed": "2026-11-08"
        }
      ]
    },
    "languages": {
      "value": "英语（官方HF元数据language: en）。",
      "sources": [
        {
          "url": "https://huggingface.co/datasets/BioProBench/BioProBench/blob/main/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "difficulty": {
      "value": "附录C.2：GEN按easy/standard/difficult分层，作者设定近似5:2:1采样比例（不是全库精确统计）；PQA按试剂/参数/操作平衡，ERR按真/假平衡，ORD区分主步骤/子步骤。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2505.07889",
          "accessed": "2026-11-08"
        }
      ]
    },
    "public_hidden_split": {
      "value": "官方提供各任务*_train.json和*_test.json；正文§3.2只公开许可允许的350,565个实例，JoVE/Morimoto Lab等受限来源被排除出公开评测采样；每任务精确Train/Test数量待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2505.07889",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://github.com/YuyangSunshine/bioprobench",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "PQA：Accuracy/Brier；ORD：Exact Match/Kendall tau；ERR：Accuracy/Precision/Recall/F1；GEN：BLEU、关键词及步骤召回/精度；REA：Accuracy/Precision/Recall/Consistency。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/YuyangSunshine/bioprobench/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "问答准确率/Brier、排序 Exact Match/Kendall Tau、纠错 F1、生成步骤召回等；需按任务分开报告。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.07889",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/pdf/2505.07889",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/html/2505.07889v4",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "附录C.4逐任务给提示模板，答案按规定标记和格式抽取；GEN另分direct、zero-shot CoT、one-shot CoT，REA-GEN要求结构化推理。不同提示不得合并排名。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2505.07889",
          "accessed": "2026-11-08"
        }
      ]
    },
    "official_scripts": {
      "value": "官方 Metrics/ 目录按任务提供 PQA.py、ORD.py、ERR.py、GEN.py、REA-ERR.py。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/YuyangSunshine/bioprobench/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "不同数据版本、子集、提示、工具权限及模型快照不得直接混比；历史论文分数不代表当前SOTA。",
      "sources": [
