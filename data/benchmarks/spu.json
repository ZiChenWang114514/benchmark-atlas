  "design_goals": {
    "capabilities": {
      "value": "考查智能体在给定真实湿实验设置、候选条件与测量方案后，对隐藏测量结局进行排序预测的能力，覆盖化学、材料科学、生物学与医学中的反应产率、离子电导率、力学强度、荧光信号与转录组计数等测量终点。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.15049",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://arxiv.org/pdf/2611.15049.pdf",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://spu.unipat.ai/",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://github.com/UniPat-AI/SPU",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://huggingface.co/datasets/UnipatAI/SPU",
          "accessed": "2026-11-14"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文认为，现有结局预测基准多以无工具的单次问答测量模型已有知识；面向科学分析或容器工作流的智能体基准则针对已有数据的分析或确定性测试，而非对尚未向预测者公开的湿实验测量做预测。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.15049",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://arxiv.org/pdf/2611.15049.pdf",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://spu.unipat.ai/",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://github.com/UniPat-AI/SPU",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://huggingface.co/datasets/UnipatAI/SPU",
          "accessed": "2026-11-14"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "100项公开任务来自2025年1月至2026年8月在11种 Nature Portfolio 期刊上线的85篇论文，其中70篇各贡献1项任务、15篇各贡献2项，多数出自 Nature Communications（41篇、43项任务）与 Nature（28篇、40项任务）。16项私有任务来自与科学实验室合作完成的四组尚未发表的湿实验系列。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.15049",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://arxiv.org/pdf/2611.15049.pdf",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://spu.unipat.ai/",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://github.com/UniPat-AI/SPU",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://huggingface.co/datasets/UnipatAI/SPU",
          "accessed": "2026-11-14"
        }
      ]
    },
    "author_background": {
      "value": "牵头机构为 UniPat AI。顾问委员会成员来自斯坦福大学、康奈尔大学、FutureHouse、香港科技大学、北京大学、哈佛大学、香港科技大学（广州）、伊利诺伊大学芝加哥分校与上海大学等。湿实验合作者来自 Yurogen Biosystems LLC、ABclonal Biotechnology Co., Ltd.、Deep Principle 与 Bota Biosciences。公开任务由生物学、化学、材料科学、医学与计算机科学等领域逾十名专家参与构建。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.15049",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://arxiv.org/pdf/2611.15049.pdf",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://spu.unipat.ai/",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://github.com/UniPat-AI/SPU",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://huggingface.co/datasets/UnipatAI/SPU",
          "accessed": "2026-11-14"
        }
      ]
    },
    "review_process": {
      "value": "公开任务在冻结前对照原始文献进行独立于构建过程的审阅，存在阻断性问题则修改后再审。私有任务在冻结前同样通过独立审阅，且未使用模型分数决定纳入哪些实验。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.15049",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://arxiv.org/pdf/2611.15049.pdf",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://spu.unipat.ai/",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://github.com/UniPat-AI/SPU",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://huggingface.co/datasets/UnipatAI/SPU",
          "accessed": "2026-11-14"
        }
      ]
    },
    "quality_control": {
      "value": "领域专家仅从近期 Nature Portfolio 期刊中筛选完整报告定量结果的研究，并避开随单一参数严格单调变化或差值过小、更可能反映实验误差的比较。候选任务经试运行后，按每个子领域至少1项以及科学质量、计算负担与信息量选出100项公开任务。私有四组实验采用独立重复或同板复孔测量。评分由隔离容器中的确定性评分器完成，不使用模型裁判。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.15049",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://arxiv.org/pdf/2611.15049.pdf",
          "accessed": "2026-11-14"
        },
