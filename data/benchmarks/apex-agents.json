  "design_goals": {
    "capabilities": {
      "value": "长程、跨应用的投资银行、管理咨询与公司法专业服务任务。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2601.14242",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "以富文件工作世界减少狭窄、人工化agent任务与真实专业工作的差距。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2601.14242",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "专家用5–10天构建项目世界、材料与专业交付物，再依据世界创建任务和二元rubric及gold outputs。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2601.14242",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "256名专业人士，平均12.9年经验；领域为投行、咨询、公司法。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2601.14242",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "任务与rubric多轮审核；专家检查gold outputs与提示一致性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2601.14242",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "96任务由未参与创建/审查者独立完成，发现的问题修正并推广到其余数据。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2601.14242",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "数据只用于评测；关闭网页搜索，世界提供完成任务所需文件。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2601.14242",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
