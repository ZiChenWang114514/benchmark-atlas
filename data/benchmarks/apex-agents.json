    "scoring": {
      "value": "Gemini 3 Flash low逐项独立判Met/Not met，读取提示、输出、文件改动与criterion，不读完整轨迹。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2601.14242",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "原论文每题8轨迹、250步；AA用452任务、每题3次、Stirrup 200轮，排除投行世界244与246。",
