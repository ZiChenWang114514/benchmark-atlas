    "review_process": {
      "value": "候选题目须经过专家审阅、对抗性模型探测与学生试做；只有满足化学正确性、可评分性与有意义区分度的题目进入最终集合",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.20012",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://www.cosmosmind.ai/leaderboard/chemargus",
