  "design_goals": {
    "capabilities": {
      "value": "考查竞赛级、开放式化学推理与多模态理解，并以分点部分得分定位推理链在整合、误差传播或局部推理上的断裂",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.20012",
          "accessed": "2026-11-11"
        },
