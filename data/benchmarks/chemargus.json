        },
        {
          "url": "https://github.com/CosmosMind-ai/ChemArgus",
          "accessed": "2026-11-11"
        }
      ]
    },
    "quality_control": {
      "value": "构建流程含四步提炼循环与三道质量门控。评分采用双轨：结构式、SMILES、方程与计算值先做确定性化学等价核对，灵活的机理与实验论述再由独立的大语言模型评判按量表逐点给分；低置信与边界样本转交人工复核，并对评判与人工分数做抽查",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.20012",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://www.cosmosmind.ai/leaderboard/chemargus",
          "accessed": "2026-11-11"
        },
        {
          "url": "https://github.com/CosmosMind-ai/ChemArgus",
          "accessed": "2026-11-11"
        }
      ]
    },
    "decontamination": {
      "value": "评分用图像对作答模型不可见；官方说明私有集从未公布。官方榜还把访问控制写入测量设计。公开测试集中的评分量表字段已被剥离",
