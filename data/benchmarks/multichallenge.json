  "design_goals": {
    "capabilities": {
      "value": "多轮对话中的指令保持、用户信息推断记忆、可靠版本编辑与自洽，联合考察上下文注意及推理。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2501.17399",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "MT-Bench近饱和；纯格式多轮指令测试未覆盖自然对话中混合推理和约束。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2501.17399",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "多agent合成候选，再由训练过的标注者审核编辑；仅保留令六个筛选模型中至少三个合理失败的样本。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2501.17399",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "由Scale AI招募并训练的人工标注者编辑多agent候选；复核池与编辑者独立，经过两层审核才接纳。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2501.17399",
          "accessed": "2026-11-08"
        }
      ]
    },
