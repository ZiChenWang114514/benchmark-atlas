  "design_goals": {
    "capabilities": {
      "value": "交互实验设计：改变初始浓度、观察动力学，重建隐藏生化反应系统并验证模型。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02083",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "静态问答不能测可证伪假设、主动实验与迭代科学建模。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02083",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "BioModels的1,096个人工策展模型过滤为350个可执行SBML系统。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02083",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "系统生物学、机器学习与分子建模研究者；源库为人工策展模型。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02083",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "剔除无法执行、无反应/物种、含不支持规则/事件模型；以程序模拟检查。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02083",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "去注释/元数据、匿名化ID、打乱元素、去反应引用；验证Tellurium仿真兼容。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02083",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "匿名化降低靠名称记忆的捷径；源BioModels公开，所以不宣称未进入模型预训练。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02083",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "350系统；小系统137个（少于10反应），大系统213个（最多约400反应）。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02083",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "多步交互实验、Python建模、隐藏反应网络与动力学重建。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02083",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "数值浓度轨迹、SBML/XML、Python与英语交互。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02083",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语任务/代理提示及Python/SBML。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02083",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "按反应系统规模分small/large；强模型在反应结构恢复上仍有限。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02083",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "模型库公开下载；每次实验的真实内部反应系统对代理隐藏。公开数据不等于运行时可直接读gold。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02083",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "NTS拓扑F1、RMS反应F1（区分是否包括modifier）、STE轨迹SMAPE（低为好）。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02083",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "比对反应图及预测轨迹；系统行为相近不等于动力学表达式唯一正确。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02083",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "ReAct代理最多20迭代，另3次debug；Python/Tellurium模拟与浓度扰动。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02083",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "https://github.com/h4duan/SciGym",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02083",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "有无modifier、small/large与动力学误差方向必须保留；无噪声仿真不代表湿实验。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02083",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
