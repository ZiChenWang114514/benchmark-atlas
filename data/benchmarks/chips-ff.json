  "design_goals": {
    "capabilities": {
      "value": "通用ML力场的结构弛豫、弹性、声子、缺陷、表面、界面与非晶物性及计算开销。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.10516",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "仅看能量/力测试误差不足以说明真实半导体材料的下游物性可靠性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.10516",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "JARVIS-DFT参考与半导体部件相关材料，ASE+JARVIS-Tools自动化仿真。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.10516",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "NIST材料计算与机器学习研究者。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.10516",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "以JARVIS-DFT参考属性和公开计算流程核对模型收敛、误差与耗时；论文同时比较FrechetCellFilter和ExpCellFilter，优化器改变结果。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2412.10516",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "比较模型收敛、DFT偏差与成本，多种物性独立评分。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.10516",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "uMLFF可能在重叠材料上训练；需要模型训练集与测试结构重叠审计，不能默认OOD。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.10516",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "原论文104材料、16个MLFF，另近200万结构力预测评测。H2工作流104晶格/弹性、49vacancy、82surface、15界面对；官网vacancy榜为48，协议不同。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.10516",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/html/2609.19487v1",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://pages.nist.gov/jarvis_leaderboard/AI/SinglePropertyPrediction/dft_3d_chipsff_vac_en/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "从原子结构与 JSON 配置驱动弛豫、弹性常数、缺陷/表面/界面、声子、热性质与分子动力学；不是文本问答。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/usnistgov/chipsff/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "原子结构、能量/力、弹性张量、声子与缺陷/表面数值。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.10516",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "数值与Python/ASE；无自然语言考试语言。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.10516",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "不同属性及材料族有独立难度；无统一总分。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.10516",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "公开JARVIS参考与提交预测；每个物性榜的分母可不同，非统一train/test问答集。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.10516",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/html/2609.19487v1",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "属性级MAE及相关指标，收敛率/时间；官网总页称PCC，但vacancy子页实际定义MAE。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.10516",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://pages.nist.gov/jarvis_leaderboard/AI/SinglePropertyPrediction/dft_3d_chipsff_vac_en/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "自动将 MLFF 模拟结果与 JARVIS-DFT 比较；具体指标需绑定性质任务页，不能只写一个全平台指标。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/usnistgov/chipsff/main/README.md",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://pages.nist.gov/jarvis_leaderboard/AI/SinglePropertyPrediction/dft_3d_chipsff_a",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "非提示评测；须固定MLFF checkpoint、ASE弛豫器、阈值、参考晶胞与失败处理。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.10516",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "https://github.com/usnistgov/chipsff",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.10516",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "官网vacancy48点与H2的49点不同；H2界面参考晶胞不匹配改用split-slab protocol；不同参考流程不可直接比SOTA。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.10516",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/html/2609.19487v1",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
