      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.10516",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "非提示评测；须固定MLFF checkpoint、ASE弛豫器、阈值、参考晶胞与失败处理。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.10516",
          "accessed": "2026-11-07"
        }
      ]
