  "design_goals": {
    "capabilities": {
      "value": "沿理解、推理、解释三类能力，评估8个实用化学任务；既比较数值指标，也检查结果对化学家的实际帮助。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2305.18365",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/ChemFoundationModels/ChemLLMBench/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "以通用语言能力或单个化学任务的高分无法判断LLM是否能可靠处理分子表示、反应和化学说明；本研究不以夺取单项SOTA为目标。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2305.18365",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/ChemFoundationModels/ChemLLMBench/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "整合 USPTO、ChEBI-20、反应产率数据及 BBBP/BACE/HIV/Tox21/ClinTox 等已有资源；部分文件需从上游单独下载。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/ChemFoundationModels/ChemLLMBench/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "Olaf Wiest（Notre Dame化学系教授）指导任务选取；与C-CAS高年级博士生讨论，化学研究者对答案作定性分析。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2305.18365",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/ChemFoundationModels/ChemLLMBench/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "基于已有广泛使用的化学数据集建立任务，并为零样本与少样本设计提示和演示例。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2305.18365",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/pdf/2305.18365",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "原始测试集抽样与ICL训练候选不重叠；每个实验重复5次报告均值和方差；化学研究者另作实用性定性审查。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2305.18365",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/ChemFoundationModels/ChemLLMBench/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "论文只确认抽取的测试样本与ICL训练候选不重叠；原始化学数据已公开，不能据此认定LLM预训练去污染。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2305.18365",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/ChemFoundationModels/ChemLLMBench/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "8个任务族；Table 1按任务列出100个测试实例，若一个任务有多个数据集或子方向须分开理解，不把8×100冒称去重后总题量。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2305.18365",
          "accessed": "2026-11-07"
        },
