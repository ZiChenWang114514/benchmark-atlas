        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "名称/产率/试剂任务用准确率；性质分类用Accuracy与F1；反应/逆合成报告Top-1 Accuracy和非法SMILES比例；分子设计另用BLEU、Exact Match、Levenshtein、指纹相似度、FCD与Validity；描述用BLEU、ROUGE、METEOR。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2305.18365",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/ChemFoundationModels/ChemLLMBench/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "按任务脚本确定性计算指标，5次实验报告均值与方差；化学家另作定性审阅。产率任务是高/低分类，不是连续产率RMSE回归。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2305.18365",
