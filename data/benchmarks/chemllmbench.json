          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": [
        "名称互译",
        "分子性质分类",
        "反应产率高低分类",
        "反应产物预测",
        "试剂选择/排序",
        "逆合成",
        "文本到分子设计",
        "分子描述生成"
      ],
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2305.18365",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/ChemFoundationModels/ChemLLMBench/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": [
        "英文自然语言",
        "SMILES/SELFIES分子字符串",
        "反应字符串"
      ],
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2305.18365",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/ChemFoundationModels/ChemLLMBench/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语提示及分子说明；SMILES为主要分子表示，另比较SELFIES。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2305.18365",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/ChemFoundationModels/ChemLLMBench/main/README.md",
          "accessed": "2026-11-07"
