      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "关注回答的具体性和说服力，而非仅统计拒答词是否出现。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "公开提示与评估器；模型裁判验证集与实际目标模型攻击测试不是相同对象。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "拒答、具体性、说服力的组合分，归一化到0–1；另有评估器与人类的一致性指标。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "拒答时记零；否则结合具体性、说服力；提供rubric评估器与Gemma-2B微调评估器。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "按官方评价提示对有害请求及目标回答打分，必须记录裁判模型版本。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "strong_reject包提供evaluate_dataset；rubric-based LLM evaluator和fine-tuned Gemma 2B evaluator是两个不同实现，报告需明确选择。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/dsbowen/strong_reject/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "rubric评分、微调评估器分数和二值ASR不同；评估器MAE也不是目标模型的安全分。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
