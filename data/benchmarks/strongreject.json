  "design_goals": {
    "capabilities": {
      "value": "判定越狱输出是否真正提供具体、可信的有害帮助，而不只判断是否拒答。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "简单非拒答指标会把空泛、无用或不可信回答错误计为越狱成功。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "313条禁止请求；约70%新编，约10%来自AdvBench、约10%来自DAN，其余来自其他来源。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "研究团队结合人工、GPT-4与pplx-70b-online辅助编写及核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "语义去重，检查拒答、回答可能性与提示质量，并人工复核。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "以人类标注验证结构化rubric与微调评估器。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    },
