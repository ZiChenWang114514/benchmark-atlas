  "design_goals": {
    "capabilities": {
      "value": "判定越狱输出是否真正提供具体、可信的有害帮助，而不只判断是否拒答。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "简单非拒答指标会把空泛、无用或不可信回答错误计为越狱成功。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "从既有越狱数据与系统卡中筛选整理，包括AdvBench、DAN、MasterKey、MaliciousInstruct、HarmfulQ及GPT-4 System Card；按6类危害组织。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/dsbowen/strong_reject/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "研究团队结合人工、GPT-4与pplx-70b-online辅助编写及核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "语义去重，检查拒答、回答可能性与提示质量，并人工复核。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "以人类标注验证结构化rubric与微调评估器。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "汇编既有公开有害请求，论文不声称提示库无预训练污染；对评估器验证集与微调训练/验证提示作区分。不能把评估器验证一致性当成目标模型未见过请求的证明。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "313 个禁止请求，6 大类别。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "禁止请求与回答完成度评价；不在本页复现危害操作内容",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.10260",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
