        },
        {
          "url": "https://github.com/NVIDIA/physicsnemo",
          "accessed": "2026-11-14"
        }
      ]
    },
    "question_types": {
      "value": "适定三维不可压缩流动边值问题：模型根据边界网格、规定值与物性，预测时间平均流场（内点七个平均场，以及边界面上的场与无滑移面壁面剪应力）。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.17152",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://arxiv.org/pdf/2611.17152.pdf",
          "accessed": "2026-11-14"
        },
