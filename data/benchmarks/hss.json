  "design_goals": {
    "capabilities": {
      "value": "人类一眼即可推断的隐含时间、空间、社会与抽象结构（因果、轨迹、权力关系、潜规则等）。",
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/hss",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "旧视觉基准常侧重专业知识分析或低层感知，缺少对成人一眼可得的隐含时空、社会、因果结构的测量。HSS排除仅靠清晰裁剪即可解决的感知题及专业知识题。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2610.08966",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
