  "construction": {
    "question_sources": {
      "value": "从开源维护者自己维护的真实仓库设计任务；每位维护者每题投入超过40小时；2.0加入更多安全与性能任务。",
      "sources": [
        {
          "url": "https://cognition.com/blog/frontier-code-2.0",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "20 多位世界级开源开发者，不只是通用标注员。",
      "sources": [
        {
          "url": "https://cognition.com/blog/frontier-code-2.0",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "每题由仓库维护者撰写任务和评分rubric，再经历对抗测试、校准、多阶段人工/自动复核，且每题有Cognition研究员手审；2.0的80%参考解不同于上游PR。",
      "sources": [
        {
          "url": "https://cognition.com/frontiercode",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://cognition.com/blog/frontier-code-2.0",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "20多名开源开发者每题投入40小时以上，人工与自动多阶段审核。2.0中80%参考解不同于上游PR（1.0为60%），属于官方自述QC统计而非独立审计。",
      "sources": [
        {
          "url": "https://cognition.com/blog/frontier-code-2.0",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "题目保持私有；轨迹扫描若发现查找现成解则记0，不能排除仓库本身的预训练接触。",
      "sources": [
        {
          "url": "https://cognition.com/blog/frontier-code-2.0",
          "accessed": "2026-11-07"
        }
      ]
    }
