  "design_goals": {
    "capabilities": {
      "value": "跨美国联邦及州法，检索法律、判例，判断有效性并综合成有权威支持的法律研究答案。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/legal_research",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "不能把部分正确或仅能检索当作法律工作可靠；遗漏一个必要要点也可能造成错误。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/legal_research",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "执业律师原创的真实工作型研究问题，涉及8类法律业务。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/legal_research",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "15位执业律师，平均15年经验，承担出题与复核。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.00609",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "每题至少一位额外执业律师独立复核；15位律师平均15年经验，约4律师工时/题；gold材料除轻度copyediting外不借助AI生成。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2610.00609",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "GPT-5.4裁判对律师多数票rubric标签一致率87.4%。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/legal_research",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "测试集保持私有防止过拟合；公开示例与可许可验证集分开。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/legal_research",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
