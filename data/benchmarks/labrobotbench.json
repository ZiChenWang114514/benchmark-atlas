  "design_goals": {
    "capabilities": {
      "value": "评测前沿模型能否在机器人湿实验室中推理物理空间与复杂生物工作流，诊断故障并恢复、完成中断的实验，并在互相竞争的时限下安排任务。",
      "sources": [
        {
          "url": "https://gamowlabs.com/lab-robot-bench-v0-1",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://gamowlabs.com/benchmarks",
          "accessed": "2026-11-10"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "页面指出，机器人遇到错误时实验常停顿等待人工介入；需要能诊断问题并安全恢复工作的智能体，以提高实验通量。",
      "sources": [
        {
          "url": "https://gamowlabs.com/lab-robot-bench-v0-1",
          "accessed": "2026-11-10"
        },
        {
          "url": "https://gamowlabs.com/benchmarks",
          "accessed": "2026-11-10"
        }
      ]
    }
  },
