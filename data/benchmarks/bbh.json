  "design_goals": {
    "capabilities": {
      "value": "测量组合逻辑、符号操作、算法执行和多步推理，以及显式思维链能否改善这些能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2210.09261",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "BIG-Bench 多任务平均值可能掩盖难题；本研究选择此前语言模型仍落后于人类的任务，单独测量推理瓶颈。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2210.09261",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "从 BIG-Bench 的209个任务中，依题量、自动评分适用性和此前模型相对人类表现筛出23类任务；部分任务细分，形成27个评测子任务。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2210.09261",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "继承 BIG-Bench 社区任务；BBH研究者负责筛选并手写每类任务的思维链演示。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2210.09261",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "以人类基线及此前模型结果进行筛选；不是重新由专家逐题原创一套试卷。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2210.09261",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "限制每子任务最多250道，避免大任务支配比较；多数250道，causal_judgement 187、penguins_in_a_table 146、snarks 178。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2210.09261",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "论文含评测污染警示和识别措施；公开任务不能据此保证未来模型无训练污染。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2210.09261",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "23类任务、27个子任务，共6511道评测题；统计口径为原论文所用BBH。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2210.09261",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "多项选择、布尔判断、短答案和字符串输出，随子任务变化。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2210.09261",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "文本（数学符号按文本表达）；并非原始图像视频识别任务",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2210.09261",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语题面；形式化/数学符号另见模态与仓库格式",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2210.09261",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "按此前模型低于人类基线筛选，属于相对难度定义，不是统一年级或难度等级。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2210.09261",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "公开评测题及每任务3个人工CoT示例；不应把示例计入评测题量。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2210.09261",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "最终答案精确匹配准确率；同时按任务报告，不把所有题直接混合为唯一分数。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2210.09261",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "抽取最终答案后与目标答案比对，原论文比较直接回答与思维链提示。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2210.09261",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "原论文3-shot示例，比较有无CoT，greedy / temperature 0；不同模型上下文与输出格式需另记。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2210.09261",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "官方仓库发布bbh/题目、cot-prompts/三例提示和code-davinci-002-outputs/；README未给统一现代LLM runner，不能把仓库本身说成已验证的全模型评分脚本。",
