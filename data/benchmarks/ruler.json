  },
  "data_format": {
    "size": {
      "value": "13 个任务配置；原论文各任务、各长度 500 条，测试长度 4k、8k、16k、32k、64k、128k token。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "合成检索、变量追踪、聚合与问答",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "文本",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语任务模板；具体语料配置应固定",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "通过长度、目标数量、变量链等控制难度，而非单一固定难度集。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "生成代码及任务配置公开，可重新合成；需保存随机种子和配置以复现。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "任务准确率/目标召回，任务平均与按长度汇总的指标；以所用脚本定义为准。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "按任务要求比较模型回答中的目标答案，再汇总任务与长度。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "原论文使用 greedy decoding、模型聊天模板与答案前缀；需记录 tokenizer、模板及长度设定。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-07"
        }
      ]
    },
