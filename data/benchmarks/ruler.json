  "design_goals": {
    "capabilities": {
      "value": "检验模型实际可用上下文长度，而不只看标称窗口。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "单一 needle-in-a-haystack 容易被模型攻克，不能代表长上下文中的多跳追踪、聚合与问答。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "程序合成检索、多跳变量追踪、聚合与问答任务，可配置长度及复杂度。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "研究团队设计可控生成器，不是人工逐题知识考试。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "生成器根据任务规则产生可验证标准答案；精确人工逐条审查量待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "分任务及长度评测，以多种任务避免只测一种检索模式。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
