  "design_goals": {
    "capabilities": {
      "value": "检验模型实际可用上下文长度，而不只看标称窗口。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "单一 needle-in-a-haystack 容易被模型攻克，不能代表长上下文中的多跳追踪、聚合与问答。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "程序合成检索、多跳变量追踪、聚合与问答任务，可配置长度及复杂度。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "研究团队设计可控生成器，不是人工逐题知识考试。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "生成器根据任务规则产生可验证标准答案；精确人工逐条审查量待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "分任务及长度评测，以多种任务避免只测一种检索模式。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "检索、变量追踪与聚合样本由可控生成器及随机种子合成；问答使用SQuAD/HotpotQA、部分检索背景使用Paul Graham公开文章。新随机实例降低逐题记忆捷径，但公开问答来源不能保证训练无暴露。",
      "sources": [
        {
          "url": "https://github.com/hsiehjackson/RULER",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/pdf/2404.06654",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "4类任务、13种已评测配置；样本可依随机种子、序列长度和任务复杂度生成，不是固定总题量。",
      "sources": [
        {
          "url": "https://github.com/hsiehjackson/RULER",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "合成检索、变量追踪、聚合与问答",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-08"
        }
      ]
    },
    "modalities": {
      "value": "文本",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-08"
        }
      ]
    },
    "languages": {
      "value": "英语任务模板；具体语料配置应固定",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-08"
        }
      ]
    },
    "difficulty": {
      "value": "通过长度、目标数量、变量链等控制难度，而非单一固定难度集。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-08"
        }
      ]
    },
    "public_hidden_split": {
      "value": "生成代码及任务配置公开，可重新合成；需保存随机种子和配置以复现。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "任务准确率/目标召回，任务平均与按长度汇总的指标；以所用脚本定义为准。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-08"
        }
      ]
    },
    "scoring": {
      "value": "按任务要求比较模型回答中的目标答案，再汇总任务与长度。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-08"
        }
      ]
    },
    "prompt_settings": {
      "value": "原论文使用 greedy decoding、模型聊天模板与答案前缀；需记录 tokenizer、模板及长度设定。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-08"
        }
      ]
    },
    "official_scripts": {
      "value": "原始pipeline已deprecated；v1使用NVIDIA/RULER rulerv1-ns，v2使用rulerv2-ns及NeMo-Skills chsieh/ruler2；v2示例temperature=0、tokens_to_generate=16384。",
      "sources": [
        {
          "url": "https://github.com/hsiehjackson/RULER",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://github.com/NVIDIA/RULER/tree/rulerv2-ns",
          "accessed": "2026-11-08"
        }
      ]
    },
    "comparability_warning": {
      "value": "不同 token 长度、任务子集、分词器和长度加权分数不能混比；Hunyuan报告的 QA 子任务不是13任务全量。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2404.06654",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
