  "design_goals": {
    "capabilities": {
      "value": "衡量人类能力边缘的软件工程能力，涵盖AI研究实现、优化、科学计算及视觉推理。",
      "sources": [
        {
          "url": "https://www.frontierswe.com/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "面向20小时级工程与科研，修正v1模型过早提交、共享主机计时噪声及测试器可篡改等问题；测量固定长时间预算内最终实现的功能和性能。",
      "sources": [
        {
          "url": "https://www.frontierswe.com/blog/v2",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "v2新增21项并退役4项v1任务，总计34项；来自编译器重写、数据库兼容、GPU推理优化、天气预测、MEG解码等真实技术场景。",
      "sources": [
        {
          "url": "https://www.frontierswe.com/blog/v2",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://github.com/Proximal-Labs/frontier-swe-v2",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "Proximal核心工程团队与外部贡献者；Kondra、Mhatre和Kumar列为共同负责人，具体个人履历不作推断。",
      "sources": [
        {
          "url": "https://www.frontierswe.com/blog/v2",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "全部任务重新QA；提供与最终评分单调相关的self-check反馈；运行后评审面板检查完整轨迹、标记可疑行为，确认违规试次清零。",
      "sources": [
        {
          "url": "https://www.frontierswe.com/blog/v2",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "固定镜像、代理与干净验证器双容器隔离、非root执行及root私有评分资产；实现任务采用结构变异测试，性能任务改用固定微架构加权指令数以提高可复现性。",
      "sources": [
        {
          "url": "https://www.frontierswe.com/blog/v2",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "防作弊措施包括隐藏变体、独立验证器及轨迹审查；任务内容公开，这些防作弊措施不构成预训练去污染证明，训练污染程度待核实。",
      "sources": [
        {
          "url": "https://www.frontierswe.com/blog/v2",
          "accessed": "2026-11-07"
        }
      ],
      "status": "待核实"
    }
  },
