  "evaluation": {
    "metrics": {
      "value": "总体 Pass@1（三次运行平均）、Pass@3、确定性通过率与公式(1)的加权得分。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2611.06910",
          "accessed": "2026-11-09"
        }
      ]
    },
    "scoring": {
      "value": "确定性校验器检查数值结果；评审智能体（GPT-5.6 Sol xhigh，运行于 Codex CLI）按出题人编写的评分细则打分；未通过校验器或任一阻断项则记0分。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2611.06910",
          "accessed": "2026-11-09"
        }
      ]
    },
    "prompt_settings": {
      "value": "各模型用最高可用推理强度，每题运行3次，单次上限10小时；GPT 用 Codex CLI，Claude 用 Claude Code，Grok 用 Grok Build，Gemini 用 Antigravity，其余模型用 Claude Code。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2611.06910",
          "accessed": "2026-11-09"
        }
      ]
    },
