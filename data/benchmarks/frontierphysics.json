  "design_goals": {
    "capabilities": {
      "value": "评测智能体能否端到端完成理论、计算与实验物理研究：检索文献、制定研究计划、开展研究与实验，并产出结构化结果和科研论文。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.06910",
          "accessed": "2026-11-09"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "作者指出，现有物理基准多为固定问题、孤立子任务或给定答案的论文复现，很少同时检查研究质量与结果正确性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.06910",
          "accessed": "2026-11-09"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "42位物理研究者依据本人亲自完成的研究项目出题；182份投稿中录用56题。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2611.06910",
          "accessed": "2026-11-09"
        }
      ]
    },
    "author_background": {
      "value": "出题人包括博士生、博士后与研究科学家，来自26个机构；论文称每位出题人平均被引420次。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2611.06910",
          "accessed": "2026-11-09"
        }
      ]
    },
    "review_process": {
      "value": "三道审核：真实性与来源审查、相近领域专家同行评审、由六位物理学博士组成的管理团队终审。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2611.06910",
          "accessed": "2026-11-09"
        }
      ]
    },
    "quality_control": {
      "value": "出题人须用当前最强智能体本地运行至少三次并做失败模式分析；团队人工复核 GPT-6 Astra 的168次运行，发现9次误判失败并据此修订任务。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2611.06910",
          "accessed": "2026-11-09"
        }
      ]
    },
    "decontamination": {
      "value": "任务不向智能体提供原论文；是否设置文献截止时间及其他去污染措施待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2611.06910",
          "accessed": "2026-11-09"
        }
      ],
      "status": "待核实"
    }
  },
