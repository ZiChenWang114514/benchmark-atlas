  "construction": {
    "question_sources": {
      "value": "从13个音频语料出发，优先真实录音；专家将初选90任务筛至27任务，编写问题答案，经独立专家筛查，再扩增干扰选项并复审。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2410.19168",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://sakshi113.github.io/mmau_homepage/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "语音、声音、音乐领域专家，作者协助筛选音频与迭代设计。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2410.19168",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "不同专家团队剔除歧义、过度复杂及音质差的问答；2025年版本更新进一步修订问题答案和部分音频。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2410.19168",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/Sakshi113/MMAU/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "v05.15.25按社区反馈修订约25%问答、改善约5%音频；原论文C.3要求音频不损坏、英语问句、task/difficulty/dataset标签、仅保留MCQ。版权指南要求排除禁止复制和再分发的网站素材。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/Sakshi113/MMAU/main/README.md",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/pdf/2410.19168",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "test答案和解释不公开，通过HF Space计算分数；公开音频原料仍可能与训练语料重叠，不能宣称无污染。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/Sakshi113/MMAU/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    }
