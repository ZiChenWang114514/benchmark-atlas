  "construction": {
    "question_sources": {
      "value": "从科研文献全文/补充材料/图表、数据库、已发表实验协议及DNA/RNA/蛋白序列与克隆流程构建；部分图表题先用模型生成候选题，再由专家纠正或改写，不能统称全部专家原创。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2407.10362",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "作者及合同生物学专家人工制作LitQA2、SuppQA、FigQA、TableQA、ProtocolQA和CloningScenarios；SeqQA和DbQA主要程序生成。另请PhD级生物研究者建立人类基线。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2407.10362",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "人工及程序生成分路；对FigQA/TableQA的候选模型题由专家纠错/改写；手工检查干扰选项。论文还以开放式作答复核选择题高分是否来自排除式猜测。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2407.10362",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "不同子任务分别核查源文、参考答案及干扰项；论文明确指出差干扰项可造成虚高，另做开放回答核验。仓库2025-02-14更正Cloning/SeqQA限制酶问题。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2407.10362",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://github.com/Future-House/LAB-Bench/blob/main/CHANGELOG.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "保留 20% 私有子集；公开数据内加入官方 canary 字符串以帮助模型训练前过滤。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/Future-House/LAB-Bench/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
