  "design_goals": {
    "capabilities": {
      "value": "考查编码智能体能否在同一代码库上连续完成5至15个相互依赖的工程请求，每一步都从智能体此前写出的代码出发，早期的设计决策与错误会向后传递",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.07166",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://multistepswe.com/",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://github.com/Klavis-AI/Multi-step-SWE",
          "accessed": "2026-11-12"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文指出，无论 SWE-bench 式单一问题修复，还是 Terminal-Bench、DeepSWE、FrontierSWE、ProgramBench 等更长的任务，都是一次性评分的单回合任务，不要求智能体在自己先前的工作上持续构建",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.07166",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://multistepswe.com/",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://github.com/Klavis-AI/Multi-step-SWE",
          "accessed": "2026-11-12"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "每一步都以已有的权威依据为基础，例如规范、上游版本发布历史、协议修订、框架迁移路径和手工优化内核，同一依据同时定义指令与验证器；任务既有从零构建，也有基于真实开源代码库的工作",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.07166",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://multistepswe.com/",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://github.com/Klavis-AI/Multi-step-SWE",
          "accessed": "2026-11-12"
        }
      ]
    },
    "author_background": {
      "value": "作者均来自 Klavis AI；任务由至少具有五年经验的专业软件工程师审阅",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.07166",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://multistepswe.com/",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://github.com/Klavis-AI/Multi-step-SWE",
          "accessed": "2026-11-12"
        }
      ]
    },
    "review_process": {
      "value": "每项任务经过两轮专家审阅：初审检查设计、每步是否构成真实进展以及时间预算是否合适；终审逐一对照指令与验证器，确认验证器无法在未完成工作时通过，问题修正后需再次审阅",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.07166",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://multistepswe.com/",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://github.com/Klavis-AI/Multi-step-SWE",
          "accessed": "2026-11-12"
        }
      ]
    },
    "quality_control": {
      "value": "每步在独立验证器容器中评分，隐藏测试与公开检查不同；开发中对验证器做对抗性加固，每个成功的攻击都会新增检查；构建失败、测试数量不足或评分超时均记零分",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.07166",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://multistepswe.com/",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://github.com/Klavis-AI/Multi-step-SWE",
          "accessed": "2026-11-12"
        }
      ]
    },
    "decontamination": {
      "value": "论文承认任务源自公开项目，无法排除记忆；多数任务（56项）在作答时仅允许访问模型 API，版本升级任务还使用修改过期望输出的一致性测试，优化任务在评分时生成新输入",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.07166",
          "accessed": "2026-11-12"
        },
        {
          "url": "https://multistepswe.com/",
