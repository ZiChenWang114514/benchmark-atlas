  "construction": {
    "question_sources": {
      "value": "多学科大学生及共同作者从考试、测验、教材、讲义和在线资源人工收集问题；必要时依据专业知识编写题目。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2311.16502",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://mmmu-benchmark.github.io/",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "论文收集阶段由50名不同学科大学生（含共同作者）参与；人类表现评测另用90名对应学科学生专家，每学科3人；两批人数含义不同。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2311.16502",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "使用图像散列和文本相似性筛查疑似重复，由作者复查；再交叉检查格式、拼写和答案质量。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2311.16502",
