  "design_goals": {
    "capabilities": {
      "value": "基因组学与定量生物学的长程端到端分析：规划、质控、建模与校正，得到决策相关答案。",
      "sources": [
        {
          "url": "https://openai.com/index/introducing-new-capabilities-to-gpt-rosalind/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "不只测生物知识检索、常规分析流水线或孤立步骤，而测能否依据诊断信号更新estimand、质控与模型选择，并把变化传递到最终决策。",
      "sources": [
        {
          "url": "https://cdn.openai.com/pdf/6dc7175d-d9e7-4b8d-96b8-48fe5798cd5b/oai_genebench_benchmark.pdf",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://openai.com/index/introducing-genebench-pro/",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "纠正旧档“真实科学数据”概括：基于文献与内部专家归纳现实分析模式，但GeneBench及Pro采用构造性模拟数据，控制完整因果/生成过程以得到可识别数值答案；不是直接复用历史真实队列。",
      "sources": [
        {
          "url": "https://cdn.openai.com/pdf/6dc7175d-d9e7-4b8d-96b8-48fe5798cd5b/oai_genebench_benchmark.pdf",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://openai.com/index/introducing-genebench-pro/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "GeneBench由Jeremy Li（OpenAI/Herasight）与Andrew Ho（OpenAI）署名；Pro审核者包括研究生、博士后、产业科学家及教授。",
      "sources": [
        {
          "url": "https://cdn.openai.com/pdf/6dc7175d-d9e7-4b8d-96b8-48fe5798cd5b/oai_genebench_benchmark.pdf",
