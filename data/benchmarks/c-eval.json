  "design_goals": {
    "capabilities": {
      "value": "衡量基础模型对中文环境中多层次、多学科知识的理解及推理。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2305.08322",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "英语中心评测不足以代表中文教育与专业知识掌握；翻译英语题也不能覆盖中文课程背景。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2305.08322",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "模拟和地方考试的 PDF/Word、部分大学期末题，以及约 2,000 道获授权的维普题目。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2305.08322",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "作者组织学科相关学生与研究者搜集、编辑并核验中文考试题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2305.08322",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "文档解析、人工修正格式与 LaTeX，作者交叉验证题干及答案。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2305.08322",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "去重并检查格式，尽量避开可能泄漏的全国统一考试题；不等于能保证模型训练无污染。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2305.08322",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "通过题源选择规避部分流行公开试题，并去重；没有证据能保证所有被测模型训练语料完全不含这些题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2305.08322",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
