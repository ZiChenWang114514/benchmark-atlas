  "design_goals": {
    "capabilities": {
      "value": "专业图表视觉感知、领域解释与多步图形推理，涵盖生存曲线、等高线、Sankey、Bode与金融图形。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.10677",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "此前图表集多偏柱、线、饼图与短链推理，难衡量真实专业决策中的读图。",
      "sources": [
        {
