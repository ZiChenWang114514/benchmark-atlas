  "design_goals": {
    "capabilities": {
      "value": "专业图表视觉感知、领域解释与多步图形推理，涵盖生存曲线、等高线、Sankey、Bode与金融图形。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.10677",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "此前图表集多偏柱、线、饼图与短链推理，难衡量真实专业决策中的读图。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.10677",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "81张线上来源图、19张专家创建图；问题由对应领域从业者撰写。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.10677",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "临床、工程、科学和金融领域专业人士。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.10677",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "每题由另外3名领域专家独立复核，验证答案、措辞及可接受范围。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.10677",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "两轮pilot改进出题规范；仅保留至少令一种前沿模型出现有意义失败的题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.10677",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "发布全部任务与图像、来源元数据；公开标签长期存在污染风险，未宣称隐藏测试。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.10677",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
