          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "代码生成；记录包括content、canonical_solution、id、labels，以及test.asset/test.code；labels含category、difficulty、programming_language、execution_language、fewshot、is_lctx、locale。",
      "sources": [
        {
          "url": "https://huggingface.co/datasets/ByteDance/FullStackBench/raw/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
