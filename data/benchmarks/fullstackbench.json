  "design_goals": {
    "capabilities": {
      "value": "跨语言、跨应用领域的实际代码开发与库使用能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00535",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "简单算法题及从 Python 翻译的多语言题不能充分覆盖全栈场景、外部依赖和真实开发复杂性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00535",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "从GitHub、代码文档/书籍和XLCoST采样代码，再由LLM与人工生成指令、测试和参考解；另邀请各领域编程人员（含内部数据工程团队）撰写领域题目。领域配比参考50万条StackOverflow问题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00535",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "ByteDance 代码模型与执行沙箱研究团队。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00535",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "每条按难度、歧义和可解性审核，标注者交换数据交叉修订；分歧通过共识或高级标注员裁决。六模型投票辅助难度划分与样本筛选。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00535",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "每题配参考代码与可执行单测；论文共15,168测试、平均4.5/题，并覆盖不同错误类型。以SandboxFusion固定语言及依赖环境运行。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00535",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://github.com/bytedance/FullStackBench",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "待核实",
      "sources": [
