    }
  },
  "data_format": {
    "size": {
      "value": "论文v6口径为3,374问题、15,168单测；当前HF en/test与zh/test各1,687行（3,374语言配置行）。保留论文与现发数据两种口径，不把相加行数断言为3,374个互异原题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2412.00535",
          "accessed": "2026-11-07"
        },
