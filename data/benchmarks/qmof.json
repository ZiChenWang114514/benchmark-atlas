  "design_goals": {
    "capabilities": {
      "value": "从MOF结构预测量子化学性质，本文收录的明确评测任务为固定划分的带隙回归，而非把数据库当统一Agent基准。",
      "sources": [
        {
          "url": "https://github.com/Andrew-S-Rosen/QMOF",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/html/2609.19487v1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "大规模MOF电子结构DFT成本高，需图模型代理进行材料筛选；不同DFT泛函应分开评估。",
      "sources": [
        {
          "url": "https://www.nature.com/articles/s41524-022-00796-6",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "实验MOF/配位聚合物结构经高通量周期DFT计算产生性质标签；无自然语言命题。",
      "sources": [
        {
          "url": "https://github.com/Andrew-S-Rosen/QMOF",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://www.nature.com/articles/s41524-022-00796-6",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "量子化学、MOF、DFT及图神经网络研究者合作；2022作者机构含Berkeley/LBNL、Northwestern、ORNL、Minnesota。",
      "sources": [
        {
          "url": "https://www.nature.com/articles/s41524-022-00796-6",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "统一DFT工作流、结构及电子态分析；不是专家逐题审阅考试题。",
      "sources": [
        {
          "url": "https://www.nature.com/articles/s41524-022-00796-6",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "v9使用pymatgen StructureMatcher移除重复结构并修正186个EDIFF设置；v12移除带错误键合/缺氢问题的部分结构。属于版本化清理，不代表数据无误。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/arosen93/QMOF/main/updates.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "H2固定train/val/test评估预测误差；结构重叠与多保真泄漏需单独审计。2022多保真允许同结构不同泛函跨划分，不同于结构外推。",
      "sources": [
        {
          "url": "https://www.nature.com/articles/s41524-022-00796-6",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/html/2609.19487v1",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "官方当前概述20,000+结构；H2固定带隙任务16,340训练、2,042验证、2,042测试。初版规模与后续数据库版不同，不能混用。",
      "sources": [
        {
          "url": "https://github.com/Andrew-S-Rosen/QMOF",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/html/2609.19487v1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "结构→带隙连续值回归；数据库也含其他量子化学性质，但未逐属性拆成独立条目。",
      "sources": [
        {
          "url": "https://github.com/Andrew-S-Rosen/QMOF",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/html/2609.19487v1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "MOF/配位聚合物原子结构及周期DFT量化学性质；官方FAQ明确不提供轨迹。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/Andrew-S-Rosen/QMOF/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "数值及结构数据；英语说明，无自然语言考试语言。",
      "sources": [
        {
          "url": "https://github.com/Andrew-S-Rosen/QMOF",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "电子开壳层过渡金属与不同泛函的带隙差异较难；并无统一题目难度标签。",
      "sources": [
        {
          "url": "https://www.nature.com/articles/s41524-022-00796-6",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "数据公开；H2 16340/2042/2042固定划分，2022原论文则80/5/15随机划分，两种协议不同。",
      "sources": [
        {
          "url": "https://www.nature.com/articles/s41524-022-00796-6",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/html/2609.19487v1",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "带隙MAE，单位eV，越低越好；报告对应DFT层级。",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.19487v1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "对测试结构预测带隙与DFT参考值计算绝对误差平均。",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.19487v1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "不是LLM问答提示。ALIGNN 2.0论文Table 2在JARVIS协议下比较固定16340/2042/2042划分；0.202 eV来自improved训练设置，radius消融为0.208 eV，不能统称未改动的base kNN。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2609.19487",
          "accessed": "2026-11-08"
        }
      ]
    },
    "official_scripts": {
      "value": "https://github.com/Andrew-S-Rosen/QMOF",
