    },
    "difficulty": {
      "value": "旨在测未见约束泛化，不以IFEval得分推断能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "IFBench评测300提示；IFTrain 29约束与训练提示为独立材料，不混成测试规模。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "strict/loose accuracy；论文报告prompt-level loose accuracy，AA采用规则评分pass@1。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "strict直接验证，loose允许删首末行和部分字体标记后再检验；题级与约束级口径不可混用。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "原论文通常temperature 0，思考模型调整token并移除思维链；DeepSeek R1用0.6/top_p .95，o3温度1。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "AllenAI/IFBench含约束验证代码；本轮GitHub页仅返回摘要，不据此填许可证。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "AA 294题×5次不同于原始300提示；单/多轮与strict/loose差异须保留。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
