  "design_goals": {
    "capabilities": {
      "value": "对58种新颖可程序验证的域外输出约束泛化，包括计数、比例、单词、句子、格式、自定义与复制。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "IFEval的25种约束可能被过拟合；IFBench不是IFEval别名或新版本。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "人工收集用户反馈及核心技能需求设计约束，组合未发布的WildChat留出提示。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "指令遵循与后训练研究者；兼容性标注者具体资历待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "每实例人工检查提示与约束兼容，防止无法同时满足。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "为约束编写Python验证函数；排除训练/测试约束重合。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "测试58种新约束与IFTrain 29种训练约束分开，原始WildChat提示留出；公开后仍需防泄漏。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "原始IFBench 300提示，每个含1或2约束；AA评294题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "开放文本输出，单轮任务+约束；多轮先回答原任务后按约束改写。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": [
        "文本"
      ],
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "测试提示以英语为主，含要求日语、俄语等特定输出的约束；不能把输出语种约束误作所有题目单语声明。",
      "sources": [
        {
          "url": "https://huggingface.co/datasets/allenai/IFBench_test",
          "accessed": "2026-11-08"
        }
      ]
    },
    "difficulty": {
      "value": "旨在测未见约束泛化，不以IFEval得分推断能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "IFBench评测300提示；IFTrain 29约束与训练提示为独立材料，不混成测试规模。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "strict/loose accuracy；论文报告prompt-level loose accuracy，AA采用规则评分pass@1。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "strict直接验证，loose允许删首末行和部分字体标记后再检验；题级与约束级口径不可混用。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "原论文通常temperature 0，思考模型调整token并移除思维链；DeepSeek R1用0.6/top_p.95，o3温度1。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "当前ifbench包可通过pip安装，命名空间ifbench.instructions、instructions_registry等；wheel含test JSONL，用ifbench.data_path访问。原论文主指标prompt-level loose accuracy。",
      "sources": [
        {
          "url": "https://github.com/allenai/IFBench/blob/main/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "comparability_warning": {
      "value": "AA 294题×5次不同于原始300提示；单/多轮与strict/loose差异须保留。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
