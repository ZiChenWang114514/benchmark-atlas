  "design_goals": {
    "capabilities": {
      "value": "对58种新颖可程序验证的域外输出约束泛化，包括计数、比例、单词、句子、格式、自定义与复制。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "IFEval的25种约束可能被过拟合；IFBench不是IFEval别名或新版本。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "人工收集用户反馈及核心技能需求设计约束，组合未发布的WildChat留出提示。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "指令遵循与后训练研究者；兼容性标注者具体资历待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "每实例人工检查提示与约束兼容，防止无法同时满足。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "为约束编写Python验证函数；排除训练/测试约束重合。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "测试58种新约束与IFTrain 29种训练约束分开，原始WildChat提示留出；公开后仍需防泄漏。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "原始IFBench 300提示，每个含1或2约束；AA评294题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "开放文本输出，单轮任务+约束；多轮先回答原任务后按约束改写。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": [
        "文本"
      ],
      "sources": [
        {
          "url": "https://arxiv.org/abs/2507.02833",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "待核实",
      "sources": [
        {
          "url": "https://github.com/allenai/IFBench",
          "accessed": "2026-11-07"
