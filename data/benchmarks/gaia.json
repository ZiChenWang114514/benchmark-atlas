        {
          "url": "https://arxiv.org/abs/2311.12983",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "短答案的开放问题，可能需网页、文件、视觉和计算。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2311.12983",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": [
        "文本",
