  "design_goals": {
    "capabilities": {
      "value": "现实信息查找、多模态理解、网页访问、工具与多步推理结合的通用助理能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2311.12983",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "人类容易完成但需要组合工具的任务，可能比孤立专业知识题更能揭示助理系统不足。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2311.12983",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "人工设计可验证现实问题，答案通常短且明确，部分含附件。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2311.12983",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "研究作者与经付费招募的 Surge AI 标注者；不把所有出题人称专家。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2311.12983",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "创建者之外两名独立验证者复核，不一致时修改或丢弃。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2311.12983",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "力求唯一/稳定答案、可由人完成；按推理步数与工具复杂度设三档。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2311.12983",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "避免答案可直接在网上纯文本检索到，隐藏测试答案；问题公开后仍可能进入后续训练。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2311.12983",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "466道人工问题；166道development公开答案，300道test答案隐藏。",
