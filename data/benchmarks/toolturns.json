  "design_goals": {
    "capabilities": {
      "value": "考查工具智能体在对话中澄清故意不完整的初始请求、调用工具，并在两次依赖上下文的后续请求中保持对话记忆与任务完成能力。每道题提供固定的可调用端点子集（平均 26.5 个），用户模拟器依据隐瞒上下文回答澄清，并基于对用户可见的对话生成后续请求。评测沿智能体自身轨迹分别报告请求级任务成功与整段对话完成，以及五项对话质量量表。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.14925",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://arxiv.org/pdf/2611.14925.pdf",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://github.com/milad621/ToolTurns",
          "accessed": "2026-11-14"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文认为，现有大规模工具使用基准多关注孤立请求。ToolBench 等提供了宽口径接口覆盖，但不是自适应多轮用户对话；交互式基准如 tau-bench 与 ToolSandbox 则主要在有状态的应用环境中评测。本文针对的是宽口径接口覆盖与自适应、端到端对话评测的结合：智能体能否在多样工具集上澄清不完整请求，并完成与之相关的后续请求。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.14925",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://arxiv.org/pdf/2611.14925.pdf",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://github.com/milad621/ToolTurns",
          "accessed": "2026-11-14"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "工具目录来自随 ToolBench 发布的 RapidAPI 集合，执行环境为基于 StableToolBench 的缓存或大模型模拟层。题目由 ToolBench 的三类检索组抽样工具集并扩展该工具的全部端点后，用 GPT-4o-mini 按固定模板生成故意省略关键细节的查询及二至四个上下文关键词。初始查询与隐瞒上下文均由模型生成，而非人工撰写。官方仓库中的完整评测输入为 2,620 条记录的 final_queries_march_27_2026.json。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2611.14925",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://arxiv.org/pdf/2611.14925.pdf",
          "accessed": "2026-11-14"
        },
        {
          "url": "https://github.com/milad621/ToolTurns",
          "accessed": "2026-11-14"
        }
      ]
    },
    "author_background": {
      "value": "三位作者的论文与引用文件所列单位均为加州大学圣克鲁斯分校。其余个人履历待核实。",
