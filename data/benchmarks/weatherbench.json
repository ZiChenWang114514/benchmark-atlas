  "design_goals": {
    "capabilities": {
      "value": "统一数据驱动中期全球天气预报的数据与评测标准。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2002.00469",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/pdf/2002.00469",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "早期数据驱动天气预测使用各自的输入变量、网格、预报时效和评测数据，难直接横比。该项目把ERA5预处理、同网格验证和线性/CNN/物理模式基线合在同一可复现流程。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2002.00469",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "ERA5 再分析月度归档经下载及重网格处理；IFS 基线来自 TIGGE；另提供 MPI-ESM-HR CMIP 历史模拟。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/pangeo-data/WeatherBench/master/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "由气象、计算机科学与物理模拟研究者构建数值数据处理流程：作者署名涉及TUM、ECMWF、斯德哥尔摩大学气象/Bolin中心、华盛顿大学大气科学与多伦多大学计算机科学。并无自然语言出题人。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2002.00469",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "从 ERA5 再分析资料加工数据，并提供线性、深度学习和物理模型基线。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2002.00469",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/pdf/2002.00469",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "Snakemake管理月度ERA5下载、xESMF双线性重网格及变量/年份文件；统一5.625°评测，提供物理模式基线。论文提醒再分析不是直接观测，降水尤其存在质量限制。README与论文的容量/分辨率写法有差异，须按具体数据文件确认。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2002.00469",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://raw.githubusercontent.com/pangeo-data/WeatherBench/master/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "按连续年份隔离：最终测试2017–2018；训练期不晚于2016，论文以2016作验证。首个测试验证时刻应为2017年起始加预报时效，防止输入/目标时间跨界；不能随机拆分高度相关的天气时序。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2002.00469",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "ERA5 1979–2018逐小时资料，三种目标网格：5.625°（32×64）、2.8125°（64×128）、1.40625°（128×256）；高空场13压力层。README称5.625°整包175G，论文v3称191GB，且将最细网格误写成1.40525°，均不擅自统一。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2002.00469",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://raw.githubusercontent.com/pangeo-data/WeatherBench/master/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "question_types": {
      "value": "输入历史/当前气象场，预测未来全球气象场；主验证量Z500（500 hPa位势）与T850（850 hPa温度），并提供T2M、降水及更多变量。不是选择题或自然语言问答。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2002.00469",
          "accessed": "2026-11-08"
        }
      ]
    },
    "modalities": {
      "value": "数值气象时空场（不是自然语言选择题）；预测采用 NetCDF，维度 init_time、lead_time、lat、lon。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/pangeo-data/WeatherBench/master/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "languages": {
      "value": "不适用：核心数据是有物理单位与时空坐标的数值气象场；变量名/文档使用英文，不构成自然语言测试集。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2002.00469",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://raw.githubusercontent.com/pangeo-data/WeatherBench/master/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "difficulty": {
      "value": "按预报提前期和变量区分；主基线报告3天/5天Z500与T850。不存在与LLM题库相同的简单/困难标签，长时效受误差增长及可预报性限制。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2002.00469",
          "accessed": "2026-11-08"
        }
      ]
    },
    "public_hidden_split": {
      "value": "公开ERA5加工数据1979–2018；最终测试2017–2018，建议从1979–2016选连续验证段，论文选择2016。训练不得使用验证/测试目标；没有把公开测试当隐藏试题。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2002.00469",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "Z500 RMSE（m²/s²）、T850 RMSE（K），报告3天及5天预报；需对齐网格、初值和时效。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/pangeo-data/WeatherBench/master/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "scoring": {
      "value": "纬度权重为cos(lat)/mean(cos(lat))。当前score.py默认在所有维度平均加权平方误差后开方；论文式(2)则写成先逐预报空间RMSE再对预报平均。两者聚合次序不同，复现必须固定代码版本、mean_dims与时间平均顺序；不擅自视为等价。另有ACC/MAE。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2002.00469",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://raw.githubusercontent.com/pangeo-data/WeatherBench/master/src/score.py",
          "accessed": "2026-11-08"
        }
      ]
    },
    "prompt_settings": {
      "value": "不适用LLM提示：提交NetCDF预测，维度init_time、lead_time、lat、lon；计分前按验证时刻对齐，预测网格下采样到5.625°。必须披露输入变量、历史窗口、直接/迭代预测及预训练数据。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2002.00469",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://raw.githubusercontent.com/pangeo-data/WeatherBench/master/README.md",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://raw.githubusercontent.com/pangeo-data/WeatherBench/master/src/score.py",
          "accessed": "2026-11-08"
        }
      ]
    },
    "official_scripts": {
      "value": "https://github.com/pangeo-data/WeatherBench/blob/master/src/score.py",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/pangeo-data/WeatherBench/master/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "comparability_warning": {
      "value": "3/5天、Z500/T850、网格分辨率及直接/迭代预测分开；Z500是位势m²/s²，不是位势高度m。README历史表含物理模式/CMIP预训练模型，不能当统一架构排名。论文RMSE式与当前score.py时间聚合次序也应固定。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2002.00469",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://raw.githubusercontent.com/pangeo-data/WeatherBench/master/README.md",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://raw.githubusercontent.com/pangeo-data/WeatherBench/master/src/score.py",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
