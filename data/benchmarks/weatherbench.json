  "data_format": {
    "size": {
      "value": "三种网格分辨率 1.40625°、2.8125°、5.625°；5.625° 整套下载约175G（README 标法）。不把存储容量当样本数量。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/pangeo-data/WeatherBench/master/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "全球天气时空场；具体分辨率、变量和划分须按版本核实。",
