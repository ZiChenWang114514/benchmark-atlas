  "design_goals": {
    "capabilities": {
      "value": "评估含糊双用途化学情境中的技术帮助、人类能力增益、风险识别与严重性判断，而非仅测显式有害请求拒答。",
      "sources": [
        {
          "url": "https://cdn.sanity.io/files/50zba0eo/production/740e74ec297aa119d37b87d4706540e322551ba0.pdf",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "相同正确化学知识可能用于正当科研或被滥用；一般能力与显式有害请求安全测验未覆盖这种歧义。",
      "sources": [
        {
          "url": "https://cdn.sanity.io/files/50zba0eo/production/740e74ec297aa119d37b87d4706540e322551ba0.pdf",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "专家为真实实验场景原创题目，并写良性/有害用例及1–5严重性评分；不靠合成或显式对抗提示构题。",
      "sources": [
        {
          "url": "https://cdn.sanity.io/files/50zba0eo/production/740e74ec297aa119d37b87d4706540e322551ba0.pdf",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "130名化学专家：19名学士、53名硕士、58名博士；题目经博士级reviewer复核，再经LLM质检，失败项返最高层博士审核。不能误写全部作者均为博士。",
      "sources": [
        {
          "url": "https://cdn.sanity.io/files/50zba0eo/production/740e74ec297aa119d37b87d4706540e322551ba0.pdf",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "每题附良性/有害用途及各自1–5严重度；博士审科学准确性、清晰性和风险边界，LLM检查后有问题再交资深化学博士修订。",
      "sources": [
        {
          "url": "https://cdn.sanity.io/files/50zba0eo/production/740e74ec297aa119d37b87d4706540e322551ba0.pdf",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "博士级化学专家审核准确性、清晰度及安全性；不合格题修订或拒绝；之后模型质检及高阶博士复核。",
      "sources": [
        {
          "url": "https://cdn.sanity.io/files/50zba0eo/production/740e74ec297aa119d37b87d4706540e322551ba0.pdf",
          "accessed": "2026-11-07"
        }
      ]
