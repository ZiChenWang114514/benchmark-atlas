  "design_goals": {
    "capabilities": {
      "value": "从单细胞组学数据到细胞注释与研究结论重现，评估AI scientist。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08341",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "一般问答/代码生成无法确认代理能在真实组学数据上重现生物发现。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08341",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "公开单细胞研究与CellxGene h5ad；BAIS-SD来自41项研究的已发表结论。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08341",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "生物信息专家注释与研究生人类参考；六名生物信息研究生参与对比。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08341",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "专家标注细胞类型层级；GPT-4o辅助从论文结论拟题，人工纠正和实验核查。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08341",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "数据统一h5ad；用uHAF对齐细胞类型层级，精确或更细后代类型给全分。官方Task1提供映射与评分实现，Task2提供题目及reference answer。人工基线由6位研究生分担完成，不是每人独立全套重复。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2505.08341",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/EperLuo/BAISBench/main/Task1.ipynb",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/EperLuo/BAISBench/main/Task2.ipynb",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "来源研究及结论公开，主要是rediscovery而非真正未知发现；需警惕靠论文记忆作答。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08341",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
