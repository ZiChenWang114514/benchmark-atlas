  "design_goals": {
    "capabilities": {
      "value": "从单细胞组学数据到细胞注释与研究结论重现，评估AI scientist。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08341",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "一般问答/代码生成无法确认代理能在真实组学数据上重现生物发现。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08341",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "公开单细胞研究与CellxGene h5ad；BAIS-SD来自41项研究的已发表结论。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08341",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "生物信息专家注释与研究生人类参考；六名生物信息研究生参与对比。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08341",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "专家标注细胞类型层级；GPT-4o辅助从论文结论拟题，人工纠正和实验核查。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08341",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "uHAF层级兼容评分与按题型评分；固定数据文件支持可复现分析。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08341",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "来源研究及结论公开，主要是rediscovery而非真正未知发现；需警惕靠论文记忆作答。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.08341",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
