  "design_goals": {
    "capabilities": {
      "value": "在基础科学考试题上测量超越检索与词语共现的知识整合和推理。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1803.05457",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "既有选择问答可能被信息检索或词汇统计解决，难以单独衡量更深推理。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1803.05457",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "收集3至9年级科学考试选择题；同时被检索和PMI基线答错的题进入Challenge。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1803.05457",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "原始考试命题者与AI2整理团队；不是全部由LLM合成。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1803.05457",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "对题目清理并以两个基线筛选；不含必须依赖图像才能回答的问题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1803.05457",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "保留多种科学学科和推理需求，原论文另给约1400万句科学语料供检索。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1803.05457",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "Easy/Challenge依据基线表现划分，不构成预训练语料隔离；考试题可能已在网络公开。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1803.05457",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "ARC-Challenge：train 1119、validation 299、test 1172，共2590题；不得用全ARC的7787题或ARC-Easy混替。",
      "sources": [
        {
          "url": "https://huggingface.co/datasets/allenai/ai2_arc/raw/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "文本科学选择题，多为4选项，部分3至5选项。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1803.05457",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "文本（数学符号按文本表达）；并非原始图像视频识别任务",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1803.05457",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语题面；形式化/数学符号另见模态与仓库格式",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1803.05457",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "Challenge仅表示被原检索与PMI模型筛掉的集合；不是固定的2026前沿难度。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1803.05457",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "公开训练、开发和测试题文件；现代常用测试1172题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1803.05457",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "答案准确率；原论文对并列预测允许1/k分数。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1803.05457",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "原始tie-credit与现代生成答案accuracy/对数似然acc_norm实现不同，必须保留评测器设置。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1803.05457",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "原论文包含检索与监督QA系统；LLM需要报告shot数、CoT、是否检索及似然长度归一化。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1803.05457",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "官方arc-solvers提供scripts/evaluate_solver.sh与scripts/evaluate_bidaf.sh；为历史检索/蕴含/阅读理解基线，不是现代LLM统一提示协议。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/allenai/arc-solvers/master/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "ARC-Challenge不是ARC-Easy、更不是视觉抽象推理ARC-AGI；1172题和合并3548题结果不可混排。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1803.05457",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/html/2610.11978v1",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
