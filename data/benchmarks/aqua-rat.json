  "design_goals": {
    "capabilities": {
      "value": "从代数文字题生成自然语言推理依据并选择答案，研究rationale对求解和解释的帮助。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1705.04146",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "只预测选项无法观察模型如何组织数学推理；原工作同时建模解释。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1705.04146",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "论文收集GRE/GMAT风格网络题种子并用众包扩展；官方README强调公开release为完整众包数据。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1705.04146",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "众包写题与写解释，研究团队开发rationale生成模型。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1705.04146",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "众包流程与去近重复过滤；公开发布版本与论文初始实验数据并非完全相同。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1705.04146",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "论文§2人工抽查众包任务并要求新题的答案/推理与seed不同；并不保证所有标签正确。HF公开预览存在推导与correct标签矛盾的个例，例如边长16的等边三角形题推导64√3、选项B却标D；仅作为样例错误，不估计整体错误率。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1705.04146",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://huggingface.co/datasets/deepmind/aqua_rat",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "编辑距离过滤针对近重复，不保证语义改写分离或后续LLM无污染。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1705.04146",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
