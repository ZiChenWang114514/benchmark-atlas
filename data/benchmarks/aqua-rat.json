      "sources": [
        {
          "url": "https://arxiv.org/abs/1705.04146",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "只预测选项无法观察模型如何组织数学推理；原工作同时建模解释。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1705.04146",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
