          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "CLI源/目标Python、Java、Kotlin、Rust、C++；另有COBOL→Java。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/code-migration-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "CLI完整仓库跨语言迁移；COBOL→Java覆盖文件格式、批处理、终端接口与持久状态。不等同函数级翻译，官方未给统一数值难度级别。",
      "sources": [
        {
