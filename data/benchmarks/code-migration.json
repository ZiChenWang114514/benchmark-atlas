  "design_goals": {
    "capabilities": {
      "value": "把完整可运行程序迁移到另一语言并忠实复现行为，含遗留COBOL现代化。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/code-migration-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "短代码翻译不能代表仓库级CLI迁移与有状态遗留业务系统。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/code-migration-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "CLI为30个开源仓库；COBOL为10仓库，混合开源程序与为本基准合成的业务系统。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/code-migration-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "Vals AI构建工程迁移基准；官方方法说明COBOL部分含为评测合成的业务系统，具体出题人员履历仍待核实。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/code-migration-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "隐藏行为测试评分前进行独立反作弊审查；核对目标语言并拒绝包装原程序、复制参考产物或硬编码预期输出。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/code-migration-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "隐藏行为测试前进行反作弊检查：禁止原程序包装、参考材料复制、硬编码输出，并检查目标语言。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/code-migration-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "隐藏行为测试不向模型公开；源仓库本身公开，不能保证预训练未见。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/code-migration-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "CLI 30源仓库各迁到另外4语言，共120迁移；COBOL→Java另10仓库。headline按40源仓库等权，不是按130任务简单等权。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/code-migration-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "提供源程序及指令，提交目标语言实现和Dockerfile。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/code-migration-v1-1",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
