  "design_goals": {
    "capabilities": {
      "value": "跨学科视觉理解、知识推理和图文整合；要求真正利用图片，而不只依赖选项或文本捷径。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.02813",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "原版 MMMU 的部分题目不看图也能答对，四选一又容许猜测。Pro通过过滤、扩展选项与纯视觉输入收紧评测。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.02813",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "从原版MMMU过滤纯文本模型可答题；四个文本模型各重复十次，筛去至少三个模型多数答对的题；抽取1,800题后经选项与图像相关性复核，保留1,730题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.02813",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "选项扩展及复核由领域专家参与；具体每人学历待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.02813",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "GPT-4o生成额外选项、Claude 3.5过滤，再经两轮人工复核；截图和照片由人工在不同显示背景、字体与字号下采集。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.02813",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "GPT-4o生成额外选项、Claude 3.5过滤，再经两轮人工复核；截图和照片由人工在不同显示背景、字体与字号下采集。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.02813",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "过滤纯文本捷径不能证明无训练污染；公开题集仍存在记忆风险。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.02813",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
