      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.03831",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "图像分类（含多标签）与像素语义分割各6项；检测/计数原任务已转换成分割，不是文本问答。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.03831",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "多光谱、SAR、高光谱、高程、云概率等地理栅格；传感器涵盖Sentinel-1/2、Landsat-8、航空RGB等，空间分辨率0.1至30 m/pixel。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.03831",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "不适用文本问答语言标签：输入为数值遥感影像，输出为类别或分割掩膜；任务元数据/文档使用英语。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.03831",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/ServiceNow/geo-bench/HEAD/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "没有统一题目难度等级；小样本迁移任务，论文同时比较全量和不同训练集规模。不得将容易的EuroSAT子任务代表全部12任务。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.03831",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "发布train/validation/test；尽可能保持原数据划分，否则生成验证及测试集并保证无空间重叠；精确各项数量见规模字段。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.03831",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "分类报告accuracy；分割报告IoU。跨任务先用官方基线最小/最大值线性归一化，再计算IQM并报告分层bootstrap置信区间；归一化结果可超过1。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.03831",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "建议每任务最多16次超参数试验，按验证集早停，所选配置至少10个随机种子；IQM裁掉最高/最低各25%，用1000次bootstrap估计不确定性。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.03831",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "非语言提示式测试；应固定微调或冻结encoder、输入band映射、归一化、分辨率与数据增强；论文建议90度旋转及水平/垂直翻转。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.03831",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/ServiceNow/geo-bench/HEAD/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "https://github.com/ServiceNow/geo-bench-experiments",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/ServiceNow/geo-bench/HEAD/README.md",
          "accessed": "2026-11-07"
        }
      ],
      "note": "README的实验复现入口；geobench负责下载/数据加载，torchgeo-bench为维护中的另一个harness。"
    },
    "comparability_warning": {
      "value": "不同数据版本、子集、提示、工具权限及模型快照不得直接混比；历史论文分数不代表当前SOTA。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2306.03831",
          "accessed": "2026-11-07"
