  "design_goals": {
    "capabilities": {
      "value": "比较面向地球监测的基础模型，提供比一般图像任务更贴合遥感应用的评估。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2306.03831",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/pdf/2306.03831",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/html/2306.03831v2/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "一般自然图像基准忽略遥感的多光谱、SAR、空间分辨率和少标签迁移条件；统一12项下游任务与报告协议，以检验预训练表征能否适应真实地球监测任务。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.03831",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "由领域专家整理并改造既有地球监测数据集，覆盖多国家、多传感器模态。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2306.03831",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/pdf/2306.03831",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/html/2306.03831v2/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "六名行业专家参与选题，覆盖林业和气候科学等领域；科学家指导委员会负责高层决策。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.03831",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "按易用性、现实用途、模态与任务多样性、宽松许可选取并改造既有数据；检测和计数任务转成语义分割；保留原划分或重建无空间重叠验证/测试集。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.03831",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "将训练样本过多的数据集下采样至最多20,000，近似均衡大类；公开转换流水线、统一加载格式与统计报告规范。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.03831",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "空间隔离用于降低下游train/validation/test地理泄漏；不等同于证明所有预训练影像都未与测试区域重叠。预训练语料重叠审计仍待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.03831",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
