  "design_goals": {
    "capabilities": {
      "value": "将临床问诊转录组织成准确、合规SOAP文书，减轻行政记录负担。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/medscribe",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "不以医学考试正确率替代真实临床文书质量比较。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/medscribe",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "使用Protege真实去标识SOAP笔记，改编NoteChat生成合成医患对话。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/medscribe",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "medical scribes与physician assistant参与专家验证。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/medscribe",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "专家先建SOAP结构模板、独立标注rubric，再共同解决冲突。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/medscribe",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "以NoteChat从Protege真实去标识SOAP笔记生成合成转录；专家包括medical scribes和physician assistant。真实性感知试验80份转录（40真实、40模拟），识别准确率39%、chance50%、p>0.05；另一个裁判对齐试验仅3样本/180 checks，调提示后与人类多数意见80.5%一致。两项研究不能外推为临床部署有效性。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/medscribe",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "官方发布文明确采用patient-level holdouts；Vals通用方法规定专有基准发布成绩只用始终私有的test set，以降低训练泄漏。去标识化是隐私措施而非单独的污染证明，私有留出也不等于证实所有训练无重叠。",
      "sources": [
        {
          "url": "https://www.vals.ai/blogs/measuring-healthcare-ai-where-it-actually-works",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://www.vals.ai/methodology",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "官方发布博客称100套专家rubrics覆盖80份transcripts；榜单方法还单独报告80份（40 real/40 simulated）的真实性感知研究与10份真实转录样例。三个数字属于不同描述层次，不相加为患者数，也不把真实性实验直接当榜单题目构成。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/medscribe",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://www.vals.ai/blogs/measuring-healthcare-ai-where-it-actually-works",
          "accessed": "2026-11-08"
        }
      ]
    },
    "question_types": {
      "value": "输入医患对话转录，输出Subjective、Objective、Assessment、Plan四段SOAP笔记。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/medscribe",
          "accessed": "2026-11-08"
        }
      ]
    },
    "modalities": {
      "value": [
        "文本对话",
        "文本SOAP笔记"
      ],
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/medscribe",
          "accessed": "2026-11-08"
        }
