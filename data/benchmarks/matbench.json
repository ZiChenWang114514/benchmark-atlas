        }
      ]
    },
    "author_background": {
      "value": "材料信息学研究团队；AD、QW、AJ构思，AD/QW/DD/AJ设计测试套件，AD/QW/AG实现Automatminer（论文Author Contributions）。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2005.00707",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://matbench.materialsproject.org/",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "整理来自密度泛函计算和实验来源的预清洗数据，输入为组成和/或晶体结构。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2005.00707",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/pdf/2005.00707",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://matbench.materialsproject.org/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "按任务过滤非物理模量、折射率<1、明显异常形成能等；实验组成去冲突/近似重复；特征拟合、超参数与模型选择只在每折训练数据内部进行。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2005.00707",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://matbench.materialsproject.org/",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "用外层固定五折且仅在训练部分做内部模型选择，防测试泄漏；随机/分层CV并不是按化学体系外推或后续LLM训练污染排查。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2005.00707",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://matbench.materialsproject.org/",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "13项监督学习任务；样本数从 steels 的312到 mp_e_form 的132,752，各任务独立，不求和去重为单一题量。",
      "sources": [
        {
          "url": "https://matbench.materialsproject.org/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "材料结构或化学组成作为输入，预测电子、热力学、力学、热学等性质；包括回归和分类。",
      "sources": [
        {
          "url": "https://matbench.materialsproject.org/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "化学组成字符串或pymatgen.Structure晶体结构；输出连续性质值或布尔分类标签，不是视觉语言问答。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2005.00707",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://matbench.materialsproject.org/How%20To%20Use/2run/",
          "accessed": "2026-11-08"
        }
      ]
    },
    "languages": {
      "value": "非自然语言题集：输入是化学组成/晶体结构与数值标签；自然语言语言分布不适用。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2005.00707",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://matbench.materialsproject.org/How%20To%20Use/2run/",
          "accessed": "2026-11-08"
        }
      ]
    },
    "difficulty": {
      "value": "13项任务跨实验/DFT、组成/结构与不同规模；难度按任务与样本量分析，无统一题目等级。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2005.00707",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://matbench.materialsproject.org/How%20To%20Use/2run/",
          "accessed": "2026-11-08"
        }
      ]
    },
    "public_hidden_split": {
      "value": "固定五折外层CV，每折80%训练+验证、20%测试；回归KFold、分类StratifiedKFold，seed=18012019；数据公开但评分时测试标签不得用于调参。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2005.00707",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://matbench.materialsproject.org/How%20To%20Use/2run/",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
