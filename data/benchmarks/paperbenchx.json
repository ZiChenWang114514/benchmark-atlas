  "design_goals": {
    "capabilities": {
      "value": "把论文中的关键实验做成可运行流程，并在干净环境中重放后，用重新生成的证据支持原科学主张。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.39744",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "论文认为已有复现基准主要集中在人工智能和机器学习，软件栈比较同质；跨学科复现还要求操作学科自己的科学软件。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2610.39744",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
