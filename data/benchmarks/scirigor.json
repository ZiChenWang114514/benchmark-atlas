      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.06192",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "从科学论文抽取案例，对齐问题、完整输入、可执行源分析、数值结果、原图、原子化结论和溯源信息。",
      "sources": [
        {
          "url": "https://arxiv.org/html/2609.06192v1",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "作者署名HKUST与Alibaba；案例按来源文章、作者代码和数据重建，由策划员核验；逐案例外部专家资质未在取得，不能把100例统称物理专家原创。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2609.06192",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "GPT-5.6辅助中性任务描述与Python迁移，人工策划、两次干净环境重建和最终人工审计。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.06192",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "冻结数据/变换/结果/图/主张节点及边，验证数值与来源；保持参考证据图固定。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.06192",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "隐藏gold证据图；公开源论文仍可能进入预训练，不能宣称无污染。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2609.06192",
          "accessed": "2026-11-08"
        }
      ]
    }
