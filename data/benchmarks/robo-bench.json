  "design_goals": {
    "capabilities": {
      "value": "仅以机器人规格、传感器和摄像头，在实时物理环境中自主编写感知、规划及低层控制。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/robo_bench",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "不预装运动规划器或平衡控制器，直接衡量通用agent控制机器人的能力，模型思考延迟计入真实时间。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/robo_bench",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
