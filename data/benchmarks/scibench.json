  "construction": {
    "question_sources": {
      "value": "从教学教材收集大学数学、物理与化学习题；另设计错误归因协议，结合人工标注与模型辅助分析。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2307.10635",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/pdf/2307.10635",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://github.com/mandyyyyii/scibench",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "研究团队从大学常用教材及经授课教师授权的课程考试采集题目；人工标注员参与OCR转写、校验和错误归因。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2307.10635",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "教材PDF由Mathpix OCR转LaTeX，人工核对编译、答案数值/LaTeX及单独单位；多问问题保留第一小问或拆成独立题。课程考试获授课教师授权。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2307.10635",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "以人工标注分析模型与标准解答的错误，再由 LLM verifier 归因到十项科学解题能力；这是误差分析协议，不等同题库无误证明。",
      "sources": [
        {
          "url": "https://github.com/mandyyyyii/scibench",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "官方选题要求题目不易在线以文本取得或提取，以降低泄漏风险；不代表已对模型训练数据完成审计。",
      "sources": [
        {
          "url": "https://scibench-ucla.github.io/",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
