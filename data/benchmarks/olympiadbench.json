          "accessed": "2026-11-08"
        },
        {
          "url": "https://github.com/OpenBMB/OlympiadBench",
          "accessed": "2026-11-08"
        }
      ]
    },
    "languages": {
      "value": "英语与中文，文件名 en/zh 区分。",
      "sources": [
        {
          "url": "https://github.com/OpenBMB/OlympiadBench",
          "accessed": "2026-11-08"
        }
      ]
    },
    "difficulty": {
      "value": "数学/物理竞赛及中国高考层级；论文表2 CEE:COMP为66%:34%，并非逐题统一难度分数。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2402.14008",
          "accessed": "2026-11-08"
        }
      ]
    },
    "public_hidden_split": {
      "value": "官方公开分类题目、答案、解答及配图，HF分18个config；实验直接使用固定zero-shot模板而非小验证集调参；本轮未核实独立隐藏测试赛道。",
