  "design_goals": {
    "capabilities": {
      "value": "以奥赛级双语多模态科学问题评测高难推理，科学板块优先展示物理子集。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.14008",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/pdf/2402.14008",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "以往科学问答偏选择题、单语或难度较低；该基准把高考到竞赛的数学/物理开放题、双语和图文输入放入统一题型框架，但文本与图文、证明与求解必须分别评估。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2402.14008",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "从数学和物理竞赛及中国高考试题选取，附专家级分步推理标注。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2402.14008",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/pdf/2402.14008",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "清华计算机系/人工智能研究院、北航人工智能研究院与Wisdom Way AI Lab作者团队；对竞赛官方PDF进行人工校对和标注，不是声称重新原创全部试题。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2402.14008",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "Mathpix将官方试题PDF转为Markdown；团队逐项对照原PDF人工校验，再结构化为题干—解答—答案，人工标注主题与题型。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2402.14008",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "Mathpix OCR 解析官方 PDF，再检查、清洗、修订、去重并标注答案类型和子领域。",
      "sources": [
        {
          "url": "https://github.com/OpenBMB/OlympiadBench",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "从官方竞赛PDF而非网页聚合站取题，转换格式以降低泄漏风险；以数学符号语料训练的小模型向量化并按余弦相似度去重。这不证明公开历史试题未进入模型训练。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2402.14008",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "论文v2全库8,476题：数学6,142、物理2,334；4,869题带图（数学2,911、物理1,958）。此为论文统计，不将HF卡片size_categories:10M误当题量。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2402.14008",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://huggingface.co/datasets/Hothan/OlympiadBench/raw/main/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "question_types": {
      "value": "6,728道开放式求解题、1,748道定理证明题；答案类型包括数值、表达式、方程、区间与元组。证明题不纳入常规自动评分结果。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2402.14008",
          "accessed": "2026-11-08"
        }
      ]
    },
    "modalities": {
