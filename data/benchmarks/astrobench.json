  "design_goals": {
    "capabilities": {
      "value": "测量天文学及天体物理知识理解、学科差异和置信度校准。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2407.11194",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/pdf/2407.11194",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://huggingface.co/datasets/AstroMLab/Astrobench_MCQ_v1_Public",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "MMLU等广域测试缺少天文学研究知识深度，而且通用平均分不能反映学科内模型差异及成本效率；本测试重点是天文知识召回与跨子领域联系，不是端到端原创研究能力。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2407.11194",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/pdf/2505.17592",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "从 Annual Review of Astronomy and Astrophysics 文章整理多项选择题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2407.11194",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/pdf/2407.11194",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://huggingface.co/datasets/AstroMLab/Astrobench_MCQ_v1_Public",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "ARAA受邀综述提供领域专家知识；Gemini-1.5-Pro生成题目与解释，AstroMLab研究者设计提示并由人类专家抽查子集。综述作者不等于逐题命题者。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2407.11194",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "Gemini-1.5-Pro从885篇ARAA综述每篇生成5题，附说明与证据段；人类专家只审核了子集，不是全量专家逐题原创。",
      "sources": [
        {
          "url": "https://arxiv.org/html/2407.11194v2",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "原论文要求题目可脱离原文独立作答、答案不引用特定段落、四选项长度相近，附解释与支持段落；专家抽查。AstroMLab-4又用Claude-3.5-Sonnet清理依赖论文特定数值/方法的题，修订不必要引用，形成3846题。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2407.11194",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/pdf/2505.17592",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "公开题目故意省略答案键以抑制直接答案训练；AstroSage作者报告从其训练语料中排除了ARAA来源文章。这是该模型训练控制，不能推广为所有参测模型无污染，亦不能排除题目和来源知识的间接暴露。",
      "sources": [
        {
          "url": "https://huggingface.co/datasets/AstroMLab/Astrobench_MCQ_v1_Public",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/pdf/2505.17592",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
