          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "纯文本题干及A/B/C/D四个字符串选项；公开卡没有图像字段。",
      "sources": [
        {
          "url": "https://huggingface.co/datasets/AstroMLab/Astrobench_MCQ_v1_Public",
          "accessed": "2026-11-07"
        }
