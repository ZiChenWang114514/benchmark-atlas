    },
    "languages": {
      "value": [
        "英文"
      ],
      "sources": [
        {
          "url": "https://huggingface.co/datasets/AstroMLab/Astrobench_MCQ_v1_Public",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "原论文定位博士级天文领域知识；后续AstroMLab-4明确指出主要测试知识召回，推理模式未普遍提升分数。不能把高分解释为自主天文研究成功率。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2407.11194",
          "accessed": "2026-11-07"
        },
