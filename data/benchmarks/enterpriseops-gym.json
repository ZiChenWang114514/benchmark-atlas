  "design_goals": {
    "capabilities": {
      "value": "在有持久状态变化与严格访问规范的企业环境中进行长程规划与工具调用，并能拒绝不可行任务。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2603.13594",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "已有基准未反映专业环境中长程规划、持久状态与访问协议的复杂性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2603.13594",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "根据公开企业API文档和领域SME设计合成数据库与任务，不使用私有企业数据；Calendar、CSM、、Email、HR、ITSM、Teams及Hybrid八域。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2603.13594",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "Turing组织160余名工程师、领域SME与标注人员；工程/计算机等相关学士背景，平均每域20名标注者和6名reviewer，历时约4个月含1个月试点。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2603.13594",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "场景设计→人工执行gold轨迹并写政策约束plan→编写最终状态SQL verifier→多轮可行性、清晰度、外键和权限约束检查；最终状态唯一但允许多条合法执行路径。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2603.13594",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "先用GPT-5/Gemini/Claude试跑排查缺失工具、无效数据、无意捷径与过简任务，再人工核查prompt、轨迹及verifier覆盖；每次任务重置数据库避免跨运行状态泄漏。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2603.13594",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "环境由公开文档与SME独立合成，私有企业数据不进入；官方README只释放约60%样本。论文未给出可量化语料去重检索结果，不能宣称完全无污染。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2603.13594",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://github.com/ServiceNow/EnterpriseOps-Gym/blob/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
