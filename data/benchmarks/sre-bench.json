  "design_goals": {
    "capabilities": {
      "value": "在没有源代码的情况下理解真实规模、带反分析保护的二进制程序（协议、固件、游戏、文件格式恢复、恶意软件）。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/srebench",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/abs/2608.11469",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "现有 RE 相关基准依赖已有 CTF 或玩具程序，易被记忆污染且规模与保护不真实。",
      "sources": [
        {
          "url": "https://www.vals.ai/benchmarks/srebench",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "RE 专家从零构建19个内部程序（平均约16.9K行代码），配合44种自研反分析机制（27K行代码的保护套件）。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.11469",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://www.vals.ai/benchmarks/srebench",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "逆向工程专家平均6年经验，总投入超过5,000专家小时；19程序分别从私有设计规范独立实现，不共享代码且不基于公开项目。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.11469",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "每程序私有参考解必须得6/6作为可解性及回归门；用Opus 4.8与GPT-6-Astra进行对抗性reward-hacking审计，发现可读隐藏行为字符串后移除并加入构建回归检查。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.11469",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "目标、评分基础设施及保护套件全部内部构建；评分代码、参考解和开发产物从agent容器移除，运行中不提供评分反馈；域级任务通过确定性server、回放或沙箱验证。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.11469",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "全部从零 clean-room 构建、程序私有，以避免出现在训练数据中",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2608.11469",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://www.vals.ai/benchmarks/srebench",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
