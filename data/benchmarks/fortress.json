  "design_goals": {
    "capabilities": {
      "value": "国家安全与公共安全双用途场景下，模型防护的有害协助风险和良性过度拒绝。",
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/fortress",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "不只测双用途知识能力，还以配对良性提示衡量安全—实用性权衡。",
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/fortress",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "专家构建对抗提示，覆盖CBRNE、政治暴力／恐怖主义、犯罪／金融非法活动。",
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/fortress",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "经验丰富的人类红队人员；论文附录列多学科背景，但Limitations承认他们未必具有真实恶意行为者的深领域知识，因此不将其全部描述为CBRNE领域专家。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2506.14922",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "每条对抗提示配4–7条二元评分rubric及主题相近良性提示。",
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/fortress",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "三裁判按条目多数投票，非单一粗粒度关键词检查。",
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/fortress",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "排行榜包含公开与私有提示；私有提示用于减少污染。",
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/fortress",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
