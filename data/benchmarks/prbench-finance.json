  "evaluation": {
    "metrics": {
      "value": "加权rubric平均分；Hard与Full分轨；类别分析另用min-normalized分数。",
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/prbench-finance",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/abs/2511.11562",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://huggingface.co/datasets/ScaleAI/PRBench",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "o4-mini逐rubric给二值满足标签；权重为非零−10至+10。每题先以加权满足值之和除以正权重总和（单题允许负分），随后跨题求均值，最后max(0, mean)。不是先将每题负分截为0再平均。类别图另用min-normalized，不与主指标混用。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2511.11562",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://raw.githubusercontent.com/scaleapi/PRBench/main/evals.py",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://raw.githubusercontent.com/scaleapi/PRBench/main/util.py",
          "accessed": "2026-11-08"
        }
      ]
    },
    "prompt_settings": {
      "value": "论文每模型独立评估3次，报告均值与95%置信区间；GPT-5/O3/Grok-4设High，Claude Sonnet 4.5与Opus 4.1思考预算32K/16K，Gemini 2.5 Pro使用dynamic；timeout 60分钟、最多5次尝试，末次降为low。工具实验单列，不与无工具结果混排。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2511.11562",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/pdf/2511.11562",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://huggingface.co/datasets/ScaleAI/PRBench/raw/main/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "official_scripts": {
      "value": "https://github.com/scaleapi/PRBench；python evals.py config.yaml；results/报告mean_clipped，outputs/保留逐题分数。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/scaleapi/PRBench/main/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "comparability_warning": {
      "value": "当前网页Performance Comparison未明确标注Full/Hard，原样保存显示分数，不根据数值倒推口径。论文Hard的0–1分数另轨；Rank(UB)为1加上置信区间下界高于本模型上界的模型数。HF卡18,692条rubric标准与论文/README 19,356冲突，不能静默统一。 当前榜Full/Hard范围待核实。",
