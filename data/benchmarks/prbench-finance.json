  "design_goals": {
    "capabilities": {
      "value": "专业金融开放推理：金融准确性、审计透明性、不确定性处理、风险合规披露与可操作性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2511.11562",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "从学术题转向真实客户或专业工作中有经济后果的问题，不以单一短答案代替职业判断。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2511.11562",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "总集182位法律/金融专家按实际工作或客户问题撰题；约30%通过最多10轮对话逐步构建背景。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2511.11562",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "金融出题者要求硕士、CFA或至少6年专业经验；182为全PRBench专家总数，不冒称金融独占。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2511.11562",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "另一领域专家审核问题与rubric，自动检查原子性、自包含等规范，独立专家验证。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2511.11562",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "全量rubric验证一致率93.9%；每题含正负加权标准。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2511.11562",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "论文公开1,100个对话，另外保留私有held-out集监测未来模型污染；私有集规模待核实。公开数据含canary字段，不能据此认定已完成训练语料排除。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2511.11562",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/pdf/2511.11562",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://huggingface.co/datasets/ScaleAI/PRBench/raw/main/README.md",
          "accessed": "2026-11-08"
        }
      ],
      "status": "待核实"
    }
  },
