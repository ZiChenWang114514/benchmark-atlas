  "design_goals": {
    "capabilities": {
      "value": "通过已有研究代码与环境重新执行实验、读取输出并回答科学结果问题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.11363",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "计算可复现性既是研究可信度问题，也是需要工具、软件环境与结果解释的Agent综合任务。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.11363",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "Code Ocean上的90篇计算机科学、社会科学和医学论文的代码capsule。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.11363",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "Princeton研究团队人工整理可复现问题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.11363",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "每个capsule人工运行3次，验证问题可答与输出稳定性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.11363",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "确定性输出精确答案；非确定性数值用重复运行构造95%预测区间。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.11363",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "评测禁止访问Code Ocean网站以免直接取回现成输出；公开论文/代码的训练泄漏仍无法完全排除。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.11363",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "90论文、270任务（每篇3难度）；45论文train/45test；181个独特问题被复用于各难度，不等于270篇论文。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.11363",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "运行科研代码、检查产物，回答关于实验/图表的短问题。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.11363",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": [
        "论文/README文本",
        "代码",
        "实验数据/结果文件"
      ],
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.11363",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "Python / R科研代码；英语问题与文档。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.11363",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "Easy给出输出；Medium给Dockerfile+README；Hard只有README，需自行配置执行。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.11363",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "按论文分45/45 train/test以避免同篇跨split；研究材料/脚本公开。",
