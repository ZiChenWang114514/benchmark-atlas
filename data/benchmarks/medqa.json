  "design_goals": {
    "capabilities": {
      "value": "医学执照考试式多项选择，结合临床知识、病例推理与外部证据检索。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2009.13081",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "给定短文抽取答案的阅读理解难以代表需检索多个医学来源的开放域问答。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2009.13081",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
