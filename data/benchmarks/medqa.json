  "design_goals": {
    "capabilities": {
      "value": "医学执照考试式多项选择，结合临床知识、病例推理与外部证据检索。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2009.13081",
          "accessed": "2026-11-08"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "给定短文抽取答案的阅读理解难以代表需检索多个医学来源的开放域问答。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2009.13081",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "美国、中国大陆、台湾医学资格考试题及相关医学教科书/文档语料。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2009.13081",
          "accessed": "2026-11-08"
        }
      ]
    },
    "author_background": {
      "value": "论文为MIT计算机研究者与同济医学院作者共同工作；数据为专业医学执照考试及模拟题。论文另外使用两名医学医生审核检索证据，不把他们误作全部原题命题者。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2009.13081",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "删除重复题，按问题随机80%/10%/10%分train/dev/test；USMLE与MCMLE打乱选项并随机删一个错误项得到四选项版。论文两名医生审核的是dev随机100题top25检索段落的证据充分性，不是全数据医学双审。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2009.13081",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "多语言数据与固定划分，论文分析检索噪声和多证据推理失败。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2009.13081",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "公开考试及GitHub测试集存在训练暴露风险；2020原始划分不能证明2026模型无污染。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2009.13081",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "英语12,723、简体中文34,251、繁体中文14,123题；三语合计61,097（由原论文分项相加）。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2009.13081",
          "accessed": "2026-11-08"
        }
      ]
    },
    "question_types": {
      "value": "病例或医学知识的多项选择；原版与US/大陆4选项处理版须分开。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2009.13081",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://github.com/jind11/MedQA",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "文本题干、选项、答案；QA逐行保存为JSONL，每行是一个dict；附英语与简体中文教材检索语料。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/jind11/MedQA/master/README.md",
          "accessed": "2026-11-08"
        }
      ]
    },
    "languages": {
      "value": [
        "英语",
        "简体中文",
        "繁体中文"
      ],
      "sources": [
        {
          "url": "https://arxiv.org/abs/2009.13081",
          "accessed": "2026-11-08"
        }
      ]
    },
    "difficulty": {
      "value": "专业医学考试；不等同真实临床工作流或安全性验证。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2009.13081",
          "accessed": "2026-11-08"
        }
      ]
    },
    "public_hidden_split": {
      "value": "原论文表3：USMLE train10,178/dev1,272/test1,273；MCMLE train27,400/dev3,425/test3,426；TWMLE train11,298/dev1,412/test1,413。原数据与4_options处理版均需标记；三语分割公开，不是统一的隐藏医疗测试。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2009.13081",
          "accessed": "2026-11-08"
        },
