    },
    "scoring": {
      "value": "原论文结合检索器与阅读器，也可闭卷选择；检索/开卷与闭卷分开。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2009.13081",
          "accessed": "2026-11-08"
        }
      ]
    },
    "prompt_settings": {
      "value": "原论文非统一现代LLM提示；后续模型需注明4/5选项、CoT、shot、检索和测试子集。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2009.13081",
          "accessed": "2026-11-08"
        }
      ]
