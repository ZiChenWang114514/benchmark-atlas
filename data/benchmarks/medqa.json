          "url": "https://raw.githubusercontent.com/jind11/MedQA/master/README.md",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "Accuracy：选择答案匹配标准答案。",
      "sources": [
