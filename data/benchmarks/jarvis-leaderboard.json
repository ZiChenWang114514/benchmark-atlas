    "scoring": {
      "value": "将csv.zip预测ID与相应benchmark JSON的test ID对齐，按该任务MAE、ACC或MULTIMAE计算；MAE需连同物理单位、参照DFT/实验和样本划分报告。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.11688",
          "accessed": "2026-11-08"
        },
