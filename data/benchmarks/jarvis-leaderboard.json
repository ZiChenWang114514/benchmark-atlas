  "design_goals": {
    "capabilities": {
      "value": "在统一平台记录多模态材料设计方法的性能及可复现元数据。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2306.11688",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/pdf/2306.11688",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://pages.nist.gov/jarvis_leaderboard/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "材料设计方法往往将代码、数据和结果分散在GitHub、Zenodo、Figshare等处，且缺少共同划分及计算环境；平台把参考数据、预测、执行脚本与硬软件元数据连接起来，覆盖AI之外的ES、FF、QC及实验。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.11688",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://pages.nist.gov/jarvis_leaderboard/",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "社区提交数据、代码和方法元数据；覆盖 AI、电子结构、力场、量子计算及实验等类别。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2306.11688",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/pdf/2306.11688",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://pages.nist.gov/jarvis_leaderboard/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "NIST材料计算与数据研究人员及来自电子结构、机器学习力场、量子计算、实验等社区的贡献者；提交者资质不自动等于每项预测已被独立复现。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.11688",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://pages.nist.gov/jarvis_leaderboard/",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "提交者准备预测csv.zip、metadata.json及可选run.sh/环境文件，经最小sanity checks、GitHub Actions后由NIST管理员审核并合入榜单。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.11688",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "最低自动检查包括通过 GitHub Actions 重建榜单和安装软件；记录预测、软件、硬件和仪器背景以支持复现。",
      "sources": [
        {
          "url": "https://pages.nist.gov/jarvis_leaderboard/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "采用固定划分以避免训练/测试混淆；同库ID及目标公开不构成LLM式防训练泄漏证明，预训练力场与同集训练模型必须按具体任务区分。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.11688",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "本次官网快照322个benchmark、2087项贡献、8,752,827个datapoints；这些是平台聚合量，不是单一任务题量。",
      "sources": [
        {
          "url": "https://pages.nist.gov/jarvis_leaderboard/",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "按任务输出标量性质、分类标签、多值光谱/力、生成结构或文本等；不是一道统一的自然语言问答测试。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.11688",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://pages.nist.gov/jarvis_leaderboard/",
          "accessed": "2026-11-08"
        }
      ]
    },
    "modalities": {
      "value": [
        "化学式与原子结构",
        "材料性质数值/力/光谱",
        "STEM图像",
        "论文文本",
        "实验数据",
        "Hamiltonian与量子结果"
      ],
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.11688",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://pages.nist.gov/jarvis_leaderboard/",
          "accessed": "2026-11-08"
        }
      ]
    },
    "languages": {
      "value": "平台说明与论文为英语；输入还包括结构、化学式、数值、图像和代码，不能用单一自然语言标签覆盖所有子任务。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.11688",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://pages.nist.gov/jarvis_leaderboard/",
          "accessed": "2026-11-08"
        }
      ]
    },
    "difficulty": {
      "value": "难度按具体材料性质与参考方法而异；误差单位、测试样本及基线不同，不设可跨任务比较的统一easy/hard或总冠军。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.11688",
          "accessed": "2026-11-08"
        }
      ]
    },
    "public_hidden_split": {
      "value": "AI任务用预定义train/validation/test ID和目标JSON，固定随机划分；ES、FF、QC、实验通常只有参考test。平台展示test性能，底层数据经JARVIS-Tools及有版本DOI的Figshare存放。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2306.11688",
          "accessed": "2026-11-08"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "按具体任务报告 MAE、ACC 或 MULTIMAE 等；不同任务不拼成同一排名。",
