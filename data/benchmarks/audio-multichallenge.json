  "design_goals": {
    "capabilities": {
      "value": "自然人声多轮对话中的推断记忆、指令保持、自洽与口头修订。",
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/audiomc",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "ASR/TTS或单轮合成语音测试难衡量犹豫、打断、环境声音与多轮修订的鲁棒性。",
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/audiomc",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "多智能体先用TTS探索失败策略，提炼为蓝图；人类按蓝图即兴录制自然对话并写原子rubric。",
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/audiomc",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "论文称highly trained core contributors；47位说话人按对抗蓝图自然即兴录制，专门审核员、独立质控团队与内部研究团队复审。不是TTS音频直接充当最终人声测试集。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2512.14865",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "专门审核员、独立QC团队及内部研究团队三阶段审核自然性、失败有效性、音频与rubric。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2512.14865",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "三阶段核查自然性、真实失败、提示多样性、音质与rubric。官方方法页报告在1712次rubric判断上o4-mini与人工Cohen κ约0.87、Macro F1约0.94（作者近似报告值，非本库推算）。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2512.14865",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://labs.scale.com/leaderboard/audiomc-text",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "新采集的人声对抗对话与实例专用最终轮rubric可减少直接搬用既有问答，但公开HF卡含转录/历史；本轮未在论文中找到训练语料逐条去重审计证据，不能称无污染。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2512.14865",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://huggingface.co/datasets/ScaleAI/audiomc",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "452对话、1,712项rubric、47位说话人；14.99小时用户音频，48kHz；每对话3–8轮。",
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/audiomc",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "提供固定对话历史，只评最终助手回复；用户轮为音频，历史助手轮为文本。",
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/audiomc",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": [
        "音频",
        "文本"
      ],
      "sources": [
        {
          "url": "https://labs.scale.com/leaderboard/audiomc",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2512.14865",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "3–8轮固定上下文：Inference Memory、Instruction Retention、Self Coherence、Voice Editing；42题需背景声/副语言等audio cue。难点为跨轮状态与口头修订，而非只增加轮数或衡量发音质量。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/2512.14865",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://labs.scale.com/leaderboard/audiomc-text",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "官方HF公开452对话及rubric数据；用户各轮音频、转录与历史助手文本用于固定历史输入。最后助手回复由受测模型新生成；不能把历史助手回答当该模型自由交互轨迹。本轮未核实独立训练集/隐藏测试划分。",
      "sources": [
        {
          "url": "https://huggingface.co/datasets/ScaleAI/audiomc",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://huggingface.co/datasets/ScaleAI/audiomc/raw/main/README.md",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/pdf/2512.14865",
          "accessed": "2026-11-07"
        }
      ],
      "status": "待核实"
    }
  },
