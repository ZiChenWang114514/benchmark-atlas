  "design_goals": {
    "capabilities": {
      "value": "以真实职业任务衡量经济相关知识工作的交付物质量。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.04374",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "学术短答案测试难以覆盖职业工作中的文件处理、审美与可用性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.04374",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "专业从业者实际工作产物，按O*NET工作活动选择9个产业的44个职业。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.04374",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "专家至少4年职业经验，平均14年；通过面试、背景核查、训练与测验。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.04374",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "自动筛查加通才初审、同行职业专家复审、迭代最终审核。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.04374",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "全体1,320任务平均5轮、至少3轮人工审核。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.04374",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "公开gold子集已清理出题者识别信息；不能据此认定完全无训练污染。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2510.04374",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
