  "design_goals": {
    "capabilities": {
      "value": "跨SaaS应用自主发现API、处理数据、遵守分层业务规则并完成多步工作流。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/automationbench-aa",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/abs/2604.18934",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "很多工具基准只测单应用/函数选择，缺少跨应用协调、端点发现和业务政策组合。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/automationbench-aa",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/abs/2604.18934",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "根据Zapier客户工作流形状合成，未使用PII/客户机密；涵盖6领域、约500端点与47模拟应用。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.18934",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "Zapier研究/工程团队；Opus4.6、GPT5.3Codex、Gemini3参与生成，再做审查。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.18934",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "多轮现实性/难度迭代、抽样人工审计；通过不含实际参数的提示模式验证可解性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.18934",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "每题要求可观察状态修改、确定性检查与负断言防止撒网行为；RL试验识别奖励漏洞。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.18934",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "母协议公开600题，至少同规模私有题；AA保留657评测题，公开示例不是官方完整评分集。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.18934",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "AA实现：657任务，6领域（Finance/HR/Marketing/Operations/Sales/Support）；母论文公开600及600+私有不是同一精确分母。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/automationbench-aa",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "一次任务指令后自主多步API检索/调用，最后核对多个应用状态。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/automationbench-aa",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": [
        "文本",
        "结构化API与数据库",
        "模拟SaaS应用"
      ],
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/automationbench-aa",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语业务指令与API schema。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/automationbench-aa",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "分层政策、噪声和相似记录造成困难；不等于真实生产SaaS连通性或凭证权限测试。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/automationbench-aa",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "AA评分题保留私有，部分样例公开；母项目公开题可研究，不能作为AA分数完全复现集。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/automationbench-aa",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "headline为每题objective完成比例，经guardrail门控后平均；另有严格整题成功率。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/automationbench-aa",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "每个任务先检查终态程序断言：任一guardrail违规或任务出错记0；否则取该任务objectives完成比例，再对任务等权平均。没有独立LLM裁判；网页无guardrail门控的Objectives Completed仅为诊断指标，不是headline。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/methodology/intelligence-benchmarking#automation-bench-aa",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://artificialanalysis.ai/evaluations/automationbench-aa",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "私有657题来自AutomationBench 1.0.6；Finance/HR/Marketing/Operations/Sales/Support六域；每题运行一次，最多50轮，以结构化工具发现并调用REST API。各域互斥；一题可涉及多个app，因此应用分项不互斥。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/methodology/intelligence-benchmarking#automation-bench-aa",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "https://github.com/zapier/AutomationBench",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/automationbench-aa",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "AA对无guardrail违规任务按目标完成比例给分，违规或执行错误记0；Zapier主榜按所有断言全通过的任务比例评分。公开600任务、AA私有657任务、另200条simple任务不能混用。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/methodology/intelligence-benchmarking",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/zapier/AutomationBench/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
