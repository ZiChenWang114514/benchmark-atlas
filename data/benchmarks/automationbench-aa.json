  "evaluation": {
    "metrics": {
      "value": "headline为每题objective完成比例，经guardrail门控后平均；另有严格整题成功率。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/automationbench-aa",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "任一guardrail违规整题0；否则按该任务objective满足比例记分。无条件objective得分不是同一指标。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/automationbench-aa",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "每任务独立运行1次；50轮上限；模型经结构化工具自主发现并调用REST API；按终态程序断言评分，不使用独立LLM裁判。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/methodology/intelligence-benchmarking",
          "accessed": "2026-11-07"
        }
      ]
    },
    "official_scripts": {
      "value": "https://github.com/zapier/AutomationBench",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/automationbench-aa",
          "accessed": "2026-11-07"
        }
      ]
    },
    "comparability_warning": {
      "value": "AA对无guardrail违规任务按目标完成比例给分，违规或执行错误记0；Zapier主榜按所有断言全通过的任务比例评分。公开600任务、AA私有657任务、另200条simple任务不能混用。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/methodology/intelligence-benchmarking",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://raw.githubusercontent.com/zapier/AutomationBench/main/README.md",
