  "design_goals": {
    "capabilities": {
      "value": "跨SaaS应用自主发现API、处理数据、遵守分层业务规则并完成多步工作流。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/automationbench-aa",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/abs/2604.18934",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "很多工具基准只测单应用/函数选择，缺少跨应用协调、端点发现和业务政策组合。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/automationbench-aa",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://arxiv.org/abs/2604.18934",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "根据Zapier客户工作流形状合成，未使用PII/客户机密；涵盖6领域、约500端点与47模拟应用。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.18934",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "Zapier研究/工程团队；Opus4.6、GPT5.3Codex、Gemini3参与生成，再做审查。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.18934",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "多轮现实性/难度迭代、抽样人工审计；通过不含实际参数的提示模式验证可解性。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.18934",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "每题要求可观察状态修改、确定性检查与负断言防止撒网行为；RL试验识别奖励漏洞。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.18934",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "母协议公开600题，至少同规模私有题；AA保留657评测题，公开示例不是官方完整评分集。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2604.18934",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "AA实现：657任务，6领域（Finance/HR/Marketing/Operations/Sales/Support）；母论文公开600及600+私有不是同一精确分母。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/automationbench-aa",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "一次任务指令后自主多步API检索/调用，最后核对多个应用状态。",
      "sources": [
        {
          "url": "https://artificialanalysis.ai/evaluations/automationbench-aa",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
