  "design_goals": {
    "capabilities": {
      "value": "基于专家讨论的CRISPR/基因组实验科学推理与问答；无工具MCQ。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.19501",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "教材事实问答不足以反映专家社区的实验设计、故障诊断与经验知识。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.19501",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "CRISPR相关专家讨论和论坛线程；官方dataset_pipeline可解析.mbox邮件档案并转换为标准MCQ及QA格式。",
      "sources": [
        {
          "url": "https://raw.githubusercontent.com/mingyin0312/RL4GenomeBench/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "社区原问题来自实验/基因组学参与者；论文作者做QA提取与清洗。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.19501",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "GPT-4Turbo抽取QA/context，GPT-4o改写和构建干扰项，人工检查。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.19501",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "去重、去未解答/离题内容、随机选项顺序与人工质量检查。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.19501",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "源讨论公开；划分问答不保证预训练无暴露或同主题讨论完全隔离。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.19501",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "3,332条问答，来自11年基因组编辑研究讨论；HF固定train 2,671、test 661，不能与GeneBench 103/129题混淆。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.19501",
          "accessed": "2026-11-07"
        },
        {
          "url": "https://huggingface.co/datasets/Mingyin0312/Genome-Bench/blob/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "英语五选一科学/实验推理；不是基因序列预测或执行型组学分析。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.19501",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "纯文本问题、上下文、五个选项和答案。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.19501",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
