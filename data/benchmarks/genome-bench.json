      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.19501",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "专家讨论改编，原论文按七类任务口径；不补造统一难度标签。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2505.19501",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "公开train/test 2671/661，固定测试准确率。",
      "sources": [
