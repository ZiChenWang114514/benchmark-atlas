  "design_goals": {
    "capabilities": {
      "value": "统一评估 RAG 系统的事实性、检索和多跳推理能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.12941",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "既有数据常把检索、事实性与推理拆开，不能充分测量端到端多来源整合。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.12941",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
