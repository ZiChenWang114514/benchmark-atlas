  "data_format": {
    "size": {
      "value": "824道多跳问题，每题需关联2–15篇Wikipedia文章；正文为题量权威口径，不采用卡片异常的n>1T自动元数据。",
      "sources": [
        {
          "url": "https://huggingface.co/datasets/google/frames-benchmark/raw/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "多跳开放问答；附gold answer及相关文章，标注数值、表格、多重约束、时间与后处理等推理类型。",
      "sources": [
        {
          "url": "https://huggingface.co/datasets/google/frames-benchmark/raw/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
