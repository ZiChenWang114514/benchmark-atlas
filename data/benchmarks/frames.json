  "design_goals": {
    "capabilities": {
      "value": "统一评估 RAG 系统的事实性、检索和多跳推理能力。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.12941",
          "accessed": "2026-11-07"
        }
      ]
    },
    "gap_in_prior_benchmarks": {
      "value": "既有数据常把检索、事实性与推理拆开，不能充分测量端到端多来源整合。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.12941",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "construction": {
    "question_sources": {
      "value": "先试验LLM合成，但>30%出现幻觉且难稳定要求超过4篇文章；最终824题由人工编写，利用多篇Wikipedia页面、金答案和来源链接，不能称作纯合成题库。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.12941",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "经过筛选、具有问题编写和复杂推理任务经验的人工标注专家；这是论文对团队资质的描述，不外推每位标注员的学历/学科身份。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.12941",
          "accessed": "2026-11-07"
        }
      ]
    },
    "review_process": {
      "value": "人工重新标注核对答案与所列Wikipedia页面是否一致；补充时间截止语境消除时效歧义；删除yes/no问题以减少猜测；每题标注可重叠的推理类型。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.12941",
          "accessed": "2026-11-07"
        }
      ]
    },
    "quality_control": {
      "value": "题目与答案重新核对来源、补明确日期以免答案随时间变化、移除二元答案扩大输出空间，并标注五类推理以便解释。Wikipedia页面数不直接等于严格推理hop数。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.12941",
          "accessed": "2026-11-07"
        }
      ]
    },
    "decontamination": {
      "value": "以需要跨来源推理和额外运算的问题减少直接事实记忆的收益；论文Limitations仍明确承认Wikipedia可能进入预训练，未证明无污染。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.12941",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "data_format": {
    "size": {
      "value": "824道多跳问题，每题需关联2–15篇Wikipedia文章；正文为题量权威口径，不采用卡片异常的n>1T自动元数据。",
      "sources": [
        {
          "url": "https://huggingface.co/datasets/google/frames-benchmark/raw/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "question_types": {
      "value": "多跳开放问答；附gold answer及相关文章，标注数值、表格、多重约束、时间与后处理等推理类型。",
      "sources": [
        {
          "url": "https://huggingface.co/datasets/google/frames-benchmark/raw/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "modalities": {
      "value": "文本",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.12941",
          "accessed": "2026-11-07"
        }
      ]
    },
    "languages": {
      "value": "英语（数据卡language: en）",
      "sources": [
        {
          "url": "https://huggingface.co/datasets/google/frames-benchmark/raw/main/README.md",
          "accessed": "2026-11-07"
        }
      ]
    },
    "difficulty": {
      "value": "数值、表格、多约束、时间、后处理等推理类型；文章数不同。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.12941",
          "accessed": "2026-11-07"
        }
      ]
    },
    "public_hidden_split": {
      "value": "官方公开问题、答案、相关 Wikipedia 文章；本次未核实额外隐藏集。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.12941",
          "accessed": "2026-11-07"
        }
      ]
    }
  },
  "evaluation": {
    "metrics": {
      "value": "最终回答准确率；检索配置须单独标注。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.12941",
          "accessed": "2026-11-07"
        }
      ]
    },
    "scoring": {
      "value": "对最终答案评判，论文比较无检索、BM25、oracle 和多轮检索推理；不能将 oracle 分当作端到端检索分。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.12941",
          "accessed": "2026-11-07"
        }
      ]
    },
    "prompt_settings": {
      "value": "原论文包含 naive、BM25 top4、oracle、多步检索推理等不同管线；保持模型快照与检索协议一致。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/2409.12941",
          "accessed": "2026-11-07"
        }
      ]
    },
