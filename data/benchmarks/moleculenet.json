  "construction": {
    "question_sources": {
      "value": "汇集多个公开分子数据库，覆盖量子力学、物理化学、生物物理和生理四大类。",
      "sources": [
        {
          "url": "https://arxiv.org/html/1703.00564",
          "accessed": "2026-11-07"
        }
      ]
    },
    "author_background": {
      "value": "作者来自Stanford化学系、计算机科学系、医学院生物物理项目及Schrödinger Inc.；这是分子机器学习/化学研究团队，不是教材选择题出题群体。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/1703.00564",
          "accessed": "2026-11-08"
        }
      ]
    },
    "review_process": {
      "value": "整理多个公开分子数据集，将特征化、学习算法和划分机制集成到 DeepChem。",
      "sources": [
        {
          "url": "https://arxiv.org/abs/1703.00564",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://arxiv.org/pdf/1703.00564",
          "accessed": "2026-11-08"
        }
      ]
    },
    "quality_control": {
      "value": "统一数据加载、特征表示和子集划分，并为任务指定指标；PCBA/MUV采用PRC-AUC处理高度不平衡，不能以ROC-AUC替换。不同数据集可有缺失任务标签、无效结构或不同loader过滤结果，复现需固定loader和缓存。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/1703.00564",
          "accessed": "2026-11-08"
        },
        {
          "url": "https://deepchem.readthedocs.io/en/stable/api_reference/moleculenet.html",
          "accessed": "2026-11-08"
        }
      ]
    },
    "decontamination": {
      "value": "原论文用骨架划分检验未见结构泛化，时间划分用于PDBbind，随机划分用于其他若干任务；这些是监督学习数据泄漏控制，不等于LLM训练语料去污染。面向LLM的专项污染审计待核实。",
      "sources": [
        {
          "url": "https://arxiv.org/pdf/1703.00564",
          "accessed": "2026-11-08"
        }
      ],
      "status": "待核实"
    }
  },
