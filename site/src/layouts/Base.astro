---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { currentLocale, hrefForLocale, t } from '../i18n';

interface Props {
  title: string;
  description: string;
  active?: 'home' | 'trending' | 'heat' | 'impact' | 'registry' | 'constitution' | 'api';
}
const { title, description, active } = Astro.props;
const locale = currentLocale();
const fullTitle = title === 'Benchmark Constitution' ? 'Benchmark Constitution' : `${title} — Benchmark Constitution`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const enHref = new URL(hrefForLocale(Astro.url.pathname, '', 'en'), Astro.site).href;
const zhHref = new URL(hrefForLocale(Astro.url.pathname, '', 'zh'), Astro.site).href;
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-Hans' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="zh-Hans" href={zhHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <meta name="theme-color" content="#f3efe6" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;1,6..72,500&family=Noto+Sans+SC:wght@400;500;600&family=Noto+Serif+SC:wght@500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip" href="#content">{t(locale, 'skip')}</a>
    <Header active={active} />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      document.documentElement.classList.add('js');
      (function () {
        var reduce = false;
        try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (error) { reduce = false; }
        var nodes = Array.prototype.slice.call(document.querySelectorAll('.reveal, .grow-root'));
        function show(node) { node.classList.add('inview'); }
        function countUp(node) {
          if (!node || node.getAttribute('data-counted') === '1') return;
          var raw = node.getAttribute('data-count');
          if (raw == null || raw === '') return;
          var target = Number(raw);
          if (!Number.isFinite(target)) return;
          node.setAttribute('data-counted', '1');
          var label = node.getAttribute('data-count-label') || node.textContent || '';
          if (reduce) {
            node.textContent = label;
            return;
          }
          var started = performance.now();
          var format = new Intl.NumberFormat(document.documentElement.lang || 'en');
          function frame(now) {
            var progress = Math.min(1, (now - started) / 720);
            var eased = 1 - Math.pow(1 - progress, 3);
            node.textContent = progress >= 1 ? label : format.format(Math.round(target * eased));
            if (progress < 1) requestAnimationFrame(frame);
          }
          requestAnimationFrame(frame);
        }
        function arm(node) {
          show(node);
          if (node.hasAttribute('data-count')) countUp(node);
          var stats = node.querySelectorAll('[data-count]');
          for (var i = 0; i < stats.length; i += 1) countUp(stats[i]);
        }
        if (reduce || !nodes.length) {
          for (var i = 0; i < nodes.length; i += 1) arm(nodes[i]);
          return;
        }
        if (!('IntersectionObserver' in window)) {
          document.documentElement.classList.add('motion');
          for (var j = 0; j < nodes.length; j += 1) arm(nodes[j]);
          return;
        }
        var pending = nodes.slice();
        var observer = new IntersectionObserver(function (entries) {
          for (var n = 0; n < entries.length; n += 1) {
            if (!entries[n].isIntersecting) continue;
            arm(entries[n].target);
            observer.unobserve(entries[n].target);
          }
        }, { rootMargin: '0px 0px -4% 0px', threshold: 0 });
        document.documentElement.classList.add('motion');
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            for (var k = 0; k < pending.length; k += 1) {
              var rect = pending[k].getBoundingClientRect();
              if (rect.bottom > 0 && rect.top < window.innerHeight * 0.96) arm(pending[k]);
              else observer.observe(pending[k]);
            }
          });
        });
        window.addEventListener('load', function () {
          for (var k = 0; k < pending.length; k += 1) {
            if (pending[k].classList.contains('inview')) continue;
            var rect = pending[k].getBoundingClientRect();
            if (rect.bottom > 0 && rect.top < window.innerHeight) arm(pending[k]);
          }
        });
      })();
    </script>
  </body>
</html>
