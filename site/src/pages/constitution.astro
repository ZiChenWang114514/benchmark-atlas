---
import Base from '../layouts/Base.astro';
import { loadConstitution } from '../lib/content';

const constitution = loadConstitution();
---
<Base
  title="收集宪法"
  description="Benchmark 数据库收集宪法：真实性、来源等级、介绍页的十一节，以及更新和呈现方式。"
  active="constitution"
>
  <div class="wrap page-hero">
    <h1>{constitution.title}</h1>
    <p class="lede">这是入库时遵守的规则。页面按仓库里的 CONSTITUTION.md 生成，不另写一套口径。</p>
  </div>
  <div class="wrap doc-layout">
    <nav class="toc" aria-label="宪法章节">
      <p>章节</p>
      {constitution.toc.map((item) => <a href={`#${item.id}`}>{item.text}</a>)}
    </nav>
    <article class="prose" set:html={constitution.html} />
  </div>
  <script>
    import { bindToc } from '../scripts/toc';
    const nav = document.querySelector('.toc');
    if (nav) bindToc(nav);
  </script>
</Base>
