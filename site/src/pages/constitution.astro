---
import Base from '../layouts/Base.astro';
import { currentLocale, t } from '../i18n';
import { loadConstitution } from '../lib/content';

const locale = currentLocale();
const constitution = loadConstitution();
---
<Base
  title={t(locale, 'constitution.title')}
  description={t(locale, 'constitution.description')}
  active="constitution"
>
  <div class="wrap page-hero">
    <h1>Benchmark Constitution</h1>
    <p class="lede">{t(locale, 'constitution.lede')}</p>
  </div>
  <div class="wrap doc-layout">
    <nav class="toc" aria-label={t(locale, 'constitution.toc')}>
      <p>{t(locale, 'constitution.toc')}</p>
      {constitution.toc.map((item) => <a href={`#${item.id}`}>{item.text}</a>)}
    </nav>
    <article class="prose" set:html={constitution.html} />
  </div>
  <script>
    import { bindToc } from '../scripts/toc';
    const nav = document.querySelector('.toc');
    if (nav) bindToc(nav);
  </script>
</Base>
