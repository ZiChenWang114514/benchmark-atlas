---
import Base from '../layouts/Base.astro';
import HeatLegend from '../components/HeatLegend.astro';
import TrendItem from '../components/TrendItem.astro';
import { visualCopy } from '../i18n/visual';
import {
  allTags,
  benchmarksMentioned,
  loadIndex,
  loadNews,
  loadRecords,
  loadTrending,
  newsWhen,
  sectionGroups,
  trendingViews,
} from '../lib/data';
import { loadHeat, loadImpact } from '../lib/boards';
import { dateStamp, displayName, page, publicText, safeUrl, textValue, tone } from '../lib/format';

const ui = visualCopy('zh');
const index = loadIndex();
const records = loadRecords();
const news = loadNews();
const { groups } = sectionGroups(records);
const tags = allTags(records);
const chips = ['全部', ...groups.map((group) => group.id)];
const [lead, ...rest] = news;
const catalog = records.map((record) => record.index);
const trending = loadTrending();
const hotList = trendingViews();
const hotBySlug = new Map(hotList.map((item) => [item.slug, item]));
const hotPreview = hotList.slice(0, 6);
const heat = loadHeat();
const impact = loadImpact();
const known = new Set(records.map((record) => record.index.id));
const heatTop = (heat?.ranking ?? []).slice(0, 5);
const impactTop = (impact?.ranking ?? []).filter((row) => row.score != null).slice(0, 5);
const stamp = dateStamp(index.generated_at);
const windowText = trending.window?.from && trending.window?.through ? `${trending.window.from} 至 ${trending.window.through}` : '';
const stats = [
  { href: '#browse', label: ui.statDossiers, value: records.length },
  { href: '#news', label: ui.statNews, value: news.length },
  impact ? { href: page('impact'), label: ui.statRanked, value: impact.ranking.length } : null,
  heat ? { href: page('frontier-heat'), label: ui.statHeat, value: heat.ranking.length } : null,
].filter((item): item is { href: string; label: string; value: number } => !!item);

function hostOf(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return '来源';
  }
}
function pct(value: number): number {
  return Math.max(0, Math.min(100, value));
}
---
<Base
  title="Benchmark Constitution"
  description="自然科学 AI benchmark 图鉴。首页是最新动态和分板块档案，每条事实保留来源；没核验完的标明待核实。"
  active="home"
>
  <div class="wrap">
    <header class="masthead">
      <h1>Benchmark Constitution</h1>
      <p class="lede">追踪值得读的科学评测，而不只追逐分数。每条事实带来源和访问日期；没有核验完的，标明待核实。</p>
      <p class="meta-row">
        {stamp && <span>{ui.snapshot} {stamp}</span>}
        <span>{records.length} 则档案</span>
        <a href={page('constitution')}>收录范围与真实性原则见《收集宪法》</a>
      </p>
    </header>

    <div class="stat-row">
      {stats.map((item) => (
        <a class="stat" href={item.href}>
          <span>{item.label}</span>
          <strong>{new Intl.NumberFormat('zh-Hans').format(item.value)}</strong>
        </a>
      ))}
    </div>

    <section class="section" id="news" aria-labelledby="news-title">
      <header class="flag">
        <h2 id="news-title">最新动态</h2>
        <p>观察日不等于事件发生日</p>
      </header>
      {news.length === 0 ? (
        <p>这一期还没有动态。</p>
      ) : (
        <div class="home-split">
          <div>
            {lead && (
              <article class="news-lead" data-news>
                {lead.type && <p class="kicker">{lead.type}</p>}
                <h3>{lead.title}</h3>
                <p class="when">{newsWhen(lead)}</p>
                <p class="news-body">{publicText(lead.body)}</p>
                <p class="news-links">
                  {lead.sources.map((source) => safeUrl(source.url) && (
                    <a href={source.url} target="_blank" rel="noopener noreferrer">{hostOf(source.url)}</a>
                  ))}
                  {benchmarksMentioned(`${lead.title}\n${lead.body}`, catalog).map((item) => (
                    <a class="dossier-link" href={page(`benchmarks/${item.id}`)}><span>{ui.dossierLink}</span><span>{item.name}</span></a>
                  ))}
                </p>
              </article>
            )}
            {rest.length > 0 && (
              <div class="news-rest">
                {rest.map((item) => (
                  <article class="news-item" data-news>
                    {item.type && <p class="kicker">{item.type}</p>}
                    <h3>{item.title}</h3>
                    <p class="when">{newsWhen(item)}</p>
                    <p class="news-body">{publicText(item.body)}</p>
                    <p class="news-links">
                      {item.sources.map((source) => safeUrl(source.url) && (
                        <a href={source.url} target="_blank" rel="noopener noreferrer">{hostOf(source.url)}</a>
                      ))}
                      {benchmarksMentioned(`${item.title}\n${item.body}`, catalog).map((match) => (
                        <a class="dossier-link" href={page(`benchmarks/${match.id}`)}><span>{ui.dossierLink}</span><span>{match.name}</span></a>
                      ))}
                    </p>
                  </article>
                ))}
              </div>
            )}
          </div>
          <aside>
            {impactTop.length > 0 && (
              <section class="rail" aria-labelledby="rail-impact">
                <h2 id="rail-impact"><a href={page('impact')}>学术影响力榜</a></h2>
                {impactTop.map((row) => {
                  const href = known.has(row.id) ? page(`benchmarks/${row.id}`) : page('impact');
                  const score = row.score ?? 0;
                  return (
                    <a class="rail-row" href={href}>
                      <span class:list={['rank-no', row.rank != null && row.rank <= 3 && `podium-${row.rank}`]}>{row.rank}</span>
                      <span class="rail-name">{displayName(row.name)}</span>
                      <span class="rail-score">
                        <span class="num">{score.toFixed(1)}</span>
                        <span class="track" aria-hidden="true"><span style={`width:${pct(score)}%`}></span></span>
                      </span>
                    </a>
                  );
                })}
              </section>
            )}
            {heatTop.length > 0 && heat && (
              <section class="rail" aria-labelledby="rail-heat">
                <h2 id="rail-heat"><a href={page('frontier-heat')}>业界热度榜</a></h2>
                {heatTop.map((row) => {
                  const href = known.has(row.benchmark_id) ? page(`benchmarks/${row.benchmark_id}`) : page('frontier-heat');
                  const share = typeof row.share === 'number' ? row.share : (heat.models.length ? row.count / heat.models.length : 0);
                  return (
                    <a class="rail-row" href={href}>
                      <span class:list={['rank-no', row.rank <= 3 && `podium-${row.rank}`]}>{row.rank}</span>
                      <span class="rail-name">{displayName(row.name)}</span>
                      <span class="rail-score">
                        <span class="num">{row.count}</span>
                        <span class="track" aria-hidden="true"><span style={`width:${pct(share * 100)}%`}></span></span>
                      </span>
                    </a>
                  );
                })}
              </section>
            )}
          </aside>
        </div>
      )}
    </section>

    <section class="section" id="trending" aria-labelledby="trending-title">
      <header class="flag">
        <h2 id="trending-title">近期热门</h2>
        <p class="inline-meta">
          {windowText && <span>{windowText}</span>}
          <a href={page('trending')}>全部 {hotList.length} 条</a>
        </p>
      </header>
      <HeatLegend />
      <div class="trend-grid">
        {hotPreview.map((item) => <TrendItem item={item} showWhat={false} />)}
      </div>
    </section>

    <section class="section" id="sections" aria-labelledby="sections-title">
      <header class="flag">
        <h2 id="sections-title">按板块看</h2>
        <p>主板块有条目才出现在这里</p>
      </header>
      <nav class="section-index" aria-label="板块">
        {groups.map((group) => (
          <a href={`#sec-${group.id}`}>
            <span>{group.id}</span>
            <strong>{group.items.length}</strong>
            <small>{group.blurb}</small>
          </a>
        ))}
      </nav>
      <p class="index-note">十二个板块按收录顺序列出，数字是该板块的条目数。跨学科基准只计入一个主板块，其他学科用标签找回来。标了「2026下半年仍被引用」的，索引里有对应引用证据。</p>
    </section>

    <section class="section" id="browse" aria-labelledby="browse-title">
      <header class="flag">
        <h2 id="browse-title">搜索与筛选</h2>
        <p id="result-count">本批 {records.length} 个基准，当前显示 {records.length} 个</p>
      </header>
      <form id="browse-form" class="browse-form" role="search" action={page()} method="get">
        <label class="sr-only" for="q">搜索基准</label>
        <input id="q" class="search" name="q" type="search" placeholder="搜索名称、任务或标签，例如 GPQA、分子、天气" autocomplete="off" enterkeyhint="search" />
        <div class="chips" role="group" aria-label="板块筛选">
          {chips.map((chip) => (
            <button type="button" class="chip" data-section-chip={chip} aria-pressed={chip === '全部' ? 'true' : 'false'}>{chip}</button>
          ))}
        </div>
        <div class="controls">
          <label class="sel" for="tag">标签
            <select id="tag" name="tag">
              <option value="">全部标签</option>
              {tags.map((tag) => <option value={tag}>{tag}</option>)}
            </select>
          </label>
          <label class="sel" for="sort">排列
            <select id="sort" name="sort">
              <option value="section">板块顺序</option>
              <option value="name">名称</option>
              <option value="date">同板块内较新</option>
            </select>
          </label>
          <button type="button" class="ghost" id="reset">重置</button>
        </div>
      </form>
      <noscript><p class="note">筛选和排序需要脚本。不启用时，下面仍按板块列出全部基准。</p></noscript>
      <p id="empty" class="empty" hidden>没有符合的基准。换一个词，或重置筛选。</p>
    </section>

    {groups.map((group) => (
      <section class="group" id={`sec-${group.id}`} data-group={group.id} aria-labelledby={`heading-${group.id}`}>
        <header class="group-head">
          <div>
            <h2 id={`heading-${group.id}`}>{group.id}</h2>
            <p>{group.blurb}</p>
          </div>
          <p>{group.items.length} 个基准</p>
        </header>
        <div class="card-grid" data-grid>
          {group.items.map((record) => {
            const size = textValue(record.file.data_format.size);
            const release = textValue(record.file.basic_info.release_date);
            const extra = record.index.tags.filter((tag) => tag !== record.index.section);
            return (
              <a
                class="card"
                data-card
                data-section={record.index.section}
                data-name={record.index.name}
                data-date={record.date}
                data-order={record.order}
                data-tags={record.index.tags.join('|')}
                data-search={record.search}
                href={page(`benchmarks/${record.index.id}`)}
                style={`--tone:${tone(record.index.section)}`}
              >
                <span class="card-section">
                  <span class="domain-tag">{record.index.section}</span>
                  {record.index.cited_2026h2 && <span class="badge badge-cite">2026下半年仍被引用</span>}
                  {hotBySlug.get(record.index.id) && (
                    <span class="badge badge-hot">🔥 近期热门 {hotBySlug.get(record.index.id)?.heat_confidence}</span>
                  )}
                </span>
                <h3>{record.index.name}</h3>
                <p class="card-summary">{publicText(record.index.summary)}</p>
                {size && <p class="card-size">{size === '待核实' || size === '未公开' ? `规模${size}` : size}</p>}
                {extra.length > 0 && <p class="card-tags">同时涉及 {extra.join('、')}</p>}
                <p class="card-foot">
                  <span>{release ? `发布 ${release}` : '发布日期待核实'}</span>
                </p>
              </a>
            );
          })}
        </div>
      </section>
    ))}
    <div id="tail"></div>
  </div>
  <script>
    import '../scripts/browse.ts';
  </script>
</Base>
