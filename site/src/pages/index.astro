---
import Base from '../layouts/Base.astro';
import HeatLegend from '../components/HeatLegend.astro';
import TrendItem from '../components/TrendItem.astro';
import { currentLocale, t } from '../i18n';
import { visualCopy } from '../i18n/visual';
import { sectionLabel, sectionSlug } from '../lib/sections';
import {
  allTags,
  benchmarksMentioned,
  loadIndex,
  loadNews,
  loadRecords,
  loadTrending,
  newsWhen,
  sectionGroups,
  trendingViews,
} from '../lib/data';
import { loadHeat, loadImpact } from '../lib/boards';
import { dateStamp, page, publicText, safeUrl, textValue, tone } from '../lib/format';

const locale = currentLocale();
const ui = visualCopy(locale);
const index = loadIndex();
const records = loadRecords();
const news = loadNews();
const { groups } = sectionGroups(records);
const tags = allTags(records);
const chips = [{ id: 'all', label: t(locale, 'home.all_sections') }, ...groups.map((group) => ({ id: sectionSlug(group.id), label: sectionLabel(group.id, locale) }))];
const [lead, ...rest] = news;
const catalog = records.map((record) => record.index);
const trending = loadTrending();
const hotList = trendingViews();
const hotBySlug = new Map(hotList.map((item) => [item.slug, item]));
const hotPreview = hotList.slice(0, 6);
const heat = loadHeat();
const impact = loadImpact();
const known = new Set(records.map((record) => record.index.id));
const heatTop = (heat?.ranking ?? []).slice(0, 5);
const impactTop = (impact?.ranking ?? []).filter((row) => row.score != null).slice(0, 5);
const stamp = dateStamp(index.generated_at);
const windowText = trending.window?.from && trending.window?.through ? t(locale, 'home.window', { from: trending.window.from, through: trending.window.through }) : '';
const stats = [
  { href: '#browse', label: ui.statDossiers, value: records.length },
  { href: '#news', label: ui.statNews, value: news.length },
  impact ? { href: page('impact'), label: ui.statRanked, value: impact.ranking.length } : null,
  heat ? { href: page('frontier-heat'), label: ui.statHeat, value: heat.ranking.length } : null,
].filter((item): item is { href: string; label: string; value: number } => !!item);

function hostOf(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return t(locale, 'home.source');
  }
}
function pct(value: number): number {
  return Math.max(0, Math.min(100, value));
}
---
<Base
  title="Benchmark Constitution"
  description={t(locale, 'home.description')}
  active="home"
>
  <div class="wrap">
    <header class="masthead">
      <h1>Benchmark Constitution</h1>
      <p class="lede">{t(locale, 'home.lede')}</p>
      <p class="meta-row">
        {stamp && <span>{ui.snapshot} {stamp}</span>}
        <span>{t(locale, 'home.records', { n: records.length })}</span>
        <a href={page('constitution')}>{t(locale, 'home.constitution_link')}</a>
      </p>
    </header>

    <div class="stat-row">
      {stats.map((item) => (
        <a class="stat" href={item.href}>
          <span>{item.label}</span>
          <strong>{new Intl.NumberFormat(locale === 'zh' ? 'zh-Hans' : 'en').format(item.value)}</strong>
        </a>
      ))}
    </div>

    <section class="section" id="news" aria-labelledby="news-title">
      <header class="flag">
        <h2 id="news-title">{t(locale, 'home.news')}</h2>
        <p>{t(locale, 'home.news_note')}</p>
      </header>
      {news.length === 0 ? (
        <p>{t(locale, 'home.news_empty')}</p>
      ) : (
        <div class="home-split">
          <div>
            {lead && (
              <article class="news-lead" data-news>
                {lead.type && <p class="kicker">{lead.type}</p>}
                <h3>{lead.title}</h3>
                <p class="when">{newsWhen(lead)}</p>
                <p class="news-body">{publicText(lead.body)}</p>
                <p class="news-links">
                  {lead.sources.map((source) => safeUrl(source.url) && (
                    <a href={source.url} target="_blank" rel="noopener noreferrer">{hostOf(source.url)}</a>
                  ))}
                  {benchmarksMentioned(`${lead.title}\n${lead.body}`, catalog).map((item) => (
                    <a class="dossier-link" href={page(`benchmarks/${item.id}`)}><span>{ui.dossierLink}</span><span>{item.name}</span></a>
                  ))}
                </p>
              </article>
            )}
            {rest.length > 0 && (
              <div class="news-rest">
                {rest.map((item) => (
                  <article class="news-item" data-news>
                    {item.type && <p class="kicker">{item.type}</p>}
                    <h3>{item.title}</h3>
                    <p class="when">{newsWhen(item)}</p>
                    <p class="news-body">{publicText(item.body)}</p>
                    <p class="news-links">
                      {item.sources.map((source) => safeUrl(source.url) && (
                        <a href={source.url} target="_blank" rel="noopener noreferrer">{hostOf(source.url)}</a>
                      ))}
                      {benchmarksMentioned(`${item.title}\n${item.body}`, catalog).map((match) => (
                        <a class="dossier-link" href={page(`benchmarks/${match.id}`)}><span>{ui.dossierLink}</span><span>{match.name}</span></a>
                      ))}
                    </p>
                  </article>
                ))}
              </div>
            )}
          </div>
          <aside>
            {impactTop.length > 0 && (
              <section class="rail" aria-labelledby="rail-impact">
                <h2 id="rail-impact"><a href={page('impact')}>{t(locale, 'nav.impact')}</a></h2>
                {impactTop.map((row) => {
                  const href = known.has(row.id) ? page(`benchmarks/${row.id}`) : page('impact');
                  const score = row.score ?? 0;
                  return (
                    <a class="rail-row" href={href}>
                      <span class:list={['rank-no', row.rank != null && row.rank <= 3 && `podium-${row.rank}`]}>{row.rank}</span>
                      <span class="rail-name">{row.name}</span>
                      <span class="rail-score">
                        <span class="num">{score.toFixed(1)}</span>
                        <span class="track" aria-hidden="true"><span style={`width:${pct(score)}%`}></span></span>
                      </span>
                    </a>
                  );
                })}
              </section>
            )}
            {heatTop.length > 0 && heat && (
              <section class="rail" aria-labelledby="rail-heat">
                <h2 id="rail-heat"><a href={page('frontier-heat')}>{t(locale, 'nav.heat')}</a></h2>
                {heatTop.map((row) => {
                  const href = known.has(row.benchmark_id) ? page(`benchmarks/${row.benchmark_id}`) : page('frontier-heat');
                  const share = typeof row.share === 'number' ? row.share : (heat.models.length ? row.count / heat.models.length : 0);
                  return (
                    <a class="rail-row" href={href}>
                      <span class:list={['rank-no', row.rank <= 3 && `podium-${row.rank}`]}>{row.rank}</span>
                      <span class="rail-name">{row.name}</span>
                      <span class="rail-score">
                        <span class="num">{row.count}</span>
                        <span class="track" aria-hidden="true"><span style={`width:${pct(share * 100)}%`}></span></span>
                      </span>
                    </a>
                  );
                })}
              </section>
            )}
          </aside>
        </div>
      )}
    </section>

    <section class="section" id="trending" aria-labelledby="trending-title">
      <header class="flag">
        <h2 id="trending-title">{t(locale, 'home.trending')}</h2>
        <p class="inline-meta">
          {windowText && <span>{windowText}</span>}
          <a href={page('trending')}>{t(locale, 'home.all_trending', { n: hotList.length })}</a>
        </p>
      </header>
      <HeatLegend />
      <div class="trend-grid">
        {hotPreview.map((item) => <TrendItem item={item} showWhat={false} />)}
      </div>
    </section>

    <section class="section" id="sections" aria-labelledby="sections-title">
      <header class="flag">
        <h2 id="sections-title">{t(locale, 'home.sections')}</h2>
        <p>{t(locale, 'home.sections_note')}</p>
      </header>
      <nav class="section-index" aria-label={t(locale, 'home.sections_aria')}>
        {groups.map((group) => (
          <a href={`#sec-${sectionSlug(group.id)}`}>
            <span>{sectionLabel(group.id, locale)}</span>
            <strong>{group.items.length}</strong>
            <small>{group.blurb}</small>
          </a>
        ))}
      </nav>
      <p class="index-note">{t(locale, 'home.index_note')}</p>
    </section>

    <section class="section" id="browse" aria-labelledby="browse-title">
      <header class="flag">
        <h2 id="browse-title">{t(locale, 'home.browse')}</h2>
        <p id="result-count">{t(locale, 'home.count', { total: records.length, shown: records.length })}</p>
      </header>
      <form id="browse-form" class="browse-form" role="search" action={page()} method="get" data-all="all" data-locale={locale} data-count-template={t(locale, 'home.count', { total: '{total}', shown: '{shown}' })}>
        <label class="sr-only" for="q">{t(locale, 'home.search_label')}</label>
        <input id="q" class="search" name="q" type="search" placeholder={t(locale, 'home.search_placeholder')} autocomplete="off" enterkeyhint="search" />
        <div class="chips" role="group" aria-label={t(locale, 'home.chips_aria')}>
          {chips.map((chip) => (
            <button type="button" class="chip" data-section-chip={chip.id} aria-pressed={chip.id === 'all' ? 'true' : 'false'}>{chip.label}</button>
          ))}
        </div>
        <div class="controls">
          <label class="sel" for="tag">{t(locale, 'home.tag')}
            <select id="tag" name="tag">
              <option value="">{t(locale, 'home.all_tags')}</option>
              {tags.map((tag) => <option value={tag}>{tag}</option>)}
            </select>
          </label>
          <label class="sel" for="sort">{t(locale, 'home.sort')}
            <select id="sort" name="sort">
              <option value="section">{t(locale, 'home.sort_section')}</option>
              <option value="name">{t(locale, 'home.sort_name')}</option>
              <option value="date">{t(locale, 'home.sort_date')}</option>
            </select>
          </label>
          <button type="button" class="ghost" id="reset">{t(locale, 'home.reset')}</button>
        </div>
      </form>
      <noscript><p class="note">{t(locale, 'home.noscript')}</p></noscript>
      <p id="empty" class="empty" hidden>{t(locale, 'home.empty')}</p>
    </section>

    {groups.map((group) => (
      <section class="group" id={`sec-${sectionSlug(group.id)}`} data-group={sectionSlug(group.id)} aria-labelledby={`heading-${sectionSlug(group.id)}`}>
        <header class="group-head">
          <div>
            <h2 id={`heading-${sectionSlug(group.id)}`}>{sectionLabel(group.id, locale)}</h2>
            <p>{group.blurb}</p>
          </div>
          <p>{t(locale, 'home.benchmarks_count', { n: group.items.length })}</p>
        </header>
        <div class="card-grid" data-grid>
          {group.items.map((record) => {
            const size = textValue(record.file.data_format.size);
            const release = textValue(record.file.basic_info.release_date);
            const extra = record.index.tags.filter((tag) => tag !== record.index.section);
            return (
              <a
                class="card"
                data-card
                data-section={sectionSlug(record.index.section)}
                data-name={record.index.name}
                data-date={record.date}
                data-order={record.order}
                data-tags={record.index.tags.join('|')}
                data-search={record.search}
                href={page(`benchmarks/${record.index.id}`)}
                style={`--tone:${tone(record.index.section)}`}
              >
                <span class="card-section">
                  <span class="domain-tag">{sectionLabel(record.index.section, locale)}</span>
                  {record.index.cited_2026h2 && <span class="badge badge-cite">{t(locale, 'home.cited')}</span>}
                  {hotBySlug.get(record.index.id) && (
                    <span class="badge badge-hot">🔥 {t(locale, 'home.hot', { grade: hotBySlug.get(record.index.id)?.heat_confidence ?? '' })}</span>
                  )}
                </span>
                <h3>{record.index.name}</h3>
                <p class="card-summary">{publicText(record.index.summary)}</p>
                {size && <p class="card-size">{size === '待核实' || size === '未公开' || size === 'Unverified' || size === 'Not disclosed' ? t(locale, 'home.size_status', { status: size }) : size}</p>}
                {extra.length > 0 && <p class="card-tags">{t(locale, 'home.also', { tags: extra.join(t(locale, 'value.join')) })}</p>}
                <p class="card-foot">
                  <span>{release ? t(locale, 'home.released', { date: release }) : t(locale, 'home.release_unverified')}</span>
                </p>
              </a>
            );
          })}
        </div>
      </section>
    ))}
    <div id="tail"></div>
  </div>
  <script>
    import '../scripts/browse.ts';
  </script>
</Base>
