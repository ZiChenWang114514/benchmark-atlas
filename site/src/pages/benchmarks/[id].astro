---
import Base from '../../layouts/Base.astro';
import Chapter from '../../components/Chapter.astro';
import Timeline from '../../components/Timeline.astro';
import { currentLocale, t } from '../../i18n';
import { impactById, loadHeat, loadImpact } from '../../lib/boards';
import { profileHtml, profileParts } from '../../lib/profile';
import { CHAPTERS } from '../../lib/chapters';
import { sectionLabel, sectionSlug } from '../../lib/sections';
import { loadNews, loadRecords, newsForBenchmark, trendingFor, type BenchmarkFile } from '../../lib/data';
import {
  PENDING_EXPLANATION,
  badgeClass,
  isField,
  labelFor,
  orderedEntries,
  displayName,
  page,
  publicText,
  safeUrl,
  hasPublicValue,
  isStatusWord,
  notableNote,
  statusOf,
  textValue,
  type Field,
} from '../../lib/format';

export function getStaticPaths() {
  return loadRecords().map((record) => ({ params: { id: record.index.id } }));
}

const locale = currentLocale();
const id = Astro.params.id;
const records = loadRecords();
const record = records.find((item) => item.index.id === id);
if (!record || !id) throw new Error(`缺少基准 ${id}`);
const file: BenchmarkFile = record.file;
const news = newsForBenchmark(record, loadNews(), records.map((item) => item.index));
const siblings = records.filter((item) => item.index.section === record.index.section);
const place = siblings.findIndex((item) => item.index.id === record.index.id);
const previous = siblings[place - 1];
const following = siblings[place + 1];

const sections: Record<string, Record<string, Field>> = {
  basic_info: file.basic_info,
  organization: file.organization,
  design_goals: file.design_goals,
  construction: file.construction,
  data_format: file.data_format,
  evaluation: file.evaluation,
  latest_status: file.latest_status,
  leaderboard: file.leaderboard,
  contact: file.contact,
  original_files: { ...file.original_files, drive_pdf: file.drive_pdf },
};

function entriesFor(chapterId: string, keys: string[]) {
  if (chapterId === 'changelog') return [{ label: '', name: 'changelog', field: file.changelog }];
  return orderedEntries(sections[chapterId], keys).map((entry) => ({
    label: labelFor(entry.name),
    name: entry.name,
    field: entry.field,
  }));
}

const known = new Set([...Object.keys(sections), 'changelog', 'id', 'schema_version', 'editorial_status', 'drive_pdf']);
const extras = Object.entries(file).filter((entry): entry is [string, Field] => !known.has(entry[0]) && isField(entry[1]));

function external(field: Field | undefined): string | null {
  return typeof field?.value === 'string' ? safeUrl(field.value) : null;
}
const versionStatus = statusOf(file.basic_info.version);
const links = [
  [t(locale, 'detail.paper_link'), external(file.basic_info.paper_url)],
  [t(locale, 'detail.code'), external(file.basic_info.code_url)],
  [t(locale, 'detail.dataset'), external(file.basic_info.dataset_url)],
  [t(locale, 'detail.homepage'), external(file.basic_info.official_homepage)],
].filter((item): item is [string, string] => typeof item[1] === 'string');

function host(url: string): string {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return t(locale, 'home.source');
  }
}
const summary = publicText(record.index.summary);
const hot = trendingFor(record.index.id);
const impactFile = loadImpact();
const impactRow = impactById(record.index.id);
const impactWeights = new Map((impactFile?.dimensions ?? []).map((dimension) => [dimension.key, dimension.weight]));
const profileTitle = t(locale, 'detail.profile');
const profilePartsView = impactRow
  ? profileParts(impactRow.components, impactWeights, impactRow.assessment_review).map((part) => ({
      label: t(locale, `impact.part.${part.id}`),
      value: part.value,
      note: part.id === 'penalties' ? t(locale, 'impact.part.penalties_note') : '',
    }))
  : [];
const profileMarkup = profilePartsView.length >= 3
  ? profileHtml(profilePartsView, profileTitle, t(locale, 'detail.profile_aria', { name: record.index.name }))
  : '';
const heatFile = loadHeat();
const heatRow = heatFile?.ranking.find((row) => row.benchmark_id === record.index.id);
const heatNames = new Map((heatFile?.models ?? []).map((model) => [model.id, model.name]));
const domainPeers = (impactFile?.ranking ?? [])
  .filter((row) => row.domain === impactRow?.domain && typeof row.score === 'number')
  .sort((a, b) => (b.score ?? 0) - (a.score ?? 0));
const peerShown = domainPeers.slice(0, 8);
if (impactRow && typeof impactRow.score === 'number' && !peerShown.some((row) => row.id === impactRow.id)) {
  peerShown.splice(7, 1, impactRow);
}
const peerMax = Math.max(1, ...peerShown.map((row) => row.score ?? 0));
const percentile = impactRow && typeof impactRow.score === 'number' && domainPeers.length > 1
  ? Math.round((domainPeers.filter((row) => (row.score ?? 0) < (impactRow.score ?? 0)).length / (domainPeers.length - 1)) * 100)
  : null;
function pendingOnly(field: Field): boolean {
  return !hasPublicValue(field) && !notableNote(field);
}
function pendingStatus(field: Field): string {
  return statusOf(field) || (isStatusWord(field.value) ? String(field.value) : t(locale, 'status.unverified'));
}
const chapterViews = CHAPTERS.map((chapter) => {
  const entries = entriesFor(chapter.id, chapter.keys);
  return {
    chapter,
    shown: entries.filter((entry) => !pendingOnly(entry.field)),
    hidden: entries.filter((entry) => pendingOnly(entry.field)),
  };
});
const extraViews = extras.map(([key, field]) => {
  const entry = { label: labelFor(key), name: key, field };
  return pendingOnly(field)
    ? { key, shown: null, hidden: entry }
    : { key, shown: entry, hidden: null };
});
const pendingGroups = [
  ...chapterViews.filter((view) => view.hidden.length > 0).map((view) => ({
    title: t(locale, `chapter.${view.chapter.id}.title`),
    entries: view.hidden,
  })),
  ...extraViews.filter((view) => view.hidden).map((view) => ({
    title: view.hidden?.label || '',
    entries: view.hidden ? [view.hidden] : [],
  })),
];

function dated(value: string | null | undefined): string {
  if (!value) return '';
  const text = value.trim();
  if (!text || text === '待核实' || text === 'Unverified' || text === '未公开' || text === 'Not disclosed') return '';
  const match = /^(\d{4})(?:[-/.](\d{2})(?:[-/.](\d{2}))?)?/.exec(text);
  if (!match) return '';
  if (match[3]) return `${match[1]}-${match[2]}-${match[3]}`;
  if (match[2]) return `${match[1]}-${match[2]}`;
  return match[1];
}
const timeline = [
  ...[dated(textValue(file.basic_info.release_date))].filter(Boolean).map((date) => ({ date, label: t(locale, 'field.release_date') })),
  ...news.flatMap((item) => {
    const date = dated(item.event_date) || dated(item.observed_date);
    return date ? [{ date, label: t(locale, 'detail.event_news'), text: item.title }] : [];
  }),
  ...[dated(record.index.last_checked)].filter(Boolean).map((date) => ({ date, label: t(locale, 'field.checked_at') })),
].sort((a, b) => a.date.localeCompare(b.date) || a.label.localeCompare(b.label, locale === 'zh' ? 'zh' : 'en'));
---
<Base title={record.index.name} description={summary} active="home">
  <div class="wrap detail-layout">
    <nav class="toc" aria-label={t(locale, 'detail.toc_aria')}>
      <p>{t(locale, 'detail.chapters')}</p>
      {CHAPTERS.map((chapter) => <a href={`#${chapter.id}`}>{t(locale, `chapter.${chapter.id}.title`)}</a>)}
      {extras.map(([key]) => <a href={`#extra-${key}`}>{labelFor(key)}</a>)}
    </nav>
    <article class="record">
      <header class="dossier-hero">
        <p class="crumbs inline-meta">
          <a href={page()}>{t(locale, 'detail.contents')}</a>
          <a href={`${page()}#sec-${sectionSlug(record.index.section)}`}>{sectionLabel(record.index.section, locale)}</a>
        </p>
        <div class="dossier-kicker">
          <span class="domain-tag">{sectionLabel(record.index.section, locale)}</span>
          {record.index.cited_2026h2 && <span class="badge badge-cite">{t(locale, 'home.cited')}</span>}
          {hot && <span class="badge badge-hot">🔥 {t(locale, 'home.hot', { grade: hot.heat_confidence })}</span>}
        </div>
        <h1>{record.index.name}</h1>
        {textValue(file.basic_info.full_name) && textValue(file.basic_info.full_name) !== record.index.name && (
          <p class="subhead">{textValue(file.basic_info.full_name)}</p>
        )}
        <p class="lede">{summary}</p>
        <dl class="fact-grid">
          <div>
            <dt>{t(locale, 'field.release_date')}</dt>
            <dd>{textValue(file.basic_info.release_date) || t(locale, 'status.unverified')}</dd>
          </div>
          <div>
            <dt>{t(locale, 'detail.paper_link')}</dt>
            <dd>{textValue(file.basic_info.paper_version) || t(locale, 'status.unverified')}</dd>
          </div>
          <div>
            <dt>{t(locale, 'detail.version')}</dt>
            <dd>{versionStatus ? <span class:list={['badge', badgeClass(versionStatus)]}>{versionStatus}</span> : (textValue(file.basic_info.version) || t(locale, 'status.unverified'))}</dd>
          </div>
          {record.index.last_checked && (
            <div>
              <dt>{t(locale, 'field.checked_at')}</dt>
              <dd>{record.index.last_checked}</dd>
            </div>
          )}
        </dl>
        <div class="actions">
          {links.map(([label, href]) => <a class="action" href={href} target="_blank" rel="noopener noreferrer">{label}</a>)}
        </div>
        {(impactRow?.score != null || peerShown.length > 1 || heatFile) && (
          <div class="lead-charts">
            {impactRow?.score != null && (
              <section class="viz-card" aria-label={t(locale, 'detail.score_label')}>
                <h2>{t(locale, 'detail.score_label')}</h2>
                <p class="gauge-num">{impactRow.score.toFixed(1)}</p>
                {percentile != null && <p class="gauge-note">{t(locale, 'detail.percentile', { n: percentile, domain: sectionLabel(record.index.section, locale) })}</p>}
                <svg class="gauge" viewBox="0 0 120 64" role="img" aria-label={t(locale, 'detail.score_label')}>
                  <path d="M12 54 A 48 48 0 0 1 108 54" fill="none" stroke="#efe4cc" stroke-width="8" stroke-linecap="round" />
                  <path d="M12 54 A 48 48 0 0 1 108 54" fill="none" stroke="#e8b423" stroke-width="8" stroke-linecap="round" pathLength="100" stroke-dasharray={`${Math.max(0, Math.min(100, impactRow.score))} 100`} />
                </svg>
              </section>
            )}
            {impactRow && typeof impactRow.score === 'number' && peerShown.length > 1 && (
              <section class="viz-card" aria-label={t(locale, 'detail.peers', { domain: sectionLabel(record.index.section, locale) })}>
                <h2>{t(locale, 'detail.peers', { domain: sectionLabel(record.index.section, locale) })}</h2>
                <ol class="peer-bars">
                  {peerShown.map((row) => (
                    <li class:list={[row.id === record.index.id && 'is-self']}>
                      <span>{displayName(row.name)}</span>
                      <span class="track" aria-hidden="true"><span style={`width:${((row.score ?? 0) / peerMax) * 100}%`}></span></span>
                      <b class="num">{(row.score ?? 0).toFixed(1)}</b>
                    </li>
                  ))}
                </ol>
              </section>
            )}
            {heatFile && (
              <section class="viz-card" aria-label={t(locale, 'detail.heat_panel')}>
                <h2>{t(locale, 'detail.heat_panel')}</h2>
                {heatRow ? (
                  <>
                    <p class="gauge-num">{heatRow.count}</p>
                    <p class="gauge-note">{t(locale, 'detail.heat_count', { n: heatRow.count, total: heatFile.models.length })}</p>
                    <span class="track heat-share" aria-hidden="true"><span style={`width:${Math.round((heatRow.count / Math.max(heatFile.models.length, 1)) * 100)}%`}></span></span>
                    <ul class="heat-names">
                      {(heatRow.models ?? []).slice(0, 6).map((modelId) => <li>{heatNames.get(modelId) ?? modelId}</li>)}
                    </ul>
                  </>
                ) : <p class="gauge-note">{t(locale, 'detail.heat_none')}</p>}
              </section>
            )}
          </div>
        )}
        {(profileMarkup || timeline.length > 0) && (
          <div class:list={['dossier-viz', profileMarkup && timeline.length > 0 && 'two']}>
            {profileMarkup && <div set:html={profileMarkup} />}
            {timeline.length > 0 && <Timeline title={t(locale, 'detail.timeline')} aria={t(locale, 'detail.timeline_aria', { name: record.index.name })} events={timeline} />}
          </div>
        )}
      </header>
      <div class="callout">
        <p><strong>{t(locale, 'detail.pending_title')}</strong>{t(locale, 'status.explanation')}</p>
      </div>
      {hot && (
        <div class="callout">
          <p>
            <strong>{t(locale, 'detail.why_hot')}</strong>
            {hot.heat_confidence === 'A' ? t(locale, 'detail.why_a') : t(locale, 'detail.why_b')}
            {hot.rationale}
          </p>
          <ul class="trend-evidence">
            {hot.evidence.map((entry) => {
              const href = safeUrl(entry.url);
              return (
                <li>
                  {href ? (
                    <a class="inline-meta" href={href} target="_blank" rel="noopener noreferrer">
                      {entry.organization && <span>{entry.organization}</span>}
                      {entry.date && <span>{entry.date}</span>}
                      {!entry.organization && !entry.date && <span>{entry.url}</span>}
                    </a>
                  ) : (
                    <span class="inline-meta">
                      {entry.organization && <span>{entry.organization}</span>}
                      {entry.date && <span>{entry.date}</span>}
                      {!entry.organization && !entry.date && <span>{entry.url}</span>}
                    </span>
                  )}
                  {entry.what ? <p>{entry.what}</p> : null}
                </li>
              );
            })}
          </ul>
        </div>
      )}
      {record.index.cited_2026h2 && (
        <div class="callout">
          <p><strong>{t(locale, 'detail.cited')}</strong>{record.index.citation_note ? publicText(record.index.citation_note) : ''}</p>
          {(record.index.cited_2026h2_evidence ?? []).length > 0 && (
            <ul class="doc-list">
              {(record.index.cited_2026h2_evidence ?? []).map((item) => {
                const href = safeUrl(item.url);
                return (
                  <li>
                    {href ? <a href={href} target="_blank" rel="noopener noreferrer">{item.url}</a> : <span>{item.url}</span>}
                    {item.date ? <span class="accessed">{t(locale, 'detail.evidence_date', { date: item.date })}</span> : null}
                    {item.accessed ? <span class="accessed">{t(locale, 'detail.accessed', { date: item.accessed })}</span> : null}
                    {item.note ? <p class="note">{item.note}</p> : null}
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      )}

      {chapterViews.map(({ chapter, shown }) => (
        <Chapter id={chapter.id} title={t(locale, `chapter.${chapter.id}.title`)} intro={t(locale, `chapter.${chapter.id}.intro`)} entries={shown} hideEmpty>
          {chapter.id === 'latest_status' && news.length > 0 && (
            <div class="related">
              <h3>{t(locale, 'detail.related')}</h3>
              {news.map((item) => (
                <article>
                  <p class="kicker">{item.type}</p>
                  <p class="when inline-meta">
                    <span>{t(locale, 'news.observed', { date: item.observed_date })}</span>
                    <span>{item.event_date && item.event_date !== '待核实' && item.event_date !== 'Unverified' ? t(locale, 'news.event', { date: item.event_date }) : t(locale, 'news.event_unverified')}</span>
                  </p>
                  <p>{item.title}</p>
                  <p class="news-body">{publicText(item.body)}</p>
                  <p class="news-links">
                    {item.sources.flatMap((source) => {
                      const href = safeUrl(source.url);
                      return href ? [<a href={href} target="_blank" rel="noopener noreferrer">{host(href)}</a>] : [];
                    })}
                  </p>
                </article>
              ))}
            </div>
          )}
        </Chapter>
      ))}

      {extraViews.filter((view) => view.shown).map((view) => (
        <Chapter id={`extra-${view.key}`} title={view.shown?.label || ''} entries={view.shown ? [view.shown] : []} hideEmpty />
      ))}
      {pendingGroups.length > 0 && (
        <details class="pending-fold">
          <summary>{t(locale, 'detail.not_public')}</summary>
          {pendingGroups.map((group) => (
            <div>
              <h3>{group.title}</h3>
              <ul>
                {group.entries.map((entry) => (
                  <li><span>{entry.label}</span> <span class:list={['badge', badgeClass(pendingStatus(entry.field))]}>{pendingStatus(entry.field)}</span></li>
                ))}
              </ul>
            </div>
          ))}
        </details>
      )}

      <nav class="pager" aria-label={t(locale, 'detail.pager_aria')}>
        {previous ? (
          <a href={page(`benchmarks/${previous.index.id}`)}>
            <small class="inline-meta"><span>{t(locale, 'detail.prev', { section: sectionLabel(record.index.section, locale) })}</span></small>
            {previous.index.name}
          </a>
        ) : <span></span>}
        {following && (
          <a class="next" href={page(`benchmarks/${following.index.id}`)}>
            <small class="inline-meta"><span>{t(locale, 'detail.next', { section: sectionLabel(record.index.section, locale) })}</span></small>
            {following.index.name}
          </a>
        )}
      </nav>
    </article>
  </div>
  <script>
    import { bindToc } from '../../scripts/toc';
    const nav = document.querySelector('.toc');
    if (nav) bindToc(nav);
  </script>
</Base>
