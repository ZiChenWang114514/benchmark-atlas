---
import Base from '../layouts/Base.astro';
import { currentLocale, t } from '../i18n';
import { page } from '../lib/format';
const locale = currentLocale();
---
<Base title={t(locale, 'notfound.title')} description={t(locale, 'notfound.description')}>
  <div class="wrap page-hero">
    <h1>{t(locale, 'notfound.title')}</h1>
    <p class="lede">{t(locale, 'notfound.lede')}</p>
    <p class="actions">
      <a class="action action-primary" href={page()}>{t(locale, 'notfound.home')}</a>
      <a class="action" href={page('constitution')}>{t(locale, 'nav.constitution')}</a>
    </p>
  </div>
</Base>
