---
import Base from '../layouts/Base.astro';
import { currentLocale, t } from '../i18n';
import { translateContent } from '../i18n/content';
import { visualCopy } from '../i18n/visual';
import { sectionLabel, sectionSlug } from '../lib/sections';
import { loadHeat, rankArrow, type HeatFile } from '../lib/boards';
import { loadIndex } from '../lib/data';
import { dateStamp, displayName, page, safeUrl } from '../lib/format';
import BarChart from '../components/BarChart.astro';

const locale = currentLocale();
const ui = visualCopy(locale);
const heat = loadHeat();
const known = new Set(loadIndex().benchmarks.map((item) => item.id));
const modelName = new Map((heat?.models ?? []).map((model) => [model.id, model.name]));
const stamp = dateStamp(heat?.generated_at);
const domains = [...new Set((heat?.ranking ?? []).map((row) => row.domain).filter((domain): domain is string => !!domain))].sort((a, b) => a.localeCompare(b, 'zh'));
const showSpark = (heat?.history?.length ?? 0) >= 2;
const showMovement = Boolean(heat?.coverage?.rank_change_reference_date)
  || (heat?.ranking ?? []).some((row) => typeof row.rank_change === 'number');

function spark(id: string, file: HeatFile): string {
  const history = file.history ?? [];
  if (history.length < 2) return '';
  const points = history.map((entry, index) => {
    const place = entry.top.indexOf(id);
    const y = place === -1 ? 22 : 2 + (place / Math.max(entry.top.length - 1, 1)) * 18;
    const x = history.length === 1 ? 40 : (index / (history.length - 1)) * 76 + 2;
    return x + ',' + y;
  });
  return points.join(' ');
}

const movers = (() => {
  const history = heat?.history ?? [];
  if (history.length < 2) return [];
  const prev = new Map(history[history.length - 2].top.map((id, index) => [id, index + 1]));
  const last = history[history.length - 1].top;
  return last
    .map((id, index) => {
      const before = prev.get(id);
      const now = index + 1;
      return { id, name: heat?.ranking.find((row) => row.benchmark_id === id)?.name ?? id, delta: before == null ? null : before - now };
    })
    .filter((row) => row.delta != null && row.delta > 0)
    .sort((a, b) => (b.delta ?? 0) - (a.delta ?? 0))
    .slice(0, 5);
})();

const heatChart = (heat?.ranking ?? []).slice(0, 12).map((row) => ({
  rank: row.rank,
  name: displayName(row.name),
  value: row.count,
  href: known.has(row.benchmark_id) ? page('benchmarks/' + row.benchmark_id) : page('frontier-heat'),
}));
function shareOf(count: number, share: number | null | undefined, models: number): number {
  const value = typeof share === 'number' ? share : (models ? count / models : 0);
  return Math.max(0, Math.min(1, value));
}
const matrixMin = 4;
const matrixModels = heat?.models ?? [];
const reportedBy = new Map(matrixModels.map((model) => [model.id, new Set(model.benchmarks ?? [])]));
const matrixRows = (heat?.ranking ?? []).filter((row) => row.count >= matrixMin).map((row) => ({
  id: row.benchmark_id,
  name: displayName(row.name),
  href: known.has(row.benchmark_id) ? page('benchmarks/' + row.benchmark_id) : '',
  cells: matrixModels.map((model) => reportedBy.get(model.id)?.has(row.benchmark_id) ?? false),
}));
---
<Base title={t(locale, 'heat.title')} description={t(locale, 'heat.description')} active="heat">
  <div class="wrap page-hero">
    <h1>{t(locale, 'heat.title')}</h1>
    <p class="lede">{t(locale, 'heat.lede')}</p>
    {heat?.coverage?.interpretation_zh && <p class="disclaimer">{translateContent(heat.coverage.interpretation_zh, locale)}</p>}
    {heat && (
      <>
        <p class="meta-row">
          {stamp && <span>{ui.snapshot} {stamp}</span>}
          <span>{t(locale, 'home.models', { n: heat.models.length })}</span>
        </p>
        <div class="stat-row">
          <div class="stat">
            <span>{ui.statModels}</span>
            <strong data-count={heat.models.length} data-count-label={String(heat.models.length)}>{heat.models.length}</strong>
          </div>
          <div class="stat">
            <span>{ui.statListed}</span>
            <strong data-count={heat.ranking.length} data-count-label={String(heat.ranking.length)}>{heat.ranking.length}</strong>
          </div>
        </div>
      </>
    )}
  </div>
  <div class="wrap">
    {heat ? (
      <>
        {matrixRows.length > 0 && (
          <section class="section" aria-labelledby="heat-matrix-title">
            <header class="flag">
              <h2 id="heat-matrix-title">{t(locale, 'heat.matrix')}</h2>
              <p>{t(locale, 'heat.matrix_note', { n: matrixMin })}</p>
            </header>
            <p class="heat-legend matrix-legend">
              <span><i class="swatch on" aria-hidden="true"></i>{t(locale, 'heat.legend_on')}</span>
              <span><i class="swatch off" aria-hidden="true"></i>{t(locale, 'heat.legend_off')}</span>
            </p>
            <p class="index-note">{t(locale, 'heat.matrix_scroll')}</p>
            <p class="sr-only">{t(locale, 'heat.matrix_keys')}</p>
            <div class="matrix-scroll" tabindex="0" aria-label={t(locale, 'heat.matrix_aria')}>
              <table class="matrix" id="heat-matrix">
                <caption class="sr-only">{t(locale, 'heat.matrix_aria')}</caption>
                <thead>
                  <tr>
                    <th class="bench" scope="col"></th>
                    {matrixModels.map((model, index) => (
                      <th scope="col" data-col={index}><span class="vname">{model.name}</span></th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {matrixRows.map((row, rowIndex) => (
                    <tr>
                      <th class="bench" scope="row">
                        {row.href ? <a href={row.href}>{row.name}</a> : row.name}
                      </th>
                      {row.cells.map((on, index) => {
                        const modelName = matrixModels[index]?.name ?? '';
                        const label = t(locale, on ? 'heat.cell_yes' : 'heat.cell_no', { model: modelName, benchmark: row.name });
                        return (
                          <td data-col={index} class={on ? 'is-on' : 'is-off'}>
                            <button type="button" class:list={['heat-cell', on && 'on']} tabindex={rowIndex === 0 && index === 0 ? 0 : -1} aria-label={label} data-col={index}></button>
                          </td>
                        );
                      })}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <div id="heat-tip" class="heat-tip" role="tooltip" hidden></div>
          </section>
        )}
        {heatChart.length > 0 && (
          <section class="chart-block" aria-labelledby="heat-top">
            <h2 id="heat-top">{ui.topChart}</h2>
            <BarChart items={heatChart} strong />
          </section>
        )}
        <section class="section" aria-labelledby="heat-models">
          <header class="flag">
            <h2 id="heat-models">{t(locale, 'heat.models')}</h2>
            <p>{t(locale, 'heat.model_count', { n: heat.models.length })}</p>
          </header>
          <div class="table-wrap">
            <table class="board">
              <thead>
                <tr>
                  <th scope="col">{ui.models}</th>
                  <th scope="col">{ui.organization}</th>
                  <th scope="col">{ui.release}</th>
                  <th scope="col">{ui.source}</th>
                </tr>
              </thead>
              <tbody>
                {heat.models.map((model) => {
                  const source = model.sources?.find((item) => item.url && safeUrl(item.url));
                  return (
                    <tr>
                      <td class="name-cell" data-label={ui.models}>{model.name}</td>
                      <td data-label={ui.organization}>{model.organization || <span class="na" title={ui.nullTip}>—</span>}</td>
                      <td data-label={ui.release}>{dateStamp(model.release_date) || <span class="na" title={ui.nullTip}>—</span>}</td>
                      <td data-label={ui.source}>{source?.url && safeUrl(source.url) ? <a href={source.url} target="_blank" rel="noopener noreferrer">{ui.open}</a> : <span class="na" title={ui.nullTip}>—</span>}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
        <section class="section" aria-labelledby="heat-rank">
          <header class="flag">
            <h2 id="heat-rank">{t(locale, 'heat.by_count')}</h2>
            <p>{t(locale, 'heat.share_note')}</p>
          </header>
          <form id="heat-form" class="board-toolbar" role="search" action={page('frontier-heat')} method="get">
            <label class="sr-only" for="heat-q">{ui.heatSearch}</label>
            <input id="heat-q" class="search" type="search" placeholder={ui.heatSearch} autocomplete="off" enterkeyhint="search" />
            <label class="sr-only" for="heat-domain">{ui.colDomain}</label>
            <select id="heat-domain">
              <option value="">{ui.allDomains}</option>
              {domains.map((domain) => <option value={sectionSlug(domain)}>{sectionLabel(domain, locale)}</option>)}
            </select>
            <p id="heat-count" class="result-count" data-showing={ui.showing} data-unit={ui.rows} aria-live="polite"></p>
          </form>
          <p id="heat-empty" class="empty" hidden>{ui.emptyFilter}</p>
          <div class="board-scroll grow-root">
            <table class="board">
              <caption class="sr-only">{t(locale, 'heat.title')}</caption>
              <thead>
                <tr>
                  <th class="rank-col" scope="col">{ui.colRank}</th>
                  {showMovement && <th scope="col">{t(locale, 'heat.col.change')}</th>}
                  <th class="name-col" scope="col">{ui.colName}</th>
                  <th scope="col">{ui.colDomain}</th>
                  <th scope="col">{ui.reported}</th>
                  <th scope="col">{ui.share}</th>
                  {showSpark && <th scope="col">{t(locale, 'heat.col.spark')}</th>}
                  <th scope="col">{ui.reportedModels}</th>
                </tr>
              </thead>
              <tbody>
                {heat.ranking.map((row) => {
                  const arrow = rankArrow(row.rank_change);
                  const share = shareOf(row.count, row.share, heat.models.length);
                  const sharePct = Math.round(share * 100);
                  const points = showSpark ? spark(row.benchmark_id, heat) : '';
                  const podium = row.rank <= 3 ? 'podium podium-' + row.rank : '';
                  const search = [row.name, row.benchmark_id, sectionLabel(row.domain, locale)].join(' ').toLowerCase();
                  return (
                    <tr class={podium} data-heat-row data-domain={sectionSlug(row.domain)} data-search={search}>
                      <td class="rank-cell" data-label={ui.colRank}><span class="rank-no">{row.rank}</span></td>
                      {showMovement && (
                        <td data-label={t(locale, 'heat.col.change')}>
                          {row.rank_change === 'new' ? <span class="move-new" title={arrow.label}>{t(locale, 'rank.new_mark')}</span> : <span class:list={['rank-change', typeof row.rank_change === 'number' && row.rank_change < 0 && 'move-up', typeof row.rank_change === 'number' && row.rank_change > 0 && 'move-down']} title={arrow.label}>{arrow.mark}</span>}
                        </td>
                      )}
                      <td class="name-cell" data-label={ui.colName}>
                        {known.has(row.benchmark_id) ? <a href={page('benchmarks/' + row.benchmark_id)}>{displayName(row.name)}</a> : displayName(row.name)}
                      </td>
                      <td data-label={ui.colDomain}>{row.domain ? <span class="domain-tag">{sectionLabel(row.domain, locale)}</span> : <span class="na" title={ui.nullTip}>—</span>}</td>
                      <td class="num" data-label={ui.reported}>{row.count}</td>
                      <td data-label={ui.share}>
                        <span class="score-wrap" title={sharePct + '%'}>
                          <span class="score-num">{sharePct}%</span>
                          <span class="track" aria-hidden="true"><span class="grow" style={'width:' + sharePct + '%'}></span></span>
                        </span>
                      </td>
                      {showSpark && (
                        <td data-label={t(locale, 'heat.col.spark')}>
                          {points ? <svg class="spark" viewBox="0 0 80 24" aria-hidden="true"><polyline points={points} /></svg> : <span class="na" title={ui.nullTip}>—</span>}
                        </td>
                      )}
                      <td data-label={ui.reportedModels}>
                        <details>
                          <summary>{t(locale, 'home.models', { n: (row.models ?? []).length })}</summary>
                          <ul class="doc-list">
                            {(row.models ?? []).map((id) => <li>{modelName.get(id) ?? id}</li>)}
                          </ul>
                        </details>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <div class="pager-bar">
            <button type="button" class="pager-btn" id="heat-prev">{ui.prev}</button>
            <span id="heat-page"></span>
            <button type="button" class="pager-btn" id="heat-next">{ui.next}</button>
          </div>
        </section>
        {movers.length > 0 && (
          <section class="section" aria-labelledby="heat-movers">
            <header class="flag"><h2 id="heat-movers">{t(locale, 'heat.movers')}</h2><p>{t(locale, 'heat.movers_note')}</p></header>
            <ul class="doc-list">
              {movers.map((row) => (
                <li class="inline-meta"><span>{row.name}</span><span>{t(locale, 'rank.up', { n: row.delta ?? 0 })}</span></li>
              ))}
            </ul>
          </section>
        )}
        <script>
          import { mountHeatBoard } from '../scripts/heat-board.ts';
          mountHeatBoard();
        </script>
      </>
    ) : (
      <p class="pending-data">{t(locale, 'home.pending_data')}</p>
    )}
  </div>
</Base>
