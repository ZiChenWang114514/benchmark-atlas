---
import Base from '../layouts/Base.astro';
import HeatLegend from '../components/HeatLegend.astro';
import TrendItem from '../components/TrendItem.astro';
import { currentLocale, t } from '../i18n';
import { visualCopy } from '../i18n/visual';
import { sectionLabel, sectionSlug } from '../lib/sections';
import { loadTrending, trendingViews } from '../lib/data';
import { SECTIONS } from '../lib/chapters';
import { dateStamp } from '../lib/format';

const locale = currentLocale();
const ui = visualCopy(locale);

const trending = loadTrending();
const items = trendingViews();
const present = new Set(items.map((item) => item.section));
const sections = [
  ...SECTIONS.map((section) => section.id).filter((id) => present.has(id)),
  ...[...present].filter((id) => !SECTIONS.some((section) => section.id === id)).sort((a, b) => a.localeCompare(b, 'zh')),
];
const windowText = trending.window?.from && trending.window?.through ? t(locale, 'home.window', { from: trending.window.from, through: trending.window.through }) : '';
---
<Base
  title={t(locale, 'trend.title')}
  description={t(locale, 'trend.description')}
  active="trending"
>
  <div class="wrap page-hero">
    <h1>{t(locale, 'trend.title')}</h1>
    <p class="lede">{trending.note}</p>
    <p class="meta-row">
      {dateStamp(trending.generated_at) && <span>{ui.snapshot} {dateStamp(trending.generated_at)}</span>}
      {windowText && <span>{windowText}</span>}
      <span>{t(locale, 'trend.meta_count', { n: items.length })}</span>
    </p>
  </div>
  <div class="wrap">
    <HeatLegend />
    <div class="chips" role="group" aria-label={t(locale, 'trend.chips_aria')} id="trend-chips" data-all="all" data-count-template={t(locale, 'trend.count', { n: '{n}' })}>
      <button type="button" class="chip" data-trend-section="all" aria-pressed="true">{t(locale, 'home.all_sections')}</button>
      {sections.map((section) => (
        <button type="button" class="chip" data-trend-section={sectionSlug(section)} aria-pressed="false">{sectionLabel(section, locale)}</button>
      ))}
    </div>
    <p id="trend-count" class="result-count">{t(locale, 'trend.count', { n: items.length })}</p>
    <div class="trend-list" id="trend-list">
      {items.map((item) => <TrendItem item={item} />)}
    </div>
    <p id="trend-empty" class="empty" hidden>{t(locale, 'trend.empty')}</p>
  </div>
  <script>
    const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-trend-section]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-trend]')];
    const count = document.querySelector('#trend-count');
    const empty = document.querySelector<HTMLElement>('#trend-empty');
    function apply(section: string) {
      let shown = 0;
      for (const card of cards) {
        const match = section === 'all' || card.dataset.section === section;
        card.hidden = !match;
        if (match) shown += 1;
      }
      const template = document.querySelector('#trend-chips')?.getAttribute('data-count-template') || '{n}';
      if (count) count.textContent = template.replaceAll('{n}', String(shown));
      if (empty) empty.hidden = shown !== 0;
    }
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const section = chip.dataset.trendSection || 'all';
        for (const other of chips) other.setAttribute('aria-pressed', other === chip ? 'true' : 'false');
        apply(section);
      });
    }
  </script>
</Base>
