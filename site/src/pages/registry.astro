---
import Base from '../layouts/Base.astro';
import { currentLocale, t } from '../i18n';
import { visualCopy } from '../i18n/visual';
import { sectionLabel } from '../lib/sections';
import { loadRegistry } from '../lib/boards';
import { loadIndex } from '../lib/data';
import { dateStamp, page } from '../lib/format';

const locale = currentLocale();
const ui = visualCopy(locale);

const registry = loadRegistry();
const known = new Set(loadIndex().benchmarks.map((item) => item.id));
const payload = (registry?.items ?? []).map((item) => ({
  id: item.id,
  name: item.name,
  aliases: item.aliases ?? [],
  domain: sectionLabel(item.domain, locale),
  description_zh: locale === 'en' ? '' : (item.description_zh ?? ''),
  release_date: item.release_date ?? '',
  paper_url: item.paper_url ?? '',
  github_url: item.github_url ?? '',
  hf_dataset: item.hf_dataset ?? '',
  homepage: item.homepage ?? '',
  citations: item.metrics?.citations ?? null,
  stars: item.metrics?.gh_stars ?? null,
  archive: known.has(item.id) ? page(`benchmarks/${item.id}`) : '',
}));
const domains = [...new Set(payload.map((item) => item.domain).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'zh'));
---
<Base title={t(locale, 'registry.title')} description={t(locale, 'registry.description')} active="registry">
  <div class="wrap page-hero">
    <h1>{t(locale, 'registry.title')}</h1>
    <p class="lede">{t(locale, 'registry.lede')}</p>
    <p class="meta-row">
      {dateStamp(registry?.generated_at) && <span>{ui.snapshot} {dateStamp(registry?.generated_at)}</span>}
      {registry && <span>{t(locale, 'registry.count_meta', { n: registry.count ?? payload.length })}</span>}
    </p>
  </div>
  <div class="wrap">
    {registry ? (
      <>
        <div class="controls">
          <label class="sel" for="reg-q">{t(locale, 'registry.search')}
            <input id="reg-q" type="search" placeholder={t(locale, 'registry.search_placeholder')} />
          </label>
          <label class="sel" for="reg-domain">{t(locale, 'registry.domain')}
            <select id="reg-domain">
              <option value="">{t(locale, 'registry.all_domains')}</option>
              {domains.map((domain) => <option value={domain}>{domain}</option>)}
            </select>
          </label>
          <label class="sel" for="reg-sort">{t(locale, 'registry.sort')}
            <select id="reg-sort">
              <option value="name">{t(locale, 'registry.sort_name')}</option>
              <option value="citations">{t(locale, 'registry.sort_citations')}</option>
              <option value="stars">{t(locale, 'registry.sort_stars')}</option>
              <option value="release">{t(locale, 'registry.sort_release')}</option>
            </select>
          </label>
        </div>
        <p id="reg-count" class="result-count"></p>
        <div class="board-scroll">
          <table class="board" id="reg-table" data-null-tip={ui.nullTip} data-paper={t(locale, 'registry.paper')} data-code={t(locale, 'registry.code')} data-dataset={t(locale, 'registry.dataset')} data-home={t(locale, 'registry.home')} data-name={t(locale, 'registry.col.name')} data-domain={t(locale, 'registry.col.domain')} data-released={t(locale, 'registry.col.released')} data-citations={t(locale, 'registry.col.citations')} data-stars={t(locale, 'registry.col.stars')} data-links={t(locale, 'registry.col.links')} data-count-unit={t(locale, 'visual.rows')}>
            <thead>
              <tr>
                <th class="name-col" scope="col">{t(locale, 'registry.col.name')}</th>
                <th scope="col">{t(locale, 'registry.col.domain')}</th>
                <th scope="col">{t(locale, 'registry.col.released')}</th>
                <th scope="col">{t(locale, 'registry.col.citations')}</th>
                <th scope="col">{t(locale, 'registry.col.stars')}</th>
                <th scope="col">{t(locale, 'registry.col.links')}</th>
              </tr>
            </thead>
            <tbody id="reg-body"></tbody>
          </table>
        </div>
        <div class="pager-bar">
          <button type="button" class="pager-btn" id="reg-prev">{ui.prev}</button>
          <span id="reg-page"></span>
          <button type="button" class="pager-btn" id="reg-next">{ui.next}</button>
        </div>
        <script id="reg-data" type="application/json" set:html={JSON.stringify(payload).replaceAll('<', '\\u003c')}></script>
        <script>
          type Row = {
            id: string; name: string; aliases?: string[]; domain: string; description_zh: string;
            release_date: string; paper_url: string; github_url: string; hf_dataset: string;
            homepage: string; citations: number | null; stars: number | null; archive: string;
          };
          const data = JSON.parse(document.querySelector('#reg-data')?.textContent || '[]') as Row[];
          const q = document.querySelector<HTMLInputElement>('#reg-q');
          const domain = document.querySelector<HTMLSelectElement>('#reg-domain');
          const sort = document.querySelector<HTMLSelectElement>('#reg-sort');
          const body = document.querySelector('#reg-body');
          const count = document.querySelector('#reg-count');
          const pageLabel = document.querySelector('#reg-page');
          const prev = document.querySelector('#reg-prev');
          const next = document.querySelector('#reg-next');
          const pageSize = 40;
          let page = 0;
          function num(value: number | null) {
            return typeof value === 'number' ? value : Number.NEGATIVE_INFINITY;
          }
          function filtered() {
            const query = (q?.value || '').trim().toLowerCase();
            const selected = domain?.value || '';
            const rows = data.filter((item) => {
              if (selected && item.domain !== selected) return false;
              if (!query) return true;
              const blob = [item.name, item.id, item.description_zh, ...(item.aliases || [])].join(' ').toLowerCase();
              return blob.includes(query);
            });
            const key = sort?.value || 'name';
            rows.sort((a, b) => {
              if (key === 'citations') return num(b.citations) - num(a.citations);
              if (key === 'stars') return num(b.stars) - num(a.stars);
              if (key === 'release') return String(b.release_date || '').localeCompare(String(a.release_date || ''));
              return String(a.name).localeCompare(String(b.name), 'zh');
            });
            return rows;
          }
          function esc(value: unknown) {
            return String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char] || char);
          }
          function safeHref(url: string) {
            if (!url) return '';
            if (url.startsWith('/')) return esc(url);
            try {
              const parsed = new URL(url);
              if (parsed.protocol === 'http:' || parsed.protocol === 'https:') return esc(parsed.href);
            } catch { return ''; }
            return '';
          }
          function link(href: string, label: string) {
            const safe = safeHref(href);
            if (!safe) return '';
            return `<a href="${safe}" target="_blank" rel="noopener noreferrer">${esc(label)}</a>`;
          }
          function draw() {
            const rows = filtered();
            const pages = Math.max(1, Math.ceil(rows.length / pageSize));
            if (page >= pages) page = pages - 1;
            const slice = rows.slice(page * pageSize, page * pageSize + pageSize);
            if (body) {
              body.innerHTML = slice.map((item) => {
                const name = item.archive ? `<a href="${safeHref(item.archive)}">${esc(item.name)}</a>` : esc(item.name);
                const hf = item.hf_dataset ? `https://huggingface.co/datasets/${item.hf_dataset}` : '';
                const table = document.querySelector('#reg-table');
                const paper = table?.getAttribute('data-paper') || '';
                const code = table?.getAttribute('data-code') || '';
                const dataset = table?.getAttribute('data-dataset') || '';
                const home = table?.getAttribute('data-home') || '';
                const links = [link(item.paper_url, paper), link(item.github_url, code), link(hf, dataset), link(item.homepage, home)].filter(Boolean);
                const nullTip = table?.getAttribute('data-null-tip') || '';
                const dash = `<span class="na" title="${esc(nullTip)}">—</span>`;
                const entry = links.length ? `<span class="row-links">${links.join('')}</span>` : dash;
                const labelName = table?.getAttribute('data-name') || '';
                const labelDomain = table?.getAttribute('data-domain') || '';
                const labelReleased = table?.getAttribute('data-released') || '';
                const labelCitations = table?.getAttribute('data-citations') || '';
                const labelStars = table?.getAttribute('data-stars') || '';
                const labelLinks = table?.getAttribute('data-links') || '';
                return `<tr><td class="name-cell" data-label="${esc(labelName)}">${name}</td><td data-label="${esc(labelDomain)}">${item.domain ? `<span class="domain-tag">${esc(item.domain)}</span>` : dash}</td><td data-label="${esc(labelReleased)}">${esc(item.release_date || '') || dash}</td><td class="num" data-label="${esc(labelCitations)}">${item.citations ?? dash}</td><td class="num" data-label="${esc(labelStars)}">${item.stars ?? dash}</td><td data-label="${esc(labelLinks)}">${entry}</td></tr>`;
              }).join('');
            }
            if (count) count.textContent = `${rows.length} ${document.querySelector('#reg-table')?.getAttribute('data-count-unit') || ''}`.trim();
            if (pageLabel) pageLabel.textContent = `${page + 1} / ${pages}`;
          }
          q?.addEventListener('input', () => { page = 0; draw(); });
          domain?.addEventListener('change', () => { page = 0; draw(); });
          sort?.addEventListener('change', () => { page = 0; draw(); });
          prev?.addEventListener('click', () => { page = Math.max(0, page - 1); draw(); });
          next?.addEventListener('click', () => { page += 1; draw(); });
          draw();
        </script>
      </>
    ) : (
      <p class="pending-data">{t(locale, 'home.pending_data')}</p>
    )}
  </div>
</Base>
