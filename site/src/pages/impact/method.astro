---
import Base from '../../layouts/Base.astro';
import { currentLocale, t } from '../../i18n';
import { loadMethodology } from '../../lib/boards';
import { renderMarkdownDocument } from '../../lib/content';
import { page } from '../../lib/format';

const locale = currentLocale();
const markdown = loadMethodology();
const html = markdown ? renderMarkdownDocument(markdown) : '';
---
<Base title={t(locale, 'method.title')} description={t(locale, 'method.description')} active="impact">
  <div class="wrap page-hero">
    <h1>{t(locale, 'method.heading')}</h1>
    <p class="meta-row"><a href={page('impact')}>{t(locale, 'method.back')}</a></p>
  </div>
  <div class="wrap">
    {html ? <article class="prose" set:html={html} /> : <p class="pending-data">{t(locale, 'home.pending_data')}</p>}
  </div>
</Base>
