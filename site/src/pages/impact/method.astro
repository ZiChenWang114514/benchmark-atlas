---
import Base from '../../layouts/Base.astro';
import { loadMethodology } from '../../lib/boards';
import { renderMarkdownDocument } from '../../lib/content';
import { page } from '../../lib/format';

const markdown = loadMethodology();
const html = markdown ? renderMarkdownDocument(markdown) : '';
---
<Base title="影响力方法" description="学术影响力榜各维度的定义和权重。" active="impact">
  <div class="wrap page-hero">
    <h1>学术影响力怎么算</h1>
    <p class="meta-row"><a href={page('impact')}>返回榜单</a></p>
  </div>
  <div class="wrap">
    {html ? <article class="prose" set:html={html} /> : <p class="pending-data">数据生成中</p>}
  </div>
</Base>
