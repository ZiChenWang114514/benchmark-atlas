---
import Value from './Value.astro';
import { isStatusWord } from '../lib/format';

interface Props {
  value: unknown;
  name?: string;
}
const { value, name } = Astro.props;
const hiddenStatus = isStatusWord(value);
---
{hiddenStatus ? null : (
  <div class="field-value">
    <Value value={value} name={name} />
  </div>
)}
