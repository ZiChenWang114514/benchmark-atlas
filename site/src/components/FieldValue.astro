---
import { formatBytes, isEmail, labelFor, safeUrl } from '../lib/format';

interface Props {
  value: unknown;
  name?: string;
}
const { value, name } = Astro.props;

const isRecord = (item: unknown): item is Record<string, unknown> =>
  !!item && typeof item === 'object' && !Array.isArray(item);

const href = typeof value === 'string' ? safeUrl(value) : null;
const results =
  Array.isArray(value) && value.length > 0 && value.every((item) => isRecord(item) && 'model' in item && 'score' in item)
    ? (value as Record<string, unknown>[])
    : null;
const strings = Array.isArray(value) && value.every((item) => typeof item === 'string') ? (value as string[]) : null;
const docs =
  Array.isArray(value) && value.length > 0 && value.every((item) => isRecord(item) && typeof item.webViewLink === 'string')
    ? (value as { webViewLink: string; kind?: string; id?: string }[])
    : null;
const changes =
  Array.isArray(value) &&
  value.length > 0 &&
  value.every((item) => isRecord(item) && typeof item.date === 'string' && typeof item.change === 'string')
    ? (value as { date: string; timezone?: string; change: string }[])
    : null;
const drive = isRecord(value) && typeof value.webViewLink === 'string' ? (value as { webViewLink: string; kind?: string; id?: string }) : null;
const record = !results && !docs && !changes && !drive && isRecord(value) ? value : null;
const hasRank = results?.some((row) => row.rank != null) ?? false;

let mode = 'raw';
if (value === '待核实' || value === '未公开') mode = 'pending';
else if (href) mode = 'link';
else if (typeof value === 'string' && isEmail(value)) mode = 'email';
else if (typeof value === 'string' && /^[a-f0-9]{64}$/i.test(value)) mode = 'mono';
else if (typeof value === 'string') mode = 'text';
else if (typeof value === 'number' && name === 'pdf_bytes') mode = 'bytes';
else if (typeof value === 'number') mode = 'number';
else if (strings && strings.length > 0 && strings.every((item) => isEmail(item))) mode = 'emails';
else if (strings && strings.length >= 6) mode = 'people';
else if (strings && strings.every((item) => item.length <= 16)) mode = 'pills';
else if (strings) mode = 'inline';
else if (results) mode = 'results';
else if (docs) mode = 'docs';
else if (changes) mode = 'changes';
else if (drive) mode = 'drive';
else if (record) mode = 'kv';

const numberText = typeof value === 'number' ? new Intl.NumberFormat('zh-Hans').format(value) : '';
---
{mode === 'link' && href && <p class="field-value"><a href={href} target="_blank" rel="noopener noreferrer">{href}</a></p>}
{mode === 'email' && typeof value === 'string' && <p class="field-value"><a href={`mailto:${value}`}>{value}</a></p>}
{mode === 'mono' && typeof value === 'string' && <p class="field-value mono">{value}</p>}
{mode === 'text' && typeof value === 'string' && <p class="field-value">{value}</p>}
{mode === 'bytes' && typeof value === 'number' && <p class="field-value num">{formatBytes(value)}</p>}
{mode === 'number' && <p class="field-value num">{numberText}</p>}
{mode === 'emails' && strings && (
  <ul class="doc-list">
    {strings.map((email) => <li><a href={`mailto:${email}`}>{email}</a></li>)}
  </ul>
)}
{mode === 'people' && strings && (
  <ul class="people">
    {strings.map((person) => <li>{person}</li>)}
  </ul>
)}
{mode === 'pills' && strings && strings.length > 0 && (
  <ul class="pills">
    {strings.map((item) => <li>{item}</li>)}
  </ul>
)}
{mode === 'inline' && strings && <p class="field-value">{strings.join('、')}</p>}
{mode === 'results' && results && (
  <div class="table-wrap">
    <table class="results">
      <thead>
        <tr>
          <th scope="col">模型</th>
          <th scope="col">分数</th>
          <th scope="col">指标</th>
          <th scope="col">范围</th>
          {hasRank && <th scope="col">名次</th>}
        </tr>
      </thead>
      <tbody>
        {results.map((row) => {
          const unit = typeof row.unit === 'string' ? row.unit : '';
          const score = `${row.score ?? ''}${unit.length === 1 ? unit : unit ? ` ${unit}` : ''}`;
          const columns = hasRank ? 5 : 4;
          return (
            <>
              <tr>
                <td>{String(row.model ?? '')}</td>
                <td class="num">{score}</td>
                <td>{row.metric ? String(row.metric) : ''}</td>
                <td class="scope">{row.scope ? String(row.scope) : ''}</td>
                {hasRank && <td class="num">{row.rank != null ? String(row.rank) : ''}</td>}
              </tr>
              {row.provenance && (
                <tr>
                  <td class="provenance" colspan={columns}>{String(row.provenance)}</td>
                </tr>
              )}
            </>
          );
        })}
      </tbody>
    </table>
  </div>
)}
{mode === 'docs' && docs && (
  <ul class="doc-list">
    {docs.map((doc) => (
      <li>
        <a href={doc.webViewLink} target="_blank" rel="noopener noreferrer">{doc.kind || '打开文档'}</a>
        {doc.id && <span class="file-id">{doc.id}</span>}
      </li>
    ))}
  </ul>
)}
{mode === 'changes' && changes && (
  <ol class="changelog">
    {changes.map((item) => (
      <li>
        <p class="when">{item.date}{item.timezone ? ` · ${item.timezone}` : ''}</p>
        <p>{item.change}</p>
      </li>
    ))}
  </ol>
)}
{mode === 'drive' && drive && (
  <p class="field-value">
    <a href={drive.webViewLink} target="_blank" rel="noopener noreferrer">{drive.kind || '在 Google Drive 打开'}</a>
    {drive.id && <span class="file-id">{drive.id}</span>}
  </p>
)}
{mode === 'kv' && record && (
  <dl class="kv">
    {Object.entries(record).map(([key, item]) => (
      <div>
        <dt>{labelFor(key)}</dt>
        <dd>{typeof item === 'string' || typeof item === 'number' ? String(item) : JSON.stringify(item)}</dd>
      </div>
    ))}
  </dl>
)}
{mode === 'raw' && <p class="field-value">{value == null || value === '' ? '（空）' : String(value)}</p>}
