---
import { currentLocale, hrefForLocale, otherLocale, t } from '../i18n';
import { visualCopy } from '../i18n/visual';
import { page } from '../lib/format';

interface Props {
  active?: 'home' | 'trending' | 'heat' | 'impact' | 'registry' | 'constitution' | 'api';
}
const { active } = Astro.props;
const locale = currentLocale();
const ui = visualCopy(locale);
const items = [
  { id: 'home', href: page(), label: t(locale, 'nav.home') },
  { id: 'trending', href: page('trending'), label: t(locale, 'nav.trending') },
  { id: 'heat', href: page('frontier-heat'), label: t(locale, 'nav.heat') },
  { id: 'impact', href: page('impact'), label: t(locale, 'nav.impact') },
  { id: 'registry', href: page('registry'), label: t(locale, 'nav.registry') },
  { id: 'constitution', href: page('constitution'), label: t(locale, 'nav.constitution') },
];
const other = otherLocale(locale);
const switchHref = hrefForLocale(Astro.url.pathname, Astro.url.search, other);
---
<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href={page()}>Benchmark Constitution</a>
    <a class="lang-switch" href={switchHref} hreflang={other === 'zh' ? 'zh-Hans' : 'en'}>{t(locale, 'lang.switch')}</a>
    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      data-open={ui.menu}
      data-close={ui.close}
    >{ui.menu}</button>
    <nav class="nav" id="site-nav" aria-label={t(locale, 'nav.aria')}>
      {items.map((item) => (
        <a href={item.href} aria-current={active === item.id ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  if (header && toggle && nav) {
    const openLabel = toggle.dataset.open || '';
    const closeLabel = toggle.dataset.close || '';
    const setOpen = (open: boolean) => {
      header.classList.toggle('nav-open', open);
      document.body.classList.toggle('nav-lock', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.textContent = open ? closeLabel : openLabel;
    };
    toggle.addEventListener('click', () => setOpen(!header.classList.contains('nav-open')));
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement | null)?.closest('a')) setOpen(false);
    });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
    window.matchMedia('(min-width: 861px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
