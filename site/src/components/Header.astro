---
import { currentLocale, hrefForLocale, otherLocale, t } from '../i18n';
import { visualCopy } from '../i18n/visual';
import { page } from '../lib/format';

interface Props {
  active?: 'home' | 'trending' | 'heat' | 'impact' | 'registry' | 'constitution' | 'api' | 'search';
}
const { active } = Astro.props;
const locale = currentLocale();
const ui = visualCopy(locale);
const items = [
  { id: 'home', href: page(), label: t(locale, 'nav.home') },
  { id: 'trending', href: page('trending'), label: t(locale, 'nav.trending') },
  { id: 'heat', href: page('frontier-heat'), label: t(locale, 'nav.heat') },
  { id: 'impact', href: page('impact'), label: t(locale, 'nav.impact') },
  { id: 'registry', href: page('registry'), label: t(locale, 'nav.registry') },
  { id: 'constitution', href: page('constitution'), label: t(locale, 'nav.constitution') },
];
const other = otherLocale(locale);
const switchHref = hrefForLocale(Astro.url.pathname, Astro.url.search, other);
const searchAction = page('search');
const searchIndex = `${searchAction.replace(/\/$/, '')}.json`;
---
<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href={page()}>Benchmark Constitution</a>
    <div
      class="site-search"
      data-search
      data-index={searchIndex}
    >
      <button
        type="button"
        class="search-toggle"
        aria-expanded="false"
        aria-controls="site-q"
        data-open={t(locale, 'search.open')}
        data-close={t(locale, 'search.close')}
      >{t(locale, 'search.open')}</button>
      <form class="site-search-form" role="search" action={searchAction} method="get">
        <label class="sr-only" for="site-q">{t(locale, 'search.label')}</label>
        <input
          id="site-q"
          class="site-search-input"
          name="q"
          type="search"
          placeholder={t(locale, 'search.placeholder')}
          autocomplete="off"
          enterkeyhint="search"
          aria-autocomplete="list"
          aria-controls="site-search-results"
          aria-expanded="false"
          aria-haspopup="listbox"
        />
        <kbd class="site-search-kbd" aria-hidden="true">/</kbd>
      </form>
      <div class="site-search-panel" hidden>
        <ul id="site-search-results" class="site-search-results" role="listbox" aria-label={t(locale, 'search.results')}></ul>
        <p class="site-search-empty" hidden>{t(locale, 'search.empty')}</p>
        <a class="site-search-more" data-search-more href={searchAction}>{t(locale, 'search.view_all')}</a>
      </div>
    </div>
    <a class="lang-switch" href={switchHref} hreflang={other === 'zh' ? 'zh-Hans' : 'en'}>{t(locale, 'lang.switch')}</a>
    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      data-open={ui.menu}
      data-close={ui.close}
    >{ui.menu}</button>
    <nav class="nav" id="site-nav" aria-label={t(locale, 'nav.aria')}>
      {items.map((item) => (
        <a href={item.href} aria-current={active === item.id ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>
<script>
  import '../scripts/site-search.ts';
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  if (header && toggle && nav) {
    const openLabel = toggle.dataset.open || '';
    const closeLabel = toggle.dataset.close || '';
    const setOpen = (open: boolean) => {
      header.classList.toggle('nav-open', open);
      document.body.classList.toggle('nav-lock', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.textContent = open ? closeLabel : openLabel;
    };
    toggle.addEventListener('click', () => setOpen(!header.classList.contains('nav-open')));
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement | null)?.closest('a')) setOpen(false);
    });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
    window.matchMedia('(min-width: 861px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
