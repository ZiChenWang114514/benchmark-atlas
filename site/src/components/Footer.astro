---
import { visualCopy } from '../i18n/visual';
import { loadIndex } from '../lib/data';
import { dateStamp, page } from '../lib/format';

import { currentLocale, t } from '../i18n';

const locale = currentLocale();
const ui = visualCopy(locale);
const index = loadIndex();
const stamp = dateStamp(index.generated_at);
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <h2>{ui.footerAboutTitle}</h2>
      <p class="inline-meta">
        <span>{ui.footerAbout}</span>
        {stamp && <span>{ui.snapshot} {stamp}</span>}
      </p>
    </div>
    <div>
      <h2>{ui.footerSections}</h2>
      <ul>
        <li><a href={page('search')}>{t(locale, 'search.page_title')}</a></li>
        <li><a href={page('trending')}>{t(locale, 'nav.trending')}</a></li>
        <li><a href={page('frontier-heat')}>{t(locale, 'nav.heat')}</a></li>
        <li><a href={page('impact')}>{t(locale, 'nav.impact')}</a></li>
        <li><a href={page('registry')}>{t(locale, 'nav.registry')}</a></li>
        <li><a href={page('constitution')}>{t(locale, 'nav.constitution')}</a></li>
      </ul>
    </div>
    <div>
      <h2>{ui.footerSources}</h2>
      <ul>
        <li><a href="https://github.com/ZiChenWang114514/benchmark-constitution">{ui.repo}</a></li>
      </ul>
    </div>
  </div>
</footer>
