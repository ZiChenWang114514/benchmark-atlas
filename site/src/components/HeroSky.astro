---
import { AMBER_RAMP } from '../lib/profile';

interface Cluster {
  count: number;
}
interface Props {
  clusters: Cluster[];
  label: string;
}
const { clusters, label } = Astro.props;
const cx = 180;
const cy = 112;
const dots: { x: number; y: number; r: number; fill: string; delay: number }[] = [];
const centers: { x: number; y: number }[] = [];
clusters.forEach((cluster, index) => {
  const angle = -Math.PI / 2 + (index / Math.max(clusters.length, 1)) * Math.PI * 2;
  const gx = cx + Math.cos(angle) * 74;
  const gy = cy + Math.sin(angle) * 56;
  centers.push({ x: gx, y: gy });
  const count = cluster.count;
  for (let dot = 0; dot < count; dot += 1) {
    const spin = (dot / Math.max(count, 1)) * Math.PI * 2 + index * 0.4;
    const spread = count === 1 ? 0 : 5 + (dot % 4) * 3.2;
    dots.push({
      x: gx + Math.cos(spin) * spread,
      y: gy + Math.sin(spin) * spread * 0.82,
      r: dot % 6 === 0 ? 2.15 : 1.25,
      fill: AMBER_RAMP[index % AMBER_RAMP.length],
      delay: (index * 13 + dot) % 40,
    });
  }
});
const links = centers.map((center, index) => {
  const next = centers[(index + 1) % centers.length];
  return { x1: center.x, y1: center.y, x2: next.x, y2: next.y };
});
const grid = [0, 1, 2, 3, 4, 5, 6];
---
<svg class="hero-sky" viewBox="0 0 360 220" role="img" aria-label={label}>
  <title>{label}</title>
  {grid.map((index) => (
    <line class="sky-grid" x1={24 + index * 52} y1="14" x2={24 + index * 52} y2="206" />
  ))}
  {grid.slice(0, 5).map((index) => (
    <line class="sky-grid" x1="16" y1={22 + index * 44} x2="344" y2={22 + index * 44} />
  ))}
  {links.map((link) => (
    <line class="sky-link" x1={link.x1.toFixed(1)} y1={link.y1.toFixed(1)} x2={link.x2.toFixed(1)} y2={link.y2.toFixed(1)} />
  ))}
  {dots.map((dot) => (
    <circle class="sky-dot" style={`--d:${dot.delay}`} cx={dot.x.toFixed(1)} cy={dot.y.toFixed(1)} r={dot.r} fill={dot.fill} />
  ))}
</svg>
