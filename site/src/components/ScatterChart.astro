---
interface Point {
  name: string;
  href: string;
  year: number;
  score: number;
  citations: number;
  color: string;
}
interface Props {
  points: Point[];
  title: string;
  aria: string;
  yearLabel: string;
  scoreLabel: string;
  tip: string;
}
const { points, title, aria, yearLabel, scoreLabel, tip } = Astro.props;
const years = points.map((point) => point.year);
const scores = points.map((point) => point.score);
const cites = points.map((point) => Math.max(0, point.citations));
const minYear = years.length ? Math.min(...years) : 2018;
const maxYear = years.length ? Math.max(...years) : 2026;
const minScore = scores.length ? Math.max(0, Math.floor(Math.min(...scores) / 5) * 5 - 5) : 0;
const maxScore = scores.length ? Math.min(100, Math.ceil(Math.max(...scores) / 5) * 5) : 100;
const maxCite = Math.max(1, ...cites);
const left = 48;
const right = 16;
const top = 16;
const bottom = 36;
const width = 760;
const height = 380;
const plotW = width - left - right;
const plotH = height - top - bottom;
const yearSpan = Math.max(1, maxYear - minYear);
const scoreSpan = Math.max(1, maxScore - minScore);

function xOf(year: number): number {
  return left + ((year - minYear) / yearSpan) * plotW;
}
function yOf(score: number): number {
  return top + (1 - (score - minScore) / scoreSpan) * plotH;
}
function radius(citations: number): number {
  return 5 + Math.sqrt(Math.max(citations, 0) / maxCite) * 13;
}
const yearTicks = [];
for (let year = minYear; year <= maxYear; year += yearSpan > 6 ? 2 : 1) yearTicks.push(year);
const scoreTicks = [];
for (let score = minScore; score <= maxScore; score += scoreSpan > 40 ? 20 : 10) scoreTicks.push(score);

function tipText(point: Point): string {
  return tip
    .replace('{name}', point.name)
    .replace('{score}', point.score.toFixed(1))
    .replace('{year}', String(point.year))
    .replace('{citations}', String(point.citations));
}
---
<figure class="scatter-block">
  {title && <figcaption>{title}</figcaption>}
  <div class="scatter-scroll">
    <svg class="scatter" viewBox={`0 0 ${width} ${height}`} role="img" aria-label={aria}>
      <title>{aria} {scoreLabel}</title>
      {scoreTicks.map((score) => (
        <g>
          <line x1={left} y1={yOf(score)} x2={width - right} y2={yOf(score)} stroke="#e6dcc8" stroke-width="1" />
          <text x={left - 8} y={yOf(score) + 4} text-anchor="end" fill="#5c564c" font-size="11">{score}</text>
        </g>
      ))}
      {yearTicks.map((year) => (
        <text x={xOf(year)} y={height - 12} text-anchor="middle" fill="#5c564c" font-size="11">{year}</text>
      ))}
      <text x={left + plotW / 2} y={height - 4} text-anchor="middle" fill="#5c564c" font-size="11">{yearLabel}</text>
      {points.map((point) => {
        const cx = xOf(point.year);
        const cy = yOf(point.score);
        const r = radius(point.citations);
        const label = tipText(point);
        return (
          <a href={point.href} aria-label={label}>
            <circle cx={cx} cy={cy} r={r} fill={point.color} fill-opacity="0.88" stroke="#fffdf8" stroke-width="1.2" />
            <title>{label}</title>
          </a>
        );
      })}
    </svg>
  </div>
</figure>
