{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:benchmark-atlas:benchmark-schema:0.1.0",
  "title": "Benchmark Atlas · 宪法v0.1字段契约",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "editorial_status",
    "drive_pdf",
    "changelog",
    "basic_info",
    "organization",
    "design_goals",
    "construction",
    "data_format",
    "evaluation",
    "latest_status",
    "leaderboard",
    "contact",
    "original_files"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "editorial_status": {
      "type": "string"
    },
    "drive_pdf": {
      "$ref": "#/$defs/field"
    },
    "changelog": {
      "$ref": "#/$defs/field"
    },
    "basic_info": {
      "type": "object",
      "required": [
        "name",
        "full_name",
        "version",
        "paper_version",
        "release_date",
        "section",
        "subfields",
        "license",
        "paper_url",
        "code_url",
        "dataset_url",
        "official_homepage",
        "paper_title"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/field"
        },
        "full_name": {
          "$ref": "#/$defs/field"
        },
        "version": {
          "$ref": "#/$defs/field"
        },
        "paper_version": {
          "$ref": "#/$defs/field"
        },
        "release_date": {
          "$ref": "#/$defs/field"
        },
        "section": {
          "$ref": "#/$defs/field"
        },
        "subfields": {
          "$ref": "#/$defs/field"
        },
        "license": {
          "$ref": "#/$defs/field"
        },
        "paper_url": {
          "$ref": "#/$defs/field"
        },
        "code_url": {
          "$ref": "#/$defs/field"
        },
        "dataset_url": {
          "$ref": "#/$defs/field"
        },
        "official_homepage": {
          "$ref": "#/$defs/field"
        },
        "paper_title": {
          "$ref": "#/$defs/field"
        }
      },
      "additionalProperties": false
    },
    "organization": {
      "type": "object",
      "required": [
        "initiators",
        "partners",
        "authors",
        "maintainer",
        "funders"
      ],
      "properties": {
        "initiators": {
          "$ref": "#/$defs/field"
        },
        "partners": {
          "$ref": "#/$defs/field"
        },
        "authors": {
          "$ref": "#/$defs/field"
        },
        "maintainer": {
          "$ref": "#/$defs/field"
        },
        "funders": {
          "$ref": "#/$defs/field"
        }
      },
      "additionalProperties": false
    },
    "design_goals": {
      "type": "object",
      "required": [
        "capabilities",
        "gap_in_prior_benchmarks"
      ],
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/field"
        },
        "gap_in_prior_benchmarks": {
          "$ref": "#/$defs/field"
        }
      },
      "additionalProperties": false
    },
    "construction": {
      "type": "object",
      "required": [
        "question_sources",
        "author_background",
        "review_process",
        "quality_control",
        "decontamination"
      ],
      "properties": {
        "question_sources": {
          "$ref": "#/$defs/field"
        },
        "author_background": {
          "$ref": "#/$defs/field"
        },
        "review_process": {
          "$ref": "#/$defs/field"
        },
        "quality_control": {
          "$ref": "#/$defs/field"
        },
        "decontamination": {
          "$ref": "#/$defs/field"
        }
      },
      "additionalProperties": false
    },
    "data_format": {
      "type": "object",
      "required": [
        "size",
        "question_types",
        "modalities",
        "languages",
        "difficulty",
        "public_hidden_split"
      ],
      "properties": {
        "size": {
          "$ref": "#/$defs/field"
        },
        "question_types": {
          "$ref": "#/$defs/field"
        },
        "modalities": {
          "$ref": "#/$defs/field"
        },
        "languages": {
          "$ref": "#/$defs/field"
        },
        "difficulty": {
          "$ref": "#/$defs/field"
        },
        "public_hidden_split": {
          "$ref": "#/$defs/field"
        }
      },
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": [
        "metrics",
        "scoring",
        "prompt_settings",
        "official_scripts",
        "comparability_warning"
      ],
      "properties": {
        "metrics": {
          "$ref": "#/$defs/field"
        },
        "scoring": {
          "$ref": "#/$defs/field"
        },
        "prompt_settings": {
          "$ref": "#/$defs/field"
        },
        "official_scripts": {
          "$ref": "#/$defs/field"
        },
        "comparability_warning": {
          "$ref": "#/$defs/field"
        }
      },
      "additionalProperties": false
    },
    "latest_status": {
      "type": "object",
      "required": [
        "checked_at",
        "latest_dataset_version",
        "paper_revision_history",
        "saturation",
        "contamination_and_issues",
        "derivatives"
      ],
      "properties": {
        "checked_at": {
          "$ref": "#/$defs/field"
        },
        "latest_dataset_version": {
          "$ref": "#/$defs/field"
        },
        "paper_revision_history": {
          "$ref": "#/$defs/field"
        },
        "saturation": {
          "$ref": "#/$defs/field"
        },
        "contamination_and_issues": {
          "$ref": "#/$defs/field"
        },
        "derivatives": {
          "$ref": "#/$defs/field"
        }
      },
      "additionalProperties": false
    },
    "leaderboard": {
      "type": "object",
      "required": [
        "snapshot_date",
        "official_url",
        "third_party_url",
        "results",
        "coverage_note"
      ],
      "properties": {
        "snapshot_date": {
          "$ref": "#/$defs/field"
        },
        "official_url": {
          "$ref": "#/$defs/field"
        },
        "third_party_url": {
          "$ref": "#/$defs/field"
        },
        "results": {
          "$ref": "#/$defs/field"
        },
        "coverage_note": {
          "$ref": "#/$defs/field"
        }
      },
      "additionalProperties": false
    },
    "contact": {
      "type": "object",
      "required": [
        "public_emails",
        "github_issues",
        "official_social",
        "privacy_policy"
      ],
      "properties": {
        "public_emails": {
          "$ref": "#/$defs/field"
        },
        "github_issues": {
          "$ref": "#/$defs/field"
        },
        "official_social": {
          "$ref": "#/$defs/field"
        },
        "privacy_policy": {
          "$ref": "#/$defs/field"
        }
      },
      "additionalProperties": false
    },
    "original_files": {
      "type": "object",
      "required": [
        "paper_pdf_url",
        "sha256",
        "pdf_bytes",
        "drive_folder",
        "other_documents"
      ],
      "properties": {
        "paper_pdf_url": {
          "$ref": "#/$defs/field"
        },
        "sha256": {
          "$ref": "#/$defs/field"
        },
        "pdf_bytes": {
          "$ref": "#/$defs/field"
        },
        "drive_folder": {
          "$ref": "#/$defs/field"
        },
        "other_documents": {
          "$ref": "#/$defs/field"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "required": [
        "value",
        "sources"
      ],
      "properties": {
        "value": {},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "url",
              "accessed"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "accessed": {
                "type": "string",
                "format": "date"
              }
            },
            "additionalProperties": false
          }
        },
        "status": {
          "enum": [
            "待核实",
            "未公开"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
